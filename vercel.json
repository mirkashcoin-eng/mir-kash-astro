{
  "regions": ["bom1"],
  "crons": [
    { "path": "/api/cron/reconcile-orders", "schedule": "0 3 * * *" },
    { "path": "/api/cron/whatsapp", "schedule": "0 4 * * *" }
  ],
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://mir-kash-web.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://mir-kash-web.firebaseapp.com/__/firebase/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'" }
      ]
    }
  ]
}
