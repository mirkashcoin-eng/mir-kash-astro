---
import { SITE_ORIGIN, absoluteUrl, listMarkets } from '~/lib/markets';

interface Props {
  title: string;
  description?: string;
  path: string;
  fontsHref?: string;
}

const { title, description = 'Mir Kash — luxury vegan handbags. Made slowly. Worn forever. Hurts nothing.', path, fontsHref } = Astro.props;
const { market, marketConfig } = Astro.locals;

Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=60, stale-while-revalidate=300',
);

const canonical = absoluteUrl(marketConfig.urlPrefix + (path === '/' ? '' : path) || '/');

// Jost is self-hosted via /fonts/jost.css (imported in styles.css) — no Google Fonts request.
const fontsUrl = fontsHref ?? '';
// Cache-bust the static stylesheet per deploy so design changes reach browsers immediately.
const buildId = (typeof process !== 'undefined' ? process.env.VERCEL_GIT_COMMIT_SHA : undefined)?.slice(0, 8) || 'dev';

// GA4 (mirkash.com) for page views, top pages, time on page and traffic sources.
// Sits alongside the Google Ads tag on the same already-loaded gtag.js — a measurement
// id is public by design (it ships to every browser), so it lives in code like the Ads
// one rather than in env, where a missing value would silently disable analytics.
// PUBLIC_GA4_ID still overrides it, e.g. to point a staging deploy at another property.
const ga4Id = (typeof process !== 'undefined' ? process.env.PUBLIC_GA4_ID : undefined)
  || (import.meta.env.PUBLIC_GA4_ID as string | undefined) || 'G-FZN0YD1X1R';

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Mir Kash',
  url: SITE_ORIGIN,
  logo: SITE_ORIGIN + '/mir-kash-logo.webp',
  slogan: 'Made slowly. Worn forever. Hurts nothing.',
};
---
<!DOCTYPE html>
<html lang={marketConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {listMarkets().map((m) => (
      <link
        rel="alternate"
        hreflang={m.hreflang}
        href={absoluteUrl(m.urlPrefix + (path === '/' ? '' : path) || '/')}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(path === '/' ? '/' : path)} />

    <meta property="og:locale" content={marketConfig.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />

    <!-- Google tag (gtag.js) — one load, two products: Ads conversions + GA4 analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18098313640"></script>
    <script is:inline define:vars={{ ga4Id, market, currency: marketConfig.currency }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18098313640');
      // One GA4 property for every market (they share a domain now), separated by a
      // `market` user property. Register it as a custom dimension in GA4 Admin →
      // Custom definitions to report India vs global side by side.
      if (ga4Id) {
        gtag('set', 'user_properties', { market: market });
        gtag('config', ga4Id, { market: market, currency: currency });
      }
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "xt4v3tq3mp");
    </script>

    {fontsUrl && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href={fontsUrl} rel="stylesheet" />
      </>
    )}

    <link rel="stylesheet" href={`/styles.css?v=${buildId}`} />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

    <script define:vars={{ market }}>
      window.__MARKET__ = market;
    </script>

    <!-- First-party funnel (anonymous counts) + per-session lead capture. No cookies. -->
    <script is:inline define:vars={{ mkMarket: market }}>
      // Anonymous funnel beacon — GET image (POST text/plain is blocked by Astro CSRF).
      // Optional `opts.product` also bumps that product's view/cart counters.
      window.mkTrack = function (e, opts) {
        try {
          var q = '/api/track?e=' + encodeURIComponent(e) + '&t=' + Date.now();
          if (opts && opts.product) q += '&product=' + encodeURIComponent(opts.product);
          (new Image()).src = q;
        } catch (_) {}
      };
      // Trim a Shopify cart payload to what /admin needs: what's in the bag + its value.
      window.cartSnapshot = function (cart) {
        try {
          if (!cart) return undefined;
          return {
            total: cart.total, currency: cart.currency, quantity: cart.totalQuantity,
            lines: (cart.lines || []).map(function (l) {
              return { title: l.title, variant: l.variantTitle, quantity: l.quantity, price: l.price };
            }),
          };
        } catch (_) { return undefined; }
      };
      // Stable anonymous session id, so a visitor's cart adds + phone tie to one lead.
      try {
        var sid = localStorage.getItem('mk_sid');
        if (!sid) {
          sid = (window.crypto && crypto.randomUUID) ? crypto.randomUUID()
            : 'mk-' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10);
          localStorage.setItem('mk_sid', sid);
        }
        window.mkSid = sid;
      } catch (_) {}
      // Lead capture — JSON POST (bypasses CSRF). Merges into the session's lead doc.
      window.mkLead = function (data) {
        try {
          if (!window.mkSid) return;
          fetch('/api/lead', {
            method: 'POST', keepalive: true, headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(Object.assign({ sessionId: window.mkSid, market: mkMarket }, data)),
          });
        } catch (_) {}
      };
      // Once per tab-session: bump the anonymous funnel, and open this visitor's row
      // in /admin so people who browse without ever leaving a number are still visible.
      try {
        if (!sessionStorage.getItem('mk_v')) {
          sessionStorage.setItem('mk_v', '1');
          window.mkTrack('visit');
          if (window.mkLead) window.mkLead({ event: 'visit' });
        }
      } catch (_) { window.mkTrack('visit'); }
    </script>
  </head>
  <body data-market={market}>
    <slot />
  </body>
</html>
