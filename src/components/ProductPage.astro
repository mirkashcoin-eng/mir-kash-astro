---
import LeafIcon from './LeafIcon.astro';
import SiteFooter from './SiteFooter.astro';
import CountrySelector from './CountrySelector.astro';
import ViewingPrompt from './ViewingPrompt.astro';
import { shopifyImage } from '~/lib/shopifyImage';
import { hexFor } from '~/lib/colour-swatch';
import { getAllProducts, getProductRecommendations } from '~/lib/shopify/queries';
import { formatMoney } from '~/lib/markets';
import type { Product, ProductDetail } from '~/types/shopify';
import { carryWays, deliveryLines, dimensionsFor, faqFor, trustLine } from '~/lib/product-page';
import { returnDaysFor, shippingFor } from '~/lib/merchant-policy';

interface Props {
  product: ProductDetail;
}

const { product } = Astro.props;
const { market, marketConfig } = Astro.locals;
const prefix = marketConfig.urlPrefix;
const homeHref = prefix || '/';
const shopHref = `${prefix}/shop`;
const cartHref = `${prefix}/cart`;

// ── Images ──────────────────────────────────────────────────────────────────
const imgNodes = (product.images?.edges ?? []).map((e) => e.node);
if (imgNodes.length === 0 && product.featuredImage) imgNodes.push(product.featuredImage);
const images = imgNodes.map((n) => ({
  full: shopifyImage(n.url, 1100),
  thumb: shopifyImage(n.url, 160),
  alt: n.altText ?? product.title,
  colour: '', // filled in below, once the colour option values are known
}));

// Editorial sections (story slideshow · full-bleed · lookbook) reuse the product's
// own gallery photos, cycling when there are fewer images than slots.
const galleryFulls = images.map((i) => i.full);
const pickImg = (i: number) => (galleryFulls.length ? galleryFulls[i % galleryFulls.length] : '');

// Story copy is per product, from the custom.story_slides JSON metafield. No metafield
// (or malformed JSON) → no slides → the whole section stays hidden.
type StorySlide = { eyebrow?: string; title: string; body: string; image?: string };
const metafieldSlides: StorySlide[] = (() => {
  try {
    const parsed = JSON.parse(product.storySlides?.value ?? '[]');
    return Array.isArray(parsed) ? parsed.filter((s) => s && s.title && s.body) : [];
  } catch {
    return [];
  }
})();
// `astro dev` only: placeholder slides so the section's layout can be previewed
// before any product has the metafield. Never used in a production build, nor in the
// catalog tool's preview, which must show exactly what the live page will.
const DEV_PREVIEW = import.meta.env.DEV && !Astro.locals.catalogPreview;
// Images are https addresses from Shopify; the catalog tool's preview serves local files from its own paths.
const isImageUrl = (v: string) => /^https:\/\//.test(v) || (Astro.locals.catalogPreview === true && v.startsWith('/catalog-tool/'));
const storySlides: StorySlide[] = metafieldSlides.length || !DEV_PREVIEW ? metafieldSlides : [
  { eyebrow: 'Sample', title: 'Placeholder slide one', body: 'Preview copy shown only in local development. Real slides come from the custom.story_slides metafield.' },
  { eyebrow: 'Sample', title: 'Placeholder slide two', body: 'Each slide pairs with the next photo from this product\'s gallery.' },
  { eyebrow: 'Sample', title: 'Placeholder slide three', body: 'The counter and progress bars follow however many slides there are.' },
];
// Each slide can carry its own close-up (custom.story_slides[].image); otherwise it borrows a gallery photo.
const storyImgArr = storySlides.map((s, i) => (isImageUrl(s.image ?? '') ? shopifyImage(s.image!, 1100) : pickImg(i)));
const fullBleedImg = pickImg(1); // dev-preview fallback only; production needs custom.fullbleed_image

// Small JSON-in-a-metafield reader shared by the sections below. Bad or missing JSON → empty list → section hidden.
const readList = <T,>(raw: string | undefined): T[] => {
  try {
    const parsed = JSON.parse(raw ?? '[]');
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
};
const mf = (m?: { value: string } | null) => (m?.value ?? '').trim();
const toLines = (t: string) => t.split(/\r?\n/).map((l) => l.replace(/^[\s•\-–—*]+/, '').trim()).filter(Boolean);

// Shoppable reels are per product: custom.reels = videos uploaded to the product in Shopify admin. None → no section.
// The five brand clips below are a `astro dev`-only sample so the layout can be previewed; they are never shown in
// production. (They used to be hard-wired for every product, on mirkash.in/cdn/… URLs that now 404 — the files
// live on cdn.shopify.com.)
type Reel = { src: string; poster?: string };
const sampleReel = (id: string, file: string, v: string): Reel => ({
  src: `https://cdn.shopify.com/videos/c/vp/${id}/${file}`,
  poster: `https://cdn.shopify.com/s/files/1/0730/9774/0503/files/preview_images/${id}.thumbnail.0000000000_600x.jpg?v=${v}`,
});
const DEV_SAMPLE_REELS: Reel[] = [
  sampleReel('9aec54c28a0b4e6ebc496c4fd9cfcb25', '9aec54c28a0b4e6ebc496c4fd9cfcb25.HD-1080p-2.5Mbps-41014614.mp4', '1736928328'),
  sampleReel('2dc16b90b6c84393a5f695adae892c15', '2dc16b90b6c84393a5f695adae892c15.SD-480p-0.9Mbps-44607305.mp4', '1742590421'),
  sampleReel('e23697e03d794e6ca9713f375825a876', 'e23697e03d794e6ca9713f375825a876.HD-1080p-7.2Mbps-44606795.mp4', '1742589749'),
  sampleReel('34f18c8ed63946558f022c56a611ac85', '34f18c8ed63946558f022c56a611ac85.HD-1080p-7.2Mbps-44606796.mp4', '1742589749'),
  sampleReel('d6665fbc4f0c4e22a961f411bcd15963', 'd6665fbc4f0c4e22a961f411bcd15963.HD-1080p-7.2Mbps-44850754.mp4', '1742980518'),
];
// custom.reels holds videos uploaded in Shopify admin. Pick the mp4 closest to 720p (sharp enough, light on mobile).
const metafieldReels: Reel[] = (product.reels?.references?.nodes ?? [])
  .map((v) => {
    const mp4 = (v.sources ?? []).filter((s) => s.mimeType === 'video/mp4')
      .sort((a, b) => Math.abs((a.height ?? 0) - 720) - Math.abs((b.height ?? 0) - 720))[0];
    return mp4 ? { src: mp4.url, poster: v.previewImage?.url ? shopifyImage(v.previewImage.url, 600) : undefined } : null;
  })
  .filter((r): r is Reel => !!r);
const reels: Reel[] = metafieldReels.length ? metafieldReels : DEV_PREVIEW ? DEV_SAMPLE_REELS : [];

// Feature cards (Material / Packaging / Ethics…) from custom.feature_cards.
type FeatureCard = { eyebrow?: string; title: string; body: string };
const metafieldCards = readList<FeatureCard>(product.featureCards?.value).filter((c) => c && c.title && c.body);
const featureCards: FeatureCard[] = metafieldCards.length || !DEV_PREVIEW ? metafieldCards : [
  { eyebrow: 'Sample', title: 'Placeholder card', body: 'Preview copy shown only in local development. Real cards come from the custom.feature_cards metafield.' },
];

// Full-bleed editorial image: custom.fullbleed_image (21:9, desktop) + custom.fullbleed_image_mobile (4:5, phones; optional —
// without it phones crop the desktop image). https URLs. Falls back to the gallery only in `astro dev`.
const httpsOr = (v: string) => (isImageUrl(v) ? v : '');
const fullbleedUrl = httpsOr(mf(product.fullbleedImage));
const fullbleedMobileUrl = httpsOr(mf(product.fullbleedImageMobile));

// ── Options & variants ───────────────────────────────────────────────────────
const isRealOption = (name: string, values: string[]) =>
  !(values.length === 1 && /default title/i.test(values[0]));

// Render a selector for EVERY real option (Colour, Size, Style, Material…), not just
// colour/size — so all products' variants are selectable. Colour-type options draw as
// swatches; everything else as pill buttons.
const optionGroups = product.options
  .filter((o) => isRealOption(o.name, o.values))
  .map((o) => ({ name: o.name, values: o.values, isColor: /colou?r/i.test(o.name) }));

const variants = product.variants.edges.map((e) => e.node);
const variantData = variants.map((v) => ({
  id: v.id,
  available: v.availableForSale,
  price: formatMoney(v.price, marketConfig.locale),
  amount: Number(v.price.amount) || 0,
  options: Object.fromEntries(v.selectedOptions.map((o) => [o.name, o.value])),
  image: v.image ? shopifyImage(v.image.url, 1100) : null,
}));
// Open on the variant a link points at (?variant=<numeric id> from Google Shopping, or ?color=Nude), else the first.
const qp = Astro.url.searchParams;
const wantId = qp.get('variant');
const wantColour = (qp.get('color') || qp.get('colour') || '').toLowerCase();
const startVariant =
  (wantId && variants.find((v) => v.id.endsWith('/' + wantId))) ||
  (wantColour && variants.find((v) => v.selectedOptions.some((o) => /colou?r/i.test(o.name) && o.value.toLowerCase() === wantColour))) ||
  variants[0];
const startSel: Record<string, string> = Object.fromEntries((startVariant?.selectedOptions ?? []).map((o) => [o.name, o.value]));
const startOf = (opt: { name: string; values: string[] }) => startSel[opt.name] ?? opt.values[0];
const firstVariantId = startVariant?.id ?? '';
const startPrice = startVariant ? formatMoney(startVariant.price, marketConfig.locale) : formatMoney(product.priceRange.minVariantPrice, marketConfig.locale);

// One product now holds every colour's photos. Photos are tagged by colour through their alt text
// ("Braidey Shoulder Bag in Nude, view 3" → Nude), which the catalog import writes. Show only the selected
// colour's shots; anything untagged is shared. Filtering only switches on when at least two colours have photos
// of their own — otherwise (old-style listings, hand-edited alt text) every photo stays visible.
const colourOpt = optionGroups.find((o) => o.isColor);
const startColour = colourOpt ? startOf(colourOpt) : '';
function colourOfAlt(alt: string): string {
  const a = alt.toLowerCase();
  let best = '';
  for (const v of colourOpt?.values ?? []) {
    const k = ` in ${v.toLowerCase()}`;
    if ((a.endsWith(k) || a.includes(k + ',')) && v.length > best.length) best = v;
  }
  return best;
}
images.forEach((i) => { i.colour = colourOfAlt(i.alt); });
const colourGallery = new Set(images.map((i) => i.colour).filter(Boolean)).size >= 2;
const hiddenAt = (i: number) => colourGallery && !!images[i].colour && images[i].colour !== startColour;
const firstVisible = Math.max(0, images.findIndex((_, i) => !hiddenAt(i)));
const visibleCount = images.filter((_, i) => !hiddenAt(i)).length;

// Colours are modelled as SEPARATE products (e.g. "Carla - Plum", "Carla - Taupe"),
// each with its own photos. So a colour swatch should navigate to that colour's product
// rather than swap a variant image that doesn't exist. Build that map when siblings exist.
const [allProducts, recommended] = await Promise.all([
  getAllProducts(market, marketConfig.countryCode, 100).catch(() => []),
  getProductRecommendations(market, marketConfig.countryCode, product.id).catch(() => []),
]);
const firstWord = (t: string) => (t || '').toLowerCase().split(/[\s\-–—|]+/).filter(Boolean)[0] || '';
const myFamily = firstWord(product.title);
const myTitleLc = product.title.toLowerCase();
function siblingHandle(colour: string): string | null {
  const cv = colour.toLowerCase();
  if (myTitleLc.includes(cv)) return product.handle; // this page already is that colour
  const sib = allProducts.find(
    (p) => p.handle !== product.handle && firstWord(p.title) === myFamily && p.title.toLowerCase().includes(cv),
  );
  return sib ? sib.handle : null;
}
type ColourEntry = { value: string; href: string | null; active: boolean };
const colourNav: Record<string, ColourEntry[]> = {};
// New one-product-per-bag listings (they carry custom.size_group) switch colour in place — never jump to the old
// colour-per-listing products, which stay live until they're set to Draft.
const isConsolidated = Boolean((product.sizeGroup?.value ?? '').trim());
for (const opt of optionGroups) {
  if (!opt.isColor || isConsolidated) continue;
  const entries: ColourEntry[] = opt.values.map((v) => {
    const h = siblingHandle(v);
    return { value: v, href: h ? `${prefix}/products/${h}` : null, active: h === product.handle };
  });
  if (entries.some((e) => e.href && !e.active)) colourNav[opt.name] = entries; // only when siblings exist
}

// ── Related products ("More From Mir Kash") ─────────────────────────────────
// Shopify's own RELATED recommendations first; newer or low-traffic products
// often come back with too few, so backfill from the catalog already fetched
// above — same productType first, then anything else. Colour siblings are
// excluded throughout: they're already one tap away in the swatch row.
const REL_TARGET = 8;
const relPool: Product[] = [];
const relSeen = new Set<string>([product.handle]);
// One bag per family. Colourways are separate Shopify products ("Kelly Clutch -
// Silver" / "- Gold"), and Shopify's recommendations happily return several of
// the same bag — which just burns slots on near-duplicates. Seeded with this
// product's own family, so its colour siblings are excluded too (they're already
// one tap away in the swatch row). First one wins = Shopify's own ranking order.
const relFamilies = new Set<string>([myFamily]);
function addRelated(list: Product[]) {
  for (const p of list) {
    if (relPool.length >= REL_TARGET) return;
    const family = firstWord(p.title);
    if (relSeen.has(p.handle) || relFamilies.has(family)) continue;
    relSeen.add(p.handle);
    relFamilies.add(family);
    relPool.push(p);
  }
}
addRelated(recommended);
addRelated(allProducts.filter((p) => p.productType && p.productType === product.productType));
addRelated(allProducts);

const relatedProducts = relPool.map((p) => ({
  handle: p.handle,
  href: `${prefix}/products/${p.handle}`,
  name: p.title,
  price: formatMoney(p.priceRange.minVariantPrice, marketConfig.locale),
  variantId: p.variants?.edges?.[0]?.node.id ?? '',
  image: p.featuredImage ? shopifyImage(p.featuredImage.url, 600) : null,
  imageAlt: p.featuredImage?.altText ?? p.title,
  hoverImage: (() => {
    const node =
      p.images?.edges?.find((e) => e.node.url !== p.featuredImage?.url)?.node ??
      p.images?.edges?.[1]?.node ??
      null;
    return node ? shopifyImage(node.url, 600) : null;
  })(),
  badge: p.tags.includes('best-seller')
    ? 'Best Seller'
    : p.tags.includes('new')
    ? 'New'
    : p.tags.includes('selling-fast')
    ? 'Selling Fast'
    : null,
}));

const clientData = { variants: variantData, options: optionGroups.map((o) => ({ name: o.name, isColor: o.isColor })), colourGallery };

// Hidden in production until real content is ready. Shown under `astro dev` so the
// full page can be reviewed locally. The story section also needs per-product slides.
// Every editorial section is now data-driven: it appears on a product only when that product has the content.
const SHOW_FEATURES = featureCards.length > 0;
const SHOW_STORY = storySlides.length > 0;
const SHOW_FULLBLEED = Boolean(fullbleedUrl) || DEV_PREVIEW;
const SHOW_REELS = reels.length > 0;

// Accordions read the product's own metafields, in the order of brand-wiki/PRODUCT-PAGE-STRUCTURE.md:
// Details & Size · Material (the reveal) · Care · Shipping & Returns · Warranty. Generic fallbacks only for old listings.
const FALLBACK_DETAILS = ['Fully vegan', 'Comes with a dust bag'];
const shipTerms = shippingFor(marketConfig.countryCode);
const returnsLine = `Returns within ${returnDaysFor(marketConfig.countryCode)} days of delivery, unused, with the dust bag and box`;
const FALLBACK_SHIPPING = marketConfig.store === 'india'
  ? ['Free shipping across India', returnsLine]
  : [
      shipTerms.cost === 0 ? 'Free delivery' : 'Tracked express from Hong Kong, charged by region at checkout',
      'Duties and import taxes are included in the price',
      returnsLine,
    ];
const detailLines = toLines(mf(product.productDetails));
const dimensionLine = dimensionsFor(mf(product.dimensions), marketConfig);
const careLines = toLines(mf(product.careGuide));
const detailsList = [
  ...(detailLines.length ? detailLines : FALLBACK_DETAILS),
  ...(dimensionLine && !detailLines.some((l) => /\bcm\b/i.test(l)) ? [`Dimensions: ${dimensionLine}`] : []),
];
const shippingList = toLines(mf(product.shippingReturn));
// If the text already ends by pointing to the Returns page (India's wording), that sentence becomes the link;
// otherwise the page adds "Visit our Returns page for more information."
const shipLines = shippingList.length ? shippingList : FALLBACK_SHIPPING;
const returnsRef = shipLines.at(-1)?.match(/^(.*?\.\s+)?([^.]*?)Returns page([^.]*\.?)$/);
if (returnsRef) shipLines.splice(-1, 1, ...(returnsRef[1] ? [returnsRef[1].trim()] : []));
const hasWarranty = !product.tags.includes('no-warranty');
type Accordion = { title: string; vegan?: boolean; lines?: string[]; text?: string; sub?: { title: string; lines: string[] }; link?: { href: string; before: string; label: string; after: string } };
const accordions: Accordion[] = [
  // Details, size and care in one dropdown (decided 29 Sep): details → dimensions → a "Care" sub-list.
  // Products without care tips (e.g. charms) are titled just "Product Details".
  { title: careLines.length ? 'Product Details & Care' : 'Product Details', lines: detailsList, ...(careLines.length ? { sub: { title: 'Care', lines: careLines } } : {}) },
  // The material dropdown carries a small Forest Green leaf: the one quiet "vegan" mark on the page.
  ...(mf(product.materialName) && mf(product.materialStory) ? [{ title: mf(product.materialName), vegan: true, text: mf(product.materialStory) }] : []),
  { title: 'Shipping & Returns', lines: shipLines,
    link: { href: `${prefix}/pages/shipping-returns`, label: 'Returns page',
            ...(returnsRef ? { before: returnsRef[2], after: returnsRef[3] } : { before: 'Visit our ', after: ' for more information.' }) } },
  // Products tagged "no-warranty" (e.g. charms) carry no warranty: no dropdown, and no warranty in the trust line.
  ...(hasWarranty ? [{ title: '1-Year Warranty', text: mf(product.warranty) || 'Every Mir Kash bag is covered against manufacturing defects for one year from purchase.',
    link: { href: `${prefix}/pages/shipping-returns`, before: 'Read the full ', label: 'warranty terms', after: '.' } }] : []),
];

// Buying-area extras: ways to carry, per-country trust + delivery lines, breadcrumb category.
const ways = carryWays(product, detailLines);
const trust = trustLine(marketConfig, { warranty: hasWarranty });
const delivery = deliveryLines(marketConfig);
const maxDays = shipTerms.handlingDays[1] + shipTerms.transitDays[1];
const faq = faqFor(product, marketConfig);
---

<header class="hdr">
  <div class="hdr__wrap">
    <nav class="hdr__nav" aria-label="Primary">
      <a href={shopHref}>Shop All</a>
      <a href={`${prefix}/pages/materials`}>Materials</a>
      <a href={`${prefix}/blog`}>Journal</a>
      <a href={`${prefix}/pages/about`}>About</a>
      {marketConfig.isDefault && <a href={`${prefix}/try-at-home`} data-geo="demo" hidden>Try at Home</a>}
    </nav>
    <a href={homeHref} class="hdr__logo"><img src="/mir-kash-logo.webp" alt="Mir Kash" /></a>
    <div class="hdr__right">
      <CountrySelector variant="header" />
      <a class="hdr__btn hdr__bag" href={cartHref} aria-label="Bag">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <span class="bag-count">0</span>
      </a>
    </div>
  </div>
</header>

<main>
  <!-- ══ DESKTOP PDP ══ -->
  <section class="pdp">
    <!-- LEFT: thumbnails -->
    <aside class="pdp__thumbs" id="thumbStrip">
      {images.map((img, i) => (
        <button class={`thumb${i === firstVisible ? ' is-active' : ''}${hiddenAt(i) ? ' is-off' : ''}`} data-gidx={i} data-colour={img.colour} aria-label={`View image ${i + 1}`}>
          <img src={img.thumb} alt={img.alt} loading="lazy" />
        </button>
      ))}
    </aside>

    <!-- CENTER: image stack -->
    <div class="pdp__images" id="mainGallery">
      {images.map((img, i) => (
        <div class={`gimg${hiddenAt(i) ? ' is-off' : ''}`} data-gidx={i} data-colour={img.colour}>
          <img src={img.full} alt={img.alt} loading={i === firstVisible ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>

    <!-- RIGHT: sticky info -->
    <div class="pdp__info">
      <h1 class="info-name">{product.title}</h1>
      <p class="info-price" id="infoPrice">{startPrice}</p>
      {ways.length > 0 && <ul class="ways" aria-label="Ways to carry">{ways.map((w) => <li>{w}</li>)}</ul>}
      <div class="info-desc" set:html={product.descriptionHtml || product.description}></div>

      {optionGroups.map((opt) => (
        colourNav[opt.name] ? (
          <div class="sw-group">
            <p class="sw-label">{opt.name} — <em>{(colourNav[opt.name].find((e) => e.active) || { value: opt.values[0] }).value}</em></p>
            <div class="sw-row">
              {colourNav[opt.name].map((e) => (
                e.href && !e.active
                  ? <a class="swatch swatch--link" style={`--c:${hexFor(e.value)}`} href={e.href} aria-label={e.value} title={e.value}></a>
                  : <span class={`swatch${e.active ? ' is-active' : ''}`} style={`--c:${hexFor(e.value)}`} aria-label={e.value} title={e.value}></span>
              ))}
            </div>
          </div>
        ) : opt.isColor ? (
          <div class="sw-group">
            <p class="sw-label">{opt.name} — <em class="opt-val" data-optval={opt.name}>{startOf(opt)}</em></p>
            <div class="sw-row">
              {opt.values.map((v, i) => (
                <button class={`swatch${v === startOf(opt) ? ' is-active' : ''}`} style={`--c:${hexFor(v)}`} data-opt={opt.name} data-name={v} aria-label={v}></button>
              ))}
            </div>
          </div>
        ) : (
          <div class="size-group">
            <p class="size-label">{opt.name}:</p>
            <div class="size-row">
              {opt.values.map((v, i) => (
                <button class={`size-btn${v === startOf(opt) ? ' is-active' : ''}`} data-opt={opt.name} data-name={v}>{v}</button>
              ))}
            </div>
          </div>
        )
      ))}

      <div class="cta-row">
        <button class="btn-atc btn-buy" id="buyNowBtn">Buy Now</button>
        <div class="btn-atc-wrap">
          <button class="btn-atc btn-add" id="atcBtn">Add to Cart</button>
        </div>
      </div>

      <div class="trust-block">
        <p class="trust">{trust.map((x) => <span class="trust__item">{x}</span>)}</p>
        <p class="trust-sub"><span class="js-arrives" data-maxdays={maxDays} data-locale={marketConfig.locale}>{delivery.arrives}</span> · {delivery.returns}</p>
      </div>

      <div>
      {accordions.map((a) => (
        <div class="acc-item">
          <button class="acc-btn"><span class="acc-title">{a.vegan && <LeafIcon />}{a.title}</span> <span class="acc-icon">+</span></button>
          <div class="acc-body"><div class="acc-inner">
            {a.lines ? <ul>{a.lines.map((l) => <li>{l}</li>)}</ul> : <p>{a.text}</p>}
            {a.sub && <><p class="acc-sub">{a.sub.title}</p><ul>{a.sub.lines.map((l) => <li>{l}</li>)}</ul></>}
            {a.link && <p class="acc-link">{a.link.before}<a href={a.link.href}>{a.link.label}</a>{a.link.after}</p>}
          </div></div>
        </div>
      ))}
      </div>
    </div>
  </section>

  <!-- ══ MOBILE GALLERY ══ -->
  <div class="mob-gal" id="mobGal">
    <div class="mob-gal__track" id="mobTrack">
      {images.map((img, i) => (
        <div class={`mob-gal__slide${hiddenAt(i) ? ' is-off' : ''}`} data-colour={img.colour}><img src={img.full} alt={img.alt} /></div>
      ))}
    </div>
    <span class="mob-ctr" id="mobCtr">1 / {visibleCount}</span>
  </div>

  <!-- ══ MOBILE INFO ══ -->
  <div class="mob-info">
    <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:6px">
      <h1 class="info-name" style="margin:0;font-size:clamp(1.5rem,5vw,1.85rem)">{product.title}</h1>
      <p id="mobPrice" style="font-size:15px;font-weight:500;flex-shrink:0;margin-left:12px">{startPrice}</p>
    </div>
    {ways.length > 0 && <ul class="ways" aria-label="Ways to carry">{ways.map((w) => <li>{w}</li>)}</ul>}
    <div class="info-desc" style="border:none;padding:0;margin-bottom:20px" set:html={product.descriptionHtml || product.description}></div>

    {optionGroups.map((opt) => (
      colourNav[opt.name] ? (
        <div class="sw-group">
          <p class="sw-label">{opt.name} — <em>{(colourNav[opt.name].find((e) => e.active) || { value: opt.values[0] }).value}</em></p>
          <div class="sw-row">
            {colourNav[opt.name].map((e) => (
              e.href && !e.active
                ? <a class="swatch swatch--link" style={`--c:${hexFor(e.value)}`} href={e.href} aria-label={e.value} title={e.value}></a>
                : <span class={`swatch${e.active ? ' is-active' : ''}`} style={`--c:${hexFor(e.value)}`} aria-label={e.value} title={e.value}></span>
            ))}
          </div>
        </div>
      ) : opt.isColor ? (
        <div class="sw-group">
          <p class="sw-label">{opt.name} — <em class="opt-val" data-optval={opt.name}>{startOf(opt)}</em></p>
          <div class="sw-row">
            {opt.values.map((v, i) => (
              <button class={`swatch${v === startOf(opt) ? ' is-active' : ''}`} style={`--c:${hexFor(v)}`} data-opt={opt.name} data-name={v} aria-label={v}></button>
            ))}
          </div>
        </div>
      ) : (
        <div class="size-group">
          <p class="size-label" style="margin-top:4px">{opt.name}:</p>
          <div class="size-row">
            {opt.values.map((v, i) => (
              <button class={`size-btn${v === startOf(opt) ? ' is-active' : ''}`} data-opt={opt.name} data-name={v}>{v}</button>
            ))}
          </div>
        </div>
      )
    ))}

    <div class="trust-block">
      <p class="trust">{trust.map((x) => <span class="trust__item">{x}</span>)}</p>
      <p class="trust-sub"><span class="js-arrives" data-maxdays={maxDays} data-locale={marketConfig.locale}>{delivery.arrives}</span> · {delivery.returns}</p>
    </div>

    <div class="mob-acc">
      {accordions.map((a) => (
        <div class="acc-item">
          <button class="acc-btn"><span class="acc-title">{a.vegan && <LeafIcon />}{a.title}</span> <span class="acc-icon">+</span></button>
          <div class="acc-body"><div class="acc-inner">
            {a.lines ? <ul>{a.lines.map((l) => <li>{l}</li>)}</ul> : <p>{a.text}</p>}
            {a.sub && <><p class="acc-sub">{a.sub.title}</p><ul>{a.sub.lines.map((l) => <li>{l}</li>)}</ul></>}
            {a.link && <p class="acc-link">{a.link.before}<a href={a.link.href}>{a.link.label}</a>{a.link.after}</p>}
          </div></div>
        </div>
      ))}
    </div>
  </div>
  <div data-vp-sentinel aria-hidden="true"></div>

  <!-- ══ FEATURES ══ — from custom.feature_cards; hidden when a product has none -->
  {SHOW_FEATURES && (
    <section class="features reveal" aria-label="At a glance">
      <div class="feat-grid">
        {featureCards.map((c) => (
          <div class="feat">
            {c.eyebrow && <p class="feat__eye">{c.eyebrow}</p>}
            <h3 class="feat__title">{c.title}</h3>
            <p class="feat__body">{c.body}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ══ FEATURE STORY SLIDESHOW ══ — hidden via SHOW_STORY until content is ready -->
  {SHOW_STORY && (
  <section class="story">
    <div class="story__left">
      <div class="story__slides">

        {storySlides.map((s, i) => (
          <div class={`s-slide${i === 0 ? ' is-active' : ''}`}>
            {s.eyebrow && <p class="s-slide__eye">{s.eyebrow}</p>}
            <h3 class="s-slide__title">{s.title}</h3>
            <p class="s-slide__body">{s.body}</p>
          </div>
        ))}

      </div>

      <div class="story__foot">
        <div class="prog-bars" id="progBars">
          {storySlides.map((_, i) => <div class={`prog-bar${i === 0 ? ' active' : ''}`}></div>)}
        </div>
        <div class="story-nav">
          <button class="story-nav__btn" id="storyPrev" aria-label="Previous">‹</button>
          <span class="story-nav__ctr" id="storyCtr">1 / {storySlides.length}</span>
          <button class="story-nav__btn" id="storyNext" aria-label="Next">›</button>
          <button class="story-nav__pause" id="storyPause" aria-label="Pause">⏸</button>
        </div>
      </div>
    </div>

    <div class="story__right">
      <img class="story__img" id="storyImg" src={storyImgArr[0]} alt={`${product.title}: ${storySlides[0]?.title ?? ''}`} />
    </div>
  </section>
  )}

  <!-- ══ FULL-BLEED ══ — custom.fullbleed_image (21:9) + custom.fullbleed_image_mobile (4:5); hidden when a product has none -->
  {SHOW_FULLBLEED && (
  <div class="full-bleed reveal">
    <picture>
      {fullbleedMobileUrl && <source media="(max-width: 900px)" srcset={fullbleedMobileUrl} />}
      <img src={fullbleedUrl || fullBleedImg} alt={product.title} loading="lazy" />
    </picture>
  </div>
  )}

  <!-- ══ REELS ══ — this product's own custom.reels; hidden when a product has none -->
  {SHOW_REELS && (
  <section class="reels reveal">
    <div class="reels__head">
      <p class="reels__eye">Reels</p>
      <h2 class="reels__title">Mir Kash in motion</h2>
    </div>
    <div class="reels__track" id="reelsTrack">
      {reels.map((r) => (
        <div class="reel">
          <video class="reel__video" src={r.src} poster={r.poster} muted loop playsinline preload="metadata"></video>
          <button class="reel__sound" type="button" aria-label="Toggle sound">
            <svg class="i-mute" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M11 5 6 9H2v6h4l5 4V5z"/><line x1="22" y1="9" x2="16" y2="15"/><line x1="16" y1="9" x2="22" y2="15"/></svg>
            <svg class="i-sound" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M19 5a9 9 0 0 1 0 14"/></svg>
          </button>
        </div>
      ))}
    </div>
  </section>
  )}

  <!-- ══ FAQ ══ — the bag's own custom.faq (also published as FAQPage schema) -->
  {faq.length > 0 && (
  <section class="faq reveal">
    <h2 class="faq__title">Questions</h2>
    <div class="faq__list">
      {faq.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
  )}

  <!-- ══ MORE FROM MIR KASH ══ -->
  {relatedProducts.length > 0 && (
  <section class="related reveal">
    <h2 class="related__title">More From Mir Kash</h2>
    <div class="rel-track">
      {relatedProducts.map((r) => (
        <a class="rel-card" href={r.href} data-name={r.name} data-handle={r.handle} data-variant={r.variantId}>
          <div class="rel-card__img-wrap">
            {r.image
              ? <img class="rel-card__img rel-card__img--primary" src={r.image} alt={r.imageAlt} loading="lazy" />
              : <div class="rel-card__img rel-card__img--ph"></div>}
            {r.hoverImage && <img class="rel-card__img rel-card__img--alt" src={r.hoverImage} alt="" loading="lazy" />}
            {r.badge && <span class={`rel-card__badge${r.badge === 'New' ? ' rel-card__badge--new' : ''}`}>{r.badge}</span>}
            <button class="rel-card__add" type="button" aria-label={`Add ${r.name} to bag`}>Add to bag</button>
          </div>
          <div class="rel-card__meta">
            <p class="rel-card__name">{r.name}</p>
            <p class="rel-card__price">{r.price}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
  )}
  <div data-vp-end aria-hidden="true"></div>
</main>

<!-- ══ STICKY MOBILE BAR ══ -->
<div class="mob-bar">
  <button class="mob-bar__atc mob-bar__add" id="mobAtcBtn">Add to Cart</button>
  <button class="mob-bar__atc mob-bar__buy" id="mobBuyBtn">Buy Now</button>
</div>
<ViewingPrompt page="product" handle={product.handle} title={product.title} image={images[firstVisible]?.full} />

<SiteFooter hideWarranty={!hasWarranty} />

<script type="application/json" id="pdpData" set:html={JSON.stringify(clientData)}></script>
<script define:vars={{ pvTitle: product.title }}>
  if (window.mkTrack) window.mkTrack('product_view', { product: pvTitle });
  // Also against this person, so /admin can count how many distinct products they saw.
  if (window.mkLead) window.mkLead({ event: 'product_view', item: pvTitle });
</script>
<script define:vars={{ firstVariantId, store: market, countryCode: marketConfig.countryCode, currency: marketConfig.currency, cartHref, storyImgs: storyImgArr, productTitle: product.title }}>
  const data = JSON.parse(document.getElementById('pdpData').textContent || '{}');
  const variants = data.variants || [];
  const optionNames = (data.options || []).map((o) => o.name);

  const state = { variantId: firstVariantId };
  const selected = {};

  function esc(name) { return name.replace(/"/g, '\\"'); }

  // Switch the gallery to a variant's own photo when it has one.
  function showVariantImage(src) {
    if (!src) return;
    const imgs = document.querySelectorAll('#mainGallery .gimg img');
    for (let i = 0; i < imgs.length; i++) {
      if (imgs[i].getAttribute('src') === src) {
        const g = imgs[i].closest('.gimg');
        if (g) {
          g.scrollIntoView({ behavior: 'smooth', block: 'center' });
          const idx = g.dataset.gidx;
          document.querySelectorAll('#thumbStrip .thumb').forEach((t) => t.classList.toggle('is-active', t.dataset.gidx === idx));
        }
        const mobSlide = document.querySelectorAll('#mobTrack .mob-gal__slide')[i];
        if (mobSlide) mobSlide.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        return;
      }
    }
  }

  // Colour-tagged photos: show only the selected colour's shots (plus any untagged, shared ones).
  const colourName = (data.options || []).find((o) => o.isColor)?.name;
  function applyColourGallery() {
    if (!data.colourGallery || !colourName || !selected[colourName]) return;
    const c = selected[colourName];
    document.querySelectorAll('#mainGallery .gimg, #thumbStrip .thumb, #mobTrack .mob-gal__slide').forEach((el) => {
      const ec = el.dataset.colour || '';
      el.classList.toggle('is-off', !!ec && ec !== c);
    });
    const firstThumb = document.querySelector('#thumbStrip .thumb:not(.is-off)');
    document.querySelectorAll('#thumbStrip .thumb').forEach((t) => t.classList.toggle('is-active', t === firstThumb));
    const track = document.getElementById('mobTrack');
    const ctr = document.getElementById('mobCtr');
    if (track) {
      track.scrollLeft = 0;
      if (ctr) ctr.textContent = '1 / ' + track.querySelectorAll('.mob-gal__slide:not(.is-off)').length;
    }
  }

  function resolveVariant(initial) {
    const match = variants.find((v) => optionNames.every((n) => !selected[n] || v.options[n] === selected[n])) || variants[0];
    if (!match) return;
    state.variantId = match.id;
    state.amount = match.amount;
    document.querySelectorAll('#infoPrice, #mobPrice').forEach((el) => { el.textContent = match.price; });
    document.querySelectorAll('#atcBtn, #mobAtcBtn').forEach((btn) => {
      btn.disabled = !match.available;
      btn.textContent = match.available ? 'Add to Cart' : 'Sold Out';
      btn.dataset.label = btn.textContent;
    });
    document.querySelectorAll('#buyNowBtn, #mobBuyBtn').forEach((btn) => {
      btn.disabled = !match.available;
      btn.textContent = match.available ? 'Buy Now' : 'Sold Out';
      btn.dataset.label = btn.textContent;
    });
    applyColourGallery();
    // On first paint the server already opened the right photos; only scroll after a deliberate change.
    if (!initial) showVariantImage(match.image);
  }

  // One handler for every option button (colour swatch or pill), desktop + mobile.
  function selectOption(name, value) {
    selected[name] = value;
    document.querySelectorAll('[data-opt="' + esc(name) + '"][data-name]').forEach((b) => {
      b.classList.toggle('is-active', b.dataset.name === value);
    });
    document.querySelectorAll('.opt-val[data-optval="' + esc(name) + '"]').forEach((el) => { el.textContent = value; });
    resolveVariant();
  }
  document.querySelectorAll('[data-opt][data-name]').forEach((btn) => {
    btn.addEventListener('click', () => selectOption(btn.dataset.opt, btn.dataset.name));
  });

  // Initialise from the first active button of each option.
  document.querySelectorAll('[data-opt][data-name].is-active').forEach((b) => { selected[b.dataset.opt] = b.dataset.name; });
  resolveVariant(true);

  // Add to bag — checkout:true => Buy Now (go to Shopify checkout); false => stay on page
  async function addItem(btn) {
    if (!state.variantId || btn.disabled) return;
    const original = btn.dataset.label || btn.textContent;
    btn.dataset.label = original;
    btn.disabled = true;
    btn.textContent = 'Adding…';
    try {
      const res = await fetch('/api/cart/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ merchandiseId: state.variantId, quantity: 1, store, countryCode }),
      });
      if (!res.ok) throw new Error('add failed');
      const cart = await res.json();
      if (window.mkTrack) window.mkTrack('add_to_cart', { product: productTitle });
      if (window.mkLead) window.mkLead({ event: 'add_to_cart', item: productTitle, cart: window.cartSnapshot && window.cartSnapshot(cart) });
      try {
        if (typeof gtag === 'function') {
          const items = [{ item_id: state.variantId, item_name: productTitle, price: state.amount, quantity: 1 }];
          gtag('event', 'add_to_cart', { currency, value: state.amount, items });
          gtag('event', 'conversion', { send_to: 'AW-18098313640/HX8JCKX26J0cEKiz-bVD', value: state.amount, currency });
        }
      } catch (e) { console.error('gtag add_to_cart failed:', e); }
      document.querySelectorAll('.bag-count').forEach((el) => { el.textContent = String(cart.totalQuantity ?? 0); });
      btn.textContent = 'Added ✓';
      btn.classList.add('is-added');
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('is-added');
        btn.disabled = false;
      }, 1600);
    } catch {
      btn.disabled = false; btn.textContent = original;
      alert('Sorry — something went wrong. Please try again.');
    }
  }

  // Buy Now — Amazon-style: checks out ONLY this product via a separate single-item
  // cart, leaving the main cart untouched. India → our /checkout; Global → Shopify.
  async function buyNow(btn) {
    if (!state.variantId || btn.disabled) return;
    const original = btn.dataset.label || btn.textContent;
    btn.dataset.label = original;
    btn.disabled = true;
    btn.textContent = 'Processing…';
    try {
      const res = await fetch('/api/checkout/buynow', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ merchandiseId: state.variantId, quantity: 1, store, countryCode }),
      });
      if (!res.ok) throw new Error('buynow failed');
      const { next } = await res.json();
      if (!next) throw new Error('no next url');
      window.location.href = next;
    } catch {
      btn.disabled = false; btn.textContent = original;
      alert('Sorry — something went wrong. Please try again.');
    }
  }

  document.getElementById('atcBtn')?.addEventListener('click', (e) => addItem(e.currentTarget));
  document.getElementById('mobAtcBtn')?.addEventListener('click', (e) => addItem(e.currentTarget));
  document.getElementById('buyNowBtn')?.addEventListener('click', (e) => buyNow(e.currentTarget));
  document.getElementById('mobBuyBtn')?.addEventListener('click', (e) => buyNow(e.currentTarget));

  // Thumbnails → scroll to gallery image
  document.querySelectorAll('#thumbStrip .thumb').forEach((t) => {
    t.addEventListener('click', () => {
      document.querySelectorAll('#thumbStrip .thumb').forEach((x) => x.classList.remove('is-active'));
      t.classList.add('is-active');
      const target = document.querySelector(`.gimg[data-gidx="${t.dataset.gidx}"]`);
      target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });

  // Mobile gallery counter
  const mobTrack = document.getElementById('mobTrack');
  const mobCtr = document.getElementById('mobCtr');
  if (mobTrack && mobCtr) {
    mobTrack.addEventListener('scroll', () => {
      const total = mobTrack.querySelectorAll('.mob-gal__slide:not(.is-off)').length;
      const idx = Math.round(mobTrack.scrollLeft / mobTrack.clientWidth) + 1;
      mobCtr.textContent = `${idx} / ${total}`;
    }, { passive: true });
  }

  // "Order today, arrives by …": recomputed in the browser so a cached page never shows a stale date.
  document.querySelectorAll('.js-arrives').forEach((el) => {
    const d = new Date();
    let left = Number(el.dataset.maxdays) || 0;
    while (left > 0) { d.setDate(d.getDate() + 1); const w = d.getDay(); if (w !== 0 && w !== 6) left--; }
    try { el.textContent = 'Order today, arrives by ' + new Intl.DateTimeFormat(el.dataset.locale || undefined, { weekday: 'short', day: 'numeric', month: 'short' }).format(d); } catch {}
  });

  // Accordions
  document.querySelectorAll('.acc-item .acc-btn').forEach((btn) => {
    btn.addEventListener('click', () => btn.closest('.acc-item').classList.toggle('is-open'));
  });

  // ── Feature story slideshow (auto-advancing, with prev/next/pause) ──
  (function () {
    const sSlides = document.querySelectorAll('.s-slide');
    if (!sSlides.length) return;
    const progBarEls = document.querySelectorAll('.prog-bar');
    const storyImg = document.getElementById('storyImg');
    const storyCtr = document.getElementById('storyCtr');
    let sIdx = 0, sTimer = null, sPaused = false;

    function goStory(n) {
      sIdx = (n + sSlides.length) % sSlides.length;
      sSlides.forEach((s) => s.classList.remove('is-active'));
      sSlides[sIdx].classList.add('is-active');
      progBarEls.forEach((b, i) => {
        b.classList.remove('active', 'done');
        if (i < sIdx) b.classList.add('done');
        if (i === sIdx) b.classList.add('active');
      });
      if (storyImg && storyImgs[sIdx]) {
        storyImg.style.opacity = '0';
        setTimeout(() => { storyImg.src = storyImgs[sIdx]; storyImg.style.opacity = '1'; }, 240);
      }
      if (storyCtr) storyCtr.textContent = (sIdx + 1) + ' / ' + sSlides.length;
    }
    function startTimer() {
      clearInterval(sTimer);
      if (!sPaused) sTimer = setInterval(() => goStory(sIdx + 1), 4200);
    }
    document.getElementById('storyNext')?.addEventListener('click', () => { goStory(sIdx + 1); startTimer(); });
    document.getElementById('storyPrev')?.addEventListener('click', () => { goStory(sIdx - 1); startTimer(); });
    document.getElementById('storyPause')?.addEventListener('click', function () {
      sPaused = !sPaused;
      this.textContent = sPaused ? '▶' : '⏸';
      startTimer();
    });
    startTimer();
  })();

  // ── Reels: play when on-screen, pause off-screen; tap a reel's speaker for sound ──
  (function () {
    const vids = document.querySelectorAll('.reel__video');
    if (!vids.length) return;
    const tryPlay = (v) => { const p = v.play(); if (p && p.catch) p.catch(() => {}); };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) tryPlay(e.target); else e.target.pause(); });
      }, { threshold: 0.5 });
      vids.forEach((v) => io.observe(v));
    } else {
      vids.forEach(tryPlay);
    }
    document.querySelectorAll('.reel__sound').forEach((btn) => {
      btn.addEventListener('click', () => {
        const v = btn.closest('.reel')?.querySelector('.reel__video');
        if (!v) return;
        if (v.muted) {
          // only one reel plays sound at a time
          vids.forEach((o) => { o.muted = true; });
          document.querySelectorAll('.reel__sound').forEach((b) => b.classList.remove('is-on'));
          v.muted = false;
          btn.classList.add('is-on');
          tryPlay(v);
        } else {
          v.muted = true;
          btn.classList.remove('is-on');
        }
      });
    });
  })();

  // ── Scroll reveal (features · full-bleed · lookbook) ──
  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); revealObs.unobserve(e.target); }
    });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal').forEach((el) => revealObs.observe(el));

  // ── "More From Mir Kash" — click tracking + quick add ──
  (function () {
    document.querySelectorAll('.rel-card').forEach((card) => {
      const name = card.dataset.name || '';

      card.addEventListener('click', () => {
        if (window.mkTrack) window.mkTrack('related_product_click', { product: name });
        if (window.mkLead) window.mkLead({ event: 'related_product_click', item: name, from: productTitle });
      });

      const add = card.querySelector('.rel-card__add');
      if (!add) return;
      add.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (add.dataset.busy === '1') return;
        const variantId = card.dataset.variant;
        // No resolvable variant → let them pick one on that product's own page.
        if (!variantId) { window.location.href = card.href; return; }
        const original = add.dataset.label || add.textContent;
        add.dataset.label = original;
        add.dataset.busy = '1';
        add.textContent = 'Adding…';
        try {
          const res = await fetch('/api/cart/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ merchandiseId: variantId, quantity: 1, store, countryCode }),
          });
          if (!res.ok) throw new Error('add failed');
          const cart = await res.json();
          if (window.mkTrack) window.mkTrack('add_to_cart', { product: name });
          if (window.mkLead) window.mkLead({ event: 'add_to_cart', item: name, cart: window.cartSnapshot && window.cartSnapshot(cart) });
          try {
            if (typeof gtag === 'function') {
              const items = [{ item_id: variantId, item_name: name, quantity: 1 }];
              gtag('event', 'add_to_cart', { currency, items });
              gtag('event', 'conversion', { send_to: 'AW-18098313640/HX8JCKX26J0cEKiz-bVD', currency });
            }
          } catch (e) { console.error('gtag add_to_cart failed:', e); }
          document.querySelectorAll('.bag-count').forEach((el) => { el.textContent = String(cart.totalQuantity ?? 0); });
          add.classList.add('is-added');
          add.textContent = 'Added ✓';
          setTimeout(() => {
            add.textContent = original;
            add.classList.remove('is-added');
            add.dataset.busy = '';
          }, 1500);
        } catch {
          add.textContent = original;
          add.dataset.busy = '';
          window.location.href = card.href;
        }
      });
    });
  })();

  // Keep the header bag badge in sync with the live cart (also on bfcache back-nav)
  (function () {
    const els = document.querySelectorAll('.bag-count');
    if (!els.length) return;
    async function refresh() {
      try {
        const res = await fetch('/api/cart?store=' + store, { cache: 'no-store' });
        if (!res.ok) return;
        const cart = await res.json();
        els.forEach((el) => { el.textContent = String(cart.totalQuantity ?? 0); });
      } catch {}
    }
    refresh();
    window.addEventListener('pageshow', refresh);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
  })();

</script>

<style is:global>
  :root {
    --serif: 'DM Serif Display', Georgia, 'Times New Roman', serif;
    --cherry: #8B1A1A; --earth: #C8895A; --depth: #2C1A0E;
    --paper: #ffffff; --rule: #e4dfd7; --mid: #6e6a64;
    --hdr-h: 56px;
    --offset: var(--hdr-h);
  }
  body { background: #fff; color: var(--depth); }

  .hdr { position: sticky; top: 0; z-index: 100; background: #fff; border-bottom: 1px solid var(--rule); }
  .hdr__wrap { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: var(--hdr-h); padding: 0 var(--gutter, clamp(20px,4vw,56px)); }
  .hdr__logo { justify-self: center; grid-column: 2; }
