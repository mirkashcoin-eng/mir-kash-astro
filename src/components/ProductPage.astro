  .hdr__bag .bag-count { font-size: 12px; }
  .hdr__nav { grid-column: 1; justify-self: start; display: flex; align-items: center; gap: 22px; }
  .hdr__nav a { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 500; color: var(--depth); transition: opacity .2s; }
  .hdr__nav a:hover { opacity: .55; }

  .bc { font-size: 12px; letter-spacing: .02em; font-weight: 400; color: var(--mid); }
  .bc a:hover { color: var(--cherry); }
  .bc .sep { margin: 0 8px; opacity: .45; }

  .pdp { display: grid; grid-template-columns: 70px 1fr 550px; align-items: start; }
  .pdp__thumbs { position: sticky; top: var(--offset); height: calc(100dvh - var(--offset)); overflow-y: auto; scrollbar-width: none; display: flex; flex-direction: column; gap: 4px; padding: 16px 8px; border-right: 1px solid var(--rule); }
  .pdp__thumbs::-webkit-scrollbar { display: none; }
  .is-off { display: none !important; } /* photos of a colour that isn't selected */
  .thumb { flex-shrink: 0; width: 54px; aspect-ratio: 3/4; overflow: hidden; border: 1.5px solid transparent; background: var(--paper); transition: border-color .2s; padding: 0; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb.is-active { border-color: var(--depth); }
  .pdp__images { background: #fff; display: flex; flex-direction: column; gap: 6px; width: 100%; max-width: 640px; margin: 0 auto; }
  .gimg { width: 100%; aspect-ratio: 4/5; overflow: hidden; background: #fff; }
  .gimg img { width: 100%; height: 100%; object-fit: cover; }
  .pdp__info { position: sticky; top: var(--offset); height: calc(100dvh - var(--offset)); overflow-y: auto; scrollbar-width: none; border-left: 1px solid var(--rule); padding: 44px 48px 48px; }
  .pdp__info::-webkit-scrollbar { display: none; }
  .info-name { font-family: var(--serif); font-weight: 400; font-size: clamp(1.5rem, 1.8vw, 1.85rem); line-height: 1.15; margin: 16px 0 8px; }
  .info-price { font-size: clamp(1.3rem, 1.6vw, 1.65rem); font-weight: 400; letter-spacing: .01em; margin-bottom: 28px; }
  .info-desc { font-size: 13.5px; line-height: 1.85; color: #555; padding-bottom: 28px; border-bottom: 1px solid var(--rule); margin-bottom: 28px; }
  .info-desc p { margin-bottom: 10px; }

  .sw-label { font-size: 12px; font-weight: 500; letter-spacing: .04em; margin-bottom: 10px; }
  .sw-label em { font-style: normal; font-weight: 400; color: var(--mid); }
  .sw-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .swatch { display: inline-block; width: 32px; height: 32px; border-radius: 50%; background: var(--c, #ccc); padding: 0; border: none; box-shadow: inset 0 0 0 1px rgba(44,26,14,.12); transition: box-shadow .2s; cursor: pointer; text-decoration: none; }
  .swatch.is-active { box-shadow: 0 0 0 1.5px #fff, 0 0 0 3px var(--depth), inset 0 0 0 1px rgba(44,26,14,.12); }
  .swatch:hover:not(.is-active) { box-shadow: 0 0 0 1.5px rgba(44,26,14,.35), inset 0 0 0 1px rgba(44,26,14,.12); }
  .sw-group { margin-bottom: 28px; }

  .size-label { font-size: 12px; font-weight: 500; letter-spacing: .04em; margin-bottom: 12px; }
  .size-row { display: flex; gap: 8px; margin-bottom: 32px; flex-wrap: wrap; }
  .size-btn { padding: 8px 18px; border: 1px solid var(--depth); font-size: 12px; font-weight: 500; border-radius: 100px; transition: background .2s, color .2s; }
  .size-btn.is-active, .size-btn:hover:not(.is-active) { background: var(--depth); color: #fff; }

  .cta-row { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
  .btn-atc-wrap { display: flex; gap: 8px; }
  .btn-atc { flex: 1; padding: 16px; border: 1px solid var(--depth); font-size: 14px; font-weight: 500; letter-spacing: .02em; transition: background .25s, color .2s; }
  .btn-atc:disabled { opacity: .5; cursor: not-allowed; }
  /* Buy Now — filled primary */
  .btn-buy { width: 100%; background: var(--depth); color: #fff; }
  .btn-buy:hover:not(:disabled) { background: var(--cherry); border-color: var(--cherry); }
  /* Add to Cart — outlined secondary */
  .btn-add { background: #fff; color: var(--depth); }
  .btn-add:hover:not(:disabled) { background: var(--depth); color: #fff; }
  .btn-atc.is-added { background: #3D6B4F; border-color: #3D6B4F; color: #fff; }
  .trust-block { padding: 16px 0 14px; border-bottom: 1px solid var(--rule); margin-bottom: 4px; text-align: center; }
  .trust { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; column-gap: 1.6em; row-gap: 2px; font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--depth); font-weight: 500; line-height: 1.8; }
  .trust__item { white-space: nowrap; }
  .trust-sub { margin-top: 6px; font-size: 12px; color: var(--mid); }
  .ways { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: -14px 0 22px; }
  .ways li { font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; border: 1px solid var(--rule); border-radius: 99px; padding: 5px 11px; color: var(--depth); }
  .bc a { color: inherit; } .bc a:hover { color: var(--cherry); }

  /* ══ FAQ ══ */
  .faq { padding: clamp(3rem, 6vw, 5rem) var(--gutter, clamp(20px,4vw,56px)); border-top: 1px solid var(--rule); background: #fff; }
  .faq__title { font-family: var(--serif); font-weight: 400; font-size: clamp(1.6rem, 3vw, 2.2rem); color: var(--depth); text-align: center; margin-bottom: clamp(1.4rem, 3vw, 2.2rem); }
  .faq__list { max-width: 760px; margin: 0 auto; }
  .faq__item { border-bottom: 1px solid var(--rule); }
  .faq__item summary { list-style: none; cursor: pointer; padding: 18px 28px 18px 2px; position: relative; font-size: 15px; color: var(--depth); }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; position: absolute; right: 4px; top: 50%; transform: translateY(-50%); color: var(--mid); font-size: 18px; }
  .faq__item[open] summary::after { content: '–'; }
  .faq__item summary:hover { color: var(--cherry); }
  .faq__item p { padding: 0 2px 20px; font-size: 14px; line-height: 1.8; color: var(--mid); max-width: 680px; }

  .acc-item { border-bottom: 1px solid var(--rule); }
  .acc-btn { width: 100%; padding: 18px 2px; display: flex; align-items: center; justify-content: space-between; gap: 16px; background: none; border: none; cursor: pointer; font-family: inherit; font-size: 13px; font-weight: 500; letter-spacing: .01em; color: var(--depth); text-align: left; transition: color .2s; }
  .acc-btn:hover { color: var(--cherry); }
  .acc-title { display: inline-flex; align-items: center; gap: 7px; }
  /* Thin chevron that rotates from down (closed) to up (open) */
  .acc-icon { position: relative; width: 14px; height: 14px; flex-shrink: 0; font-size: 0; color: var(--mid); transition: color .2s; }
  .acc-icon::before { content: ''; position: absolute; left: 50%; top: 40%; width: 7px; height: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translate(-50%, -50%) rotate(45deg); transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .acc-item.is-open .acc-icon::before { transform: translate(-50%, -20%) rotate(225deg); }
  .acc-btn:hover .acc-icon { color: var(--cherry); }
  .acc-item.is-open .acc-icon { color: var(--depth); }
  .acc-body { max-height: 0; overflow: hidden; transition: max-height .4s ease; }
  .acc-item.is-open .acc-body { max-height: 500px; }
  .acc-inner { padding: 0 2px 18px; font-size: 13px; line-height: 1.85; color: var(--mid); }
  .acc-sub { margin: 16px 0 6px; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--depth); font-weight: 500; }
  .acc-link { margin-top: 10px; }
  .acc-link a { color: var(--depth); text-decoration: underline; text-underline-offset: 3px; }
  .acc-link a:hover { color: var(--cherry); }
  .acc-inner ul { list-style: disc; padding-left: 1.1em; display: flex; flex-direction: column; gap: 5px; }

  .mob-gal { display: none; position: relative; background: #fff; }
  .mob-gal__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .mob-gal__track::-webkit-scrollbar { display: none; }
  .mob-gal__slide { flex: 0 0 100%; scroll-snap-align: start; aspect-ratio: 4/5; overflow: hidden; background: var(--paper); }
  .mob-gal__slide img { width: 100%; height: 100%; object-fit: cover; }
  .mob-ctr { position: absolute; bottom: 12px; right: 14px; font-size: 11px; font-weight: 500; letter-spacing: .06em; background: rgba(255,255,255,.75); padding: 2px 9px; border-radius: 100px; color: #333; }
  .mob-info { display: none; padding: 22px 20px 0; }
  .mob-acc { margin: 22px 0 6px; }

  .features { background: #F5EEE3; border-top: 1px solid var(--rule); padding: clamp(1.75rem, 3.5vw, 2.75rem) var(--gutter, clamp(20px,4vw,56px)); }
  .feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 4vw, 4rem); max-width: 1200px; margin: 0 auto; }
  .feat { padding: 0; }
  .feat__eye { font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: var(--earth); font-weight: 600; margin-bottom: 8px; }
  .feat__title { font-family: var(--serif); font-weight: 400; font-size: clamp(1.15rem, 1.6vw, 1.4rem); line-height: 1.25; margin-bottom: 8px; }
  .feat__body { font-size: 13.5px; line-height: 1.8; color: #555; }

  /* ══ FEATURE STORY SLIDESHOW ══ */
  /* The image box is always 3:2 (slide images are 2400 × 1600), so the photo is never cropped differently per screen. */
  .story { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--rule); }
  .story__left { background: #fff; padding: clamp(3rem, 6vw, 5rem) clamp(2.5rem, 5vw, 5rem); display: flex; flex-direction: column; justify-content: space-between; }
  .story__slides { flex: 1; display: flex; align-items: center; }
  .s-slide { display: none; animation: fadeIn .45s ease; }
  .s-slide.is-active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .s-slide__eye { font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: var(--earth); font-weight: 600; margin-bottom: 18px; }
  .s-slide__title { font-family: var(--serif); font-weight: 300; font-style: normal; font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.25; color: var(--depth); margin-bottom: 14px; }
  .s-slide__body { font-size: 14px; line-height: 1.8; color: #555; max-width: 36ch; }
  .story__foot { padding-top: 28px; }
  .prog-bars { display: flex; gap: 10px; margin-bottom: 16px; }
  .prog-bar { height: 2px; flex: 1; background: #d5d0cb; position: relative; overflow: hidden; }
  .prog-bar::after { content: ''; position: absolute; left: 0; top: 0; bottom: 0; background: var(--depth); width: 0; }
  .prog-bar.done::after { width: 100%; transition: none; }
  .prog-bar.active::after { width: 100%; transition: width 4s linear; }
  .story-nav { display: flex; align-items: center; gap: 14px; }
  .story-nav__btn { font-size: 18px; color: var(--depth); padding: 4px; transition: color .2s; line-height: 1; }
  .story-nav__btn:hover { color: var(--cherry); }
  .story-nav__ctr { font-size: 12px; letter-spacing: .06em; color: var(--mid); font-weight: 500; }
  .story-nav__pause { width: 26px; height: 26px; background: var(--depth); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 9px; transition: background .2s; }
  .story-nav__pause:hover { background: var(--cherry); }
  .story__right { overflow: hidden; aspect-ratio: 3/2; align-self: center; }
  .story__img { width: 100%; height: 100%; object-fit: cover; transition: opacity .45s ease; }

  /* ══ FULL-BLEED ══ */
  .full-bleed { width: 100%; aspect-ratio: 21/9; overflow: hidden; background: var(--depth); }   /* desktop file: 2520 × 1080 */
  .full-bleed picture { display: contents; }
  .full-bleed img { width: 100%; height: 100%; object-fit: cover; }

  /* ══ REELS ══ */
  .reels { padding: clamp(3rem, 6vw, 5rem) 0 clamp(3.5rem, 6vw, 5rem); background: #fff; border-top: 1px solid var(--rule); }
  .reels__head { text-align: center; margin-bottom: clamp(1.8rem, 3.5vw, 2.6rem); padding: 0 var(--gutter, clamp(20px,4vw,56px)); }
  .reels__eye { font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: var(--earth); font-weight: 600; margin-bottom: 12px; }
  .reels__title { font-family: var(--serif); font-weight: 300; font-style: normal; font-size: clamp(1.6rem, 3vw, 2.4rem); line-height: 1.2; color: var(--depth); }
  .reels__track { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; max-width: 1440px; margin: 0 auto; padding: 4px var(--gutter, clamp(20px,4vw,56px)); }
  .reels__track::-webkit-scrollbar { display: none; }
  .reel { position: relative; flex: 0 0 auto; width: clamp(210px, 22vw, 280px); aspect-ratio: 9/16; border-radius: 16px; overflow: hidden; background: var(--paper); scroll-snap-align: start; box-shadow: 0 14px 30px -20px rgba(44,26,14,.45); }
  .reel__video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .reel__sound { position: absolute; bottom: 12px; right: 12px; width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; background: rgba(20,12,8,.42); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); transition: background .2s; }
  .reel__sound:hover { background: rgba(20,12,8,.7); }
  .reel__sound .i-sound { display: none; }
  .reel__sound.is-on .i-mute { display: none; }
  .reel__sound.is-on .i-sound { display: block; }

  /* ══ MORE FROM MIR KASH ══ */
  .related { padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(3rem, 5vw, 4rem); background: #fff; border-top: 1px solid var(--rule); }
  /* Deliberately quiet: this is a signpost for a utility row, not an editorial
     heading — it must not compete with the product <h1>. Sentence case (the card
     names below are uppercase, so this keeps the two registers distinct), and the
     same gutter as .rel-track so label and first card share a vertical edge. */
  .related__title {
    font-family: var(--font); font-weight: 400; font-size: 17px; line-height: 1.3;
    letter-spacing: .01em; color: var(--depth);
    max-width: 1440px; margin: 0 auto 18px;
    padding: 0 var(--gutter, clamp(20px,4vw,56px));
  }
  /* scroll-padding-left keeps mandatory snap from snapping past the gutter and
     clipping the first card — same fix the shop grid's scroll rows already use. */
  .rel-track { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; max-width: 1440px; margin: 0 auto; padding: 4px var(--gutter, clamp(20px,4vw,56px)); scroll-padding-left: var(--gutter, clamp(20px,4vw,56px)); }
  .rel-track::-webkit-scrollbar { display: none; }
  .rel-card { flex: 0 0 auto; width: clamp(210px, 20vw, 260px); scroll-snap-align: start; background: var(--paper); color: var(--depth); }
  .rel-card__img-wrap { position: relative; aspect-ratio: 4/5; overflow: hidden; background: linear-gradient(170deg,#f0ede8 0%,#e0ddd8 100%); }
  .rel-card__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity .45s ease; }
  .rel-card__img--alt { opacity: 0; }
  .rel-card:hover .rel-card__img--primary { opacity: 0; }
  .rel-card:hover .rel-card__img--alt { opacity: 1; }
  .rel-card__badge { position: absolute; top: 10px; left: 10px; display: flex; align-items: center; gap: 5px; background: rgba(255,255,255,.92); padding: 4px 9px; font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; color: var(--depth); }
  .rel-card__badge::before { content: ''; width: 4px; height: 4px; border-radius: 50%; background: var(--earth); }
  .rel-card__badge--new { color: var(--cherry); }
  .rel-card__badge--new::before { background: var(--cherry); }
  .rel-card__add {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 12px;
    background: var(--depth); color: #fff; border: none; cursor: pointer;
    font-family: inherit; font-size: 11px; letter-spacing: .13em; text-transform: uppercase; font-weight: 500;
    opacity: 0; transform: translateY(100%); transition: opacity .28s ease, transform .28s ease, background .2s;
  }
  .rel-card:hover .rel-card__add { opacity: 1; transform: none; }
  .rel-card__add:hover { background: var(--cherry); }
  .rel-card__add.is-added { background: #3D6B4F; }
  .rel-card__meta { padding: 12px 2px 0; }
  .rel-card__name { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; font-weight: 500; line-height: 1.4; margin-bottom: 4px; }
  .rel-card__price { font-size: 13px; color: var(--mid); }

  /* ══ SCROLL REVEAL ══ */
  .reveal { opacity: 0; transform: translateY(22px); transition: opacity .65s ease, transform .65s ease; }
  .reveal.in { opacity: 1; transform: none; }

  .drawer { position: fixed; inset: 0; z-index: 300; pointer-events: none; visibility: hidden; }
  .drawer.is-open { pointer-events: auto; visibility: visible; }
  .drawer__scrim { position: absolute; inset: 0; background: rgba(20,12,8,0); transition: background .35s; }
  .drawer.is-open .drawer__scrim { background: rgba(20,12,8,.32); }
  .drawer__panel { position: absolute; top: 0; left: 0; bottom: 0; width: min(400px, 90vw); background: var(--paper); transform: translateX(-100%); transition: transform .42s cubic-bezier(.2,.7,.2,1); display: flex; flex-direction: column; padding: clamp(24px,4vw,48px) clamp(24px,4vw,48px) 32px; }
  .drawer.is-open .drawer__panel { transform: translateX(0); box-shadow: 0 0 60px rgba(0,0,0,.1); z-index: 1; }
  .drawer__close { align-self: flex-end; display: flex; align-items: center; gap: 8px; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 500; color: var(--depth); margin-bottom: 40px; }
  .drawer__close:hover { color: var(--cherry); }
  .drawer__list { list-style: none; display: flex; flex-direction: column; }
  .drawer__list li a { display: flex; align-items: baseline; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--rule); color: var(--depth); transition: color .25s, padding-left .2s; }
  .drawer__list li a:hover { color: var(--cherry); padding-left: 6px; }
  .d-num { font-family: var(--font); font-size: 13px; color: var(--mid); width: 26px; flex-shrink: 0; }
  .d-word { font-family: var(--serif); font-weight: 300; font-size: clamp(20px, 2vw, 26px); }
  .drawer__foot { margin-top: auto; padding-top: 24px; border-top: 1px solid var(--rule); display: flex; flex-direction: column; gap: 10px; }
  .drawer__foot a { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 500; color: var(--depth); }
  .drawer__foot a:hover { color: var(--cherry); }

  .mob-bar { display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 90; background: #fff; border-top: 1px solid var(--rule); padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); gap: 8px; }
  .mob-bar__atc { flex: 1; padding: 14px; border: 1px solid var(--depth); font-size: 12px; letter-spacing: .13em; text-transform: uppercase; font-weight: 500; transition: background .2s, color .2s; }
  .mob-bar__buy { background: var(--depth); color: #fff; }
  .mob-bar__buy:hover:not(:disabled) { background: var(--cherry); border-color: var(--cherry); }
  .mob-bar__add { background: #fff; color: var(--depth); }
  .mob-bar__add:hover:not(:disabled) { background: var(--depth); color: #fff; }
  .mob-bar__atc.is-added { background: #3D6B4F; border-color: #3D6B4F; color: #fff; }
  .mob-bar__atc:disabled { opacity: .5; }

  @media (max-width: 900px) {
    .pdp { display: none; }
    .hdr__nav { display: none; }
    .mob-gal { display: block; }
