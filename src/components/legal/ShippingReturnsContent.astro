---
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';

const PILLARS = [
  {
    n: '01', title: 'Delivered, worldwide',
    body: 'Free shipping across India and Hong Kong; calculated at checkout everywhere else. Most orders arrive within two weeks, with a tracking link the moment it&rsquo;s dispatched.',
  },
  {
    n: '02', title: 'Fourteen days to decide',
    body: 'Live with it first. Return your bag within 14 days of delivery for a full refund &mdash; unused, in its original packaging. No long explanations needed.',
  },
  {
    n: '03', title: 'A full year, covered',
    body: 'Every Mir Kash bag carries a one-year warranty against manufacturing defects. If something isn&rsquo;t right, we&rsquo;ll repair or replace it.',
  },
];

const DETAILS = [
  {
    q: 'Shipping — the details',
    a: `<p>We ship worldwide. Shipping is <strong>free across Hong Kong and India</strong>; for all other destinations it&rsquo;s calculated at checkout based on your location.</p>
        <p>Most orders arrive within <strong>2 weeks</strong>. During busy periods, allow a little extra time. If your order is time-sensitive, write to <a href="mailto:order@mirkash.com">order@mirkash.com</a> before placing it and we&rsquo;ll do our best to prioritise it.</p>
        <p>Once dispatched, you&rsquo;ll receive a tracking link by email. International orders may be subject to customs duties on arrival &mdash; these are set by your local customs authority and are the customer&rsquo;s responsibility.</p>`,
  },
  {
    q: 'Returns — the details',
    a: `<p>You have <strong>14 days from delivery</strong> to return your bag for a full refund. To be eligible, it must be unused and returned in its original packaging &mdash; box, dust bag, and all inserts included. Items showing signs of use can&rsquo;t be accepted.</p>
        <p>Return shipping is borne by the customer; we recommend a tracked, insured service, as we can&rsquo;t take responsibility for items lost on the way back.</p>
        <p>Start a return via our <a href="/pages/returns-portal">returns portal</a> or email <a href="mailto:order@mirkash.com">order@mirkash.com</a> with your order number. Once we receive and inspect the bag, your refund is processed within <strong>14 working days</strong> to your original payment method. We don&rsquo;t offer direct exchanges &mdash; simply return your order and place a new one.</p>`,
  },
  {
    q: 'Warranty — the details',
    a: `<p>Every Mir Kash bag is backed by a <strong>1-year warranty</strong> against manufacturing defects &mdash; stitching, hardware, structural issues. Write to <a href="mailto:order@mirkash.com">order@mirkash.com</a> and we&rsquo;ll assess it, then repair or replace it.</p>
        <p>The warranty does not cover wear from regular use, accidental damage, or misuse.</p>`,
  },
];
---
<SiteHeader />

<main class="sr">
  <!-- ── Promise hero ── -->
  <section class="sr-hero">
    <p class="sr-eyebrow">Our promise</p>
    <h1 class="sr-display sr-hero__h">Order it. Try it. Keep it only if you <em>love</em> it.</h1>
    <p class="sr-hero__sub">We&rsquo;d rather you take your time than take a chance. Free delivery to India &amp; Hong Kong, fourteen days to decide, and a full year of warranty behind every bag.</p>
  </section>

  <!-- ── Three pillars ── -->
  <section class="sr-pillars">
    {PILLARS.map((p) => (
      <div class="sr-pillar">
        <span class="sr-pillar__n">{p.n}</span>
        <h2 class="sr-display sr-pillar__h">{p.title}</h2>
        <p class="sr-pillar__body" set:html={p.body}></p>
      </div>
    ))}
  </section>

  <!-- ── The details (accordions) ── -->
  <section class="sr-fine">
    <div class="sr-fine__head">
      <p class="sr-eyebrow">Good to know</p>
      <h2 class="sr-display sr-fine__h">The fine print, kept short</h2>
    </div>
    <div class="sr-acc">
      {DETAILS.map((d, i) => (
        <details class="sr-item" open={i === 0}>
          <summary class="sr-q"><span>{d.q}</span><svg class="sr-chev" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg></summary>
          <div class="sr-a" set:html={d.a}></div>
        </details>
      ))}
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="sr-cta">
    <p class="sr-eyebrow sr-eyebrow--rose">Returns portal</p>
    <h2 class="sr-display sr-cta__h">Need to return something?</h2>
    <p class="sr-cta__p">It takes a minute &mdash; enter your order number and email, and we&rsquo;ll take it from there.</p>
    <a class="sr-cta__btn" href="/pages/returns-portal">Start a return</a>
    <p class="sr-cta__note">Any questions? <a href="mailto:order@mirkash.com">order@mirkash.com</a></p>
  </section>
</main>

<SiteFooter />

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap');
  :root { --cherry: #8B1A1A; --depth: #2C1A0E; }
  body { background: #fff; }
  .hdr-menu-btn { display: none; }
  .site-header--minimal .logo { grid-column: 2; justify-self: center; }
  .site-header--minimal .logo img { height: 22px; }
  .site-header--minimal .hdr-right { grid-column: 3; justify-self: end; gap: 14px; }

  .sr {
    --serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --cream: #F6F1E9; --ink: #40382f; --mid: #6a655d; --faint: #a79f92; --rule: #e2dac9;
    background: #fff; color: var(--depth);
  }
  .sr-display { font-family: var(--serif); font-weight: 300; letter-spacing: 0; }
  .sr em { font-style: italic; color: var(--cherry); }
  .sr-eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--cherry); font-weight: 600; margin: 0 0 18px; }
  .sr-eyebrow--rose { color: #e7b7ae; }

  /* Promise hero */
  .sr-hero { background: var(--cream); text-align: center; padding: clamp(56px,8vw,128px) 24px; }
  .sr-hero__h { font-size: clamp(34px,5vw,66px); line-height: 1.05; color: var(--depth); margin: 0 auto 22px; max-width: 18ch; text-wrap: balance; }
  .sr-hero__sub { font-size: 15.5px; line-height: 1.8; color: var(--mid); max-width: 54ch; margin: 0 auto; }

  /* Pillars */
  .sr-pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px,4vw,64px); max-width: 1140px; margin: 0 auto; padding: clamp(52px,7vw,104px) clamp(24px,5vw,56px); }
  .sr-pillar { text-align: left; }
  .sr-pillar__n { font-family: var(--serif); font-weight: 300; font-size: 40px; color: var(--cherry); line-height: 1; display: block; }
  .sr-pillar__h { font-size: clamp(24px,2.4vw,30px); line-height: 1.08; color: var(--depth); margin: 16px 0 14px; text-wrap: balance; }
  .sr-pillar__body { font-size: 14.5px; line-height: 1.85; color: var(--ink); margin: 0; }

  /* Fine print accordions */
  .sr-fine { background: var(--cream); padding: clamp(48px,6vw,92px) 24px; }
  .sr-fine__head { text-align: center; margin-bottom: clamp(28px,3.5vw,44px); }
  .sr-fine__h { font-size: clamp(26px,3vw,40px); color: var(--depth); margin: 12px 0 0; }
  .sr-acc { max-width: 760px; margin: 0 auto; border-top: 1px solid var(--rule); }
  .sr-item { border-bottom: 1px solid var(--rule); }
  .sr-item > summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px 2px; font-family: var(--serif); font-weight: 400; font-size: clamp(20px,2.2vw,26px); color: var(--depth); transition: color .2s; }
  .sr-item > summary::-webkit-details-marker { display: none; }
  .sr-item > summary:hover { color: var(--cherry); }
  .sr-chev { flex: none; color: var(--cherry); transition: transform .3s ease; }
  .sr-item[open] > summary { color: var(--cherry); }
  .sr-item[open] .sr-chev { transform: rotate(180deg); }
  .sr-a { padding: 0 2px 24px; }
  .sr-item[open] .sr-a { animation: srIn .3s ease; }
  @keyframes srIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .sr-a p { font-size: 14.5px; line-height: 1.85; color: var(--ink); margin: 0 0 14px; }
  .sr-a p:last-child { margin-bottom: 0; }
  .sr-a strong { font-weight: 600; color: var(--depth); }
  .sr-a a { color: var(--cherry); text-decoration: none; border-bottom: 1px solid rgba(139,26,26,.35); transition: border-color .2s; }
  .sr-a a:hover { border-color: var(--cherry); }

  /* CTA */
  .sr-cta { background: var(--depth); color: #fff; text-align: center; padding: clamp(52px,6.5vw,96px) 24px; }
  .sr-cta__h { font-size: clamp(28px,3.4vw,44px); color: #fff; margin: 12px 0 12px; }
  .sr-cta__p { font-size: 15px; line-height: 1.7; color: rgba(255,255,255,.72); max-width: 46ch; margin: 0 auto 28px; }
  .sr-cta__btn { display: inline-block; background: #fff; color: var(--depth); font-family: 'Jost', sans-serif; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; text-decoration: none; padding: 16px 38px; transition: background .25s, color .25s; }
  .sr-cta__btn:hover { background: var(--cherry); color: #fff; }
  .sr-cta__note { font-size: 13px; color: rgba(255,255,255,.6); margin: 24px 0 0; }
  .sr-cta__note a { color: #e7b7ae; text-decoration: none; }

  @media (max-width: 820px) {
    .sr-pillars { grid-template-columns: 1fr; gap: 40px; max-width: 480px; }
  }
  @media (prefers-reduced-motion: reduce) { .sr-item[open] .sr-a { animation: none; } .sr-chev { transition: none; } }
</style>
