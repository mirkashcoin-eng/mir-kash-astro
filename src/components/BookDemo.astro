---
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { getAllProducts } from '~/lib/shopify/queries';
import { formatMoney } from '~/lib/markets';
import { shopifyImage } from '~/lib/shopifyImage';

const { marketConfig } = Astro.locals;
const products = await getAllProducts('india', 'IN', 48);
const bags = products
  .map((p) => ({
    variantId: p.variants.edges[0]?.node.id ?? '',
    title: p.title,
    price: formatMoney(p.priceRange.minVariantPrice, marketConfig.locale),
    image: shopifyImage(p.featuredImage?.url, 500),
  }))
  .filter((b) => b.variantId);
---
<SiteHeader />

<main class="bd">
  <div id="bdMain">

    <!-- ══ SPLIT HERO ══ -->
    <section class="bd-hero">
      <div class="bd-hero__text">
        <p class="bd-hero__eyebrow">Mumbai &middot; Private Home Demo</p>
        <h1 class="bd-display bd-hero__h">Try at home. Fall in love. No pressure.</h1>
        <p class="bd-hero__sub">Book a personal visit &mdash; we bring up to six bags for you to try in your own space and your own light. Buy only if something is truly yours.</p>
        <a class="bd-cta" href="#book">Book your visit <span class="ar">&rarr;</span></a>
      </div>
      <div class="bd-hero__img">
        <img src="/ed-tophandle.jpeg" alt="Mir Kash bag" loading="eager" />
      </div>
    </section>

    <!-- ══ DETAILS STRIP ══ -->
    <div class="bd-strip">
      <div class="bd-strip__i"><p class="bd-strip__k">Where</p><p class="bd-strip__v">Anywhere in Mumbai</p></div>
      <div class="bd-strip__i"><p class="bd-strip__k">How many</p><p class="bd-strip__v">Up to 6 bags</p></div>
      <div class="bd-strip__i"><p class="bd-strip__k">How long</p><p class="bd-strip__v">30&ndash;45 minutes</p></div>
      <div class="bd-strip__i"><p class="bd-strip__k">Cost</p><p class="bd-strip__v">Complimentary</p></div>
    </div>

    <!-- ══ BOOKING ══ -->
    <div class="bd-book" id="book">
      <div class="bd-book__main">

        <!-- Date & time -->
        <section class="bd-sec">
          <div class="bd-sec__head"><span class="bd-sec__n">1</span><h2 class="bd-sec__t">Date &amp; time</h2></div>
          <p class="bd-sublabel">Choose a day</p>
          <div class="bd-rail" id="rail"></div>
          <div class="bd-slots">
            <p class="bd-sublabel" style="margin-top:26px">Time of day</p>
            <p class="bd-hint" id="slotHint">Pick a day above to choose a time.</p>
            <div class="bd-slot-btns" id="slotBtns" hidden>
              <button type="button" class="bd-slot" data-slot="Morning (11 AM–2 PM)">Morning<span>11 AM &ndash; 2 PM</span></button>
              <button type="button" class="bd-slot" data-slot="Afternoon (2–5 PM)">Afternoon<span>2 &ndash; 5 PM</span></button>
              <button type="button" class="bd-slot" data-slot="Evening (5–8 PM)">Evening<span>5 &ndash; 8 PM</span></button>
            </div>
          </div>
        </section>

        <!-- Bags -->
        <section class="bd-sec">
          <div class="bd-sec__head"><span class="bd-sec__n">2</span><h2 class="bd-sec__t">Choose your bags</h2><span class="bd-count"><span id="bagCount">0</span> / 6</span></div>
          <div class="bd-grid">
            {bags.map((b) => (
              <button type="button" class="bd-bag" data-vid={b.variantId} data-title={b.title}>
                <span class="bd-bag__img">{b.image && <img src={b.image} alt={b.title} loading="lazy" />}</span>
                <span class="bd-bag__check" aria-hidden="true">&check;</span>
                <span class="bd-bag__name">{b.title}</span>
                <span class="bd-bag__price">{b.price}</span>
              </button>
            ))}
          </div>
        </section>

        <!-- Details -->
        <section class="bd-sec">
          <div class="bd-sec__head"><span class="bd-sec__n">3</span><h2 class="bd-sec__t">Your details</h2></div>
          <div class="bd-fields">
            <label class="bd-field"><span>Full name</span><input class="bd-input" id="f-name" type="text" autocomplete="name" /></label>
            <label class="bd-field"><span>Phone</span><input class="bd-input" id="f-phone" type="tel" inputmode="numeric" maxlength="10" placeholder="10-digit mobile" /></label>
            <label class="bd-field bd-field--full"><span>Email</span><input class="bd-input" id="f-email" type="email" autocomplete="email" /></label>
            <label class="bd-field bd-field--full"><span>Address (flat / building / street)</span><input class="bd-input" id="f-addr" type="text" autocomplete="street-address" /></label>
            <label class="bd-field"><span>Area / locality</span><input class="bd-input" id="f-area" type="text" /></label>
            <label class="bd-field"><span>PIN code</span><input class="bd-input" id="f-pin" type="text" inputmode="numeric" maxlength="6" placeholder="Mumbai PIN" /></label>
          </div>
        </section>
      </div>

      <!-- Live summary -->
      <aside class="bd-side">
        <div class="bd-side__inner">
          <p class="bd-side__t">Your appointment</p>
          <div class="bd-sum">
            <div class="bd-sum__row"><span class="bd-sum__k">Date</span><span class="bd-sum__v muted" id="sum-date">Choose a day</span></div>
            <div class="bd-sum__row"><span class="bd-sum__k">Time</span><span class="bd-sum__v muted" id="sum-time">Choose a time</span></div>
            <div class="bd-sum__row"><span class="bd-sum__k">Bags</span><span class="bd-sum__v muted" id="sum-bags">Up to six pieces</span></div>
            <div class="bd-sum__row"><span class="bd-sum__k">Area</span><span class="bd-sum__v muted" id="sum-area">Add your details</span></div>
          </div>
          <button class="bd-cta bd-side__cta" type="button" id="bookBtn">Confirm home demo</button>
          <p class="bd-err" id="bookErr" hidden></p>
          <p class="bd-side__note">No pressure to buy. Confirm now, decide at home.</p>
        </div>
      </aside>
    </div>
  </div>

  <!-- ══ SUCCESS ══ -->
  <section class="bd-done" id="bdDone" hidden>
    <span class="bd-done__mark" aria-hidden="true">&check;</span>
    <h2 class="bd-display bd-done__title">Your home demo is booked</h2>
    <p class="bd-done__body" id="bdDoneBody"></p>
    <a class="bd-done__btn" href="/shop">Browse the collection</a>
  </section>
</main>

<SiteFooter />

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap');

  :root { --cherry: #8B1A1A; --depth: #2C1A0E; }
  body { background: #fff; }
  .hdr-menu-btn { display: none; }
  .site-header--minimal .logo { grid-column: 2; justify-self: center; }
  .site-header--minimal .logo img { height: 22px; }
  .site-header--minimal .hdr-right { grid-column: 3; justify-self: end; gap: 14px; }

  .bd {
    --serif-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --mid: #6e6a64; --faint: #b3aca1; --rule: #e4dfd7; --cream: #F6F1E9;
    background: #fff; color: var(--depth);
  }
  .bd-display { font-family: var(--serif-display); font-weight: 300; letter-spacing: 0; }
  .bd em { font-style: normal; color: var(--cherry); }

  .bd-cta { display: inline-flex; align-items: center; gap: 10px; background: var(--depth); color: #fff; border: none; padding: 15px 32px; font-family: inherit; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; font-weight: 500; cursor: pointer; text-decoration: none; transition: background .2s; }
  .bd-cta:hover { background: var(--cherry); }
  .bd-cta .ar { transition: transform .2s; }
  .bd-cta:hover .ar { transform: translateX(4px); }
  .bd-err { color: var(--cherry); font-size: 13px; margin: 12px 0 0; }

  /* ── Split hero ── */
  .bd-hero { display: grid; grid-template-columns: 1.05fr .95fr; min-height: clamp(420px, 60vh, 560px); }
  .bd-hero__text { display: flex; flex-direction: column; justify-content: center; padding: clamp(40px,6vw,80px) clamp(28px,5vw,64px); }
  .bd-hero__eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--cherry); margin: 0 0 16px; }
  .bd-hero__h { font-size: clamp(34px,4.6vw,58px); line-height: 1.04; color: var(--depth); margin: 0; max-width: 15ch; }
  .bd-hero__sub { font-size: 15.5px; line-height: 1.65; color: var(--mid); max-width: 44ch; margin: 20px 0 30px; }
  .bd-hero__text .bd-cta { align-self: flex-start; }
  .bd-hero__img { background: #f0e9df; overflow: hidden; }
  .bd-hero__img img { width: 100%; height: 100%; object-fit: cover; object-position: center; }

  /* ── Details strip ── */
  .bd-strip { display: grid; grid-template-columns: repeat(4,1fr); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .bd-strip__i { padding: 22px clamp(18px,3vw,28px); border-right: 1px solid var(--rule); }
  .bd-strip__i:last-child { border-right: none; }
  .bd-strip__k { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--cherry); margin: 0 0 6px; }
  .bd-strip__v { font-size: 13.5px; color: var(--mid); margin: 0; line-height: 1.5; }

  /* ── Booking two-column ── */
  .bd-book { display: grid; grid-template-columns: 1fr 330px; align-items: start; max-width: 1240px; margin: 0 auto; }
  .bd-book__main { min-width: 0; padding: clamp(40px,5vw,72px) clamp(28px,4vw,56px); }
  .bd-sec { padding-bottom: clamp(40px,5vw,56px); margin-bottom: clamp(40px,5vw,56px); border-bottom: 1px solid var(--rule); }
  .bd-sec:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  .bd-sec__head { display: flex; align-items: center; gap: 13px; margin-bottom: 24px; }
  .bd-sec__n { width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--depth); display: flex; align-items: center; justify-content: center; font-size: 12px; flex-shrink: 0; }
  .bd-sec__t { font-size: 16px; font-weight: 500; margin: 0; }
  .bd-count { margin-left: auto; font-size: 13px; color: var(--mid); font-variant-numeric: tabular-nums; }
  .bd-sublabel { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--depth); font-weight: 500; margin: 0 0 14px; }
  .bd-hint { font-size: 13px; color: var(--faint); margin: 0; }

  /* Date rail */
  .bd-rail { display: flex; gap: 12px; overflow-x: auto; padding: 2px 2px 14px; scroll-snap-type: x proximity; }
  .bd-rail::-webkit-scrollbar { height: 6px; }
  .bd-rail::-webkit-scrollbar-thumb { background: #e0d9cd; border-radius: 4px; }
  .bd-rdate { flex: 0 0 auto; width: 76px; border: 1px solid var(--rule); background: #fff; border-radius: 3px; padding: 13px 0; text-align: center; cursor: pointer; font-family: inherit; scroll-snap-align: start; transition: border-color .2s, background .2s; }
  .bd-rdate .dw { display: block; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); }
  .bd-rdate .nm { display: block; font-family: var(--serif-display); font-size: 28px; font-weight: 300; line-height: 1.1; margin: 3px 0 1px; font-variant-numeric: tabular-nums; }
  .bd-rdate .mo { display: block; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--mid); }
  .bd-rdate:hover { border-color: var(--depth); }
  .bd-rdate.sel { background: var(--depth); border-color: var(--depth); }
  .bd-rdate.sel .dw, .bd-rdate.sel .mo { color: rgba(255,255,255,.6); }
  .bd-rdate.sel .nm { color: #fff; }

  /* Time slots */
  .bd-slot-btns { display: flex; gap: 10px; flex-wrap: wrap; }
  .bd-slot { flex: 1; min-width: 130px; border: 1px solid var(--rule); background: #fff; padding: 15px; cursor: pointer; font-family: inherit; font-size: 14px; color: var(--depth); display: flex; flex-direction: column; gap: 3px; transition: border-color .2s, background .2s; }
  .bd-slot span { font-size: 12px; color: var(--mid); }
  .bd-slot:hover { border-color: var(--depth); }
  .bd-slot.sel { border-color: var(--depth); background: var(--depth); color: #fff; }
  .bd-slot.sel span { color: rgba(255,255,255,.72); }

  /* Bag grid */
  .bd-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(150px,1fr)); gap: 14px; }
  .bd-bag { position: relative; border: 1px solid var(--rule); background: #fff; padding: 0 0 12px; cursor: pointer; font-family: inherit; text-align: left; transition: border-color .2s, box-shadow .2s; overflow: hidden; }
  .bd-bag:hover { border-color: #c8c0b4; box-shadow: 0 4px 16px rgba(0,0,0,.05); }
  .bd-bag.sel { border-color: var(--depth); }
  .bd-bag__img { display: block; aspect-ratio: 4/5; background: #f6f3ee; overflow: hidden; }
  .bd-bag__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
  .bd-bag:hover .bd-bag__img img { transform: scale(1.045); }
  .bd-bag__check { position: absolute; top: 8px; right: 8px; width: 22px; height: 22px; border-radius: 50%; background: var(--depth); color: #fff; display: none; align-items: center; justify-content: center; font-size: 12px; }
  .bd-bag.sel .bd-bag__check { display: flex; animation: bd-pop .3s ease; }
  .bd-bag__name { display: block; font-size: 12px; letter-spacing: .04em; text-transform: uppercase; color: var(--depth); margin: 10px 10px 3px; }
  .bd-bag__price { display: block; font-size: 13px; color: var(--mid); margin: 0 10px; }

  /* Fields */
  .bd-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .bd-field { display: flex; flex-direction: column; gap: 7px; }
  .bd-field--full { grid-column: 1 / -1; }
  .bd-field span { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--depth); font-weight: 500; }
  .bd-input { padding: 13px 14px; border: 1px solid var(--rule); background: #fff; font-family: inherit; font-size: 14px; color: var(--depth); }
  .bd-input:focus { outline: none; border-color: var(--depth); }

  /* Live summary sidebar */
  .bd-side { position: sticky; top: 24px; align-self: start; border-left: 1px solid var(--rule); }
  .bd-side__inner { background: var(--cream); padding: clamp(28px,3vw,38px) clamp(24px,2.5vw,32px); }
  .bd-side__t { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--cherry); margin: 0 0 20px; }
  .bd-sum { display: flex; flex-direction: column; gap: 16px; }
  .bd-sum__row { display: flex; flex-direction: column; gap: 4px; }
  .bd-sum__k { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); }
  .bd-sum__v { font-size: 14px; line-height: 1.4; color: var(--depth); }
  .bd-sum__v.muted { color: var(--faint); }
  .bd-side__cta { width: 100%; justify-content: center; margin-top: 26px; }
  .bd-side__note { font-size: 12px; color: #9a938a; line-height: 1.6; margin: 16px 0 0; }

  /* Success */
  .bd-done { max-width: 560px; margin: 0 auto; text-align: center; padding: clamp(72px,12vw,150px) var(--gutter); }
  .bd-done__mark { width: 58px; height: 58px; border-radius: 50%; background: #2f6b3f; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 26px; margin-bottom: 24px; }
  .bd-done__title { font-size: clamp(30px,4.5vw,44px); margin: 0 0 16px; color: var(--depth); }
  .bd-done__body { font-size: 15px; line-height: 1.7; color: var(--mid); margin: 0 0 32px; }
  .bd-done__btn { display: inline-flex; height: 50px; align-items: center; padding: 0 32px; background: var(--depth); color: #fff; font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; font-weight: 500; text-decoration: none; transition: background .3s; }
  .bd-done__btn:hover { background: var(--cherry); }

  /* Motion */
  @keyframes bd-pop { 0% { transform: scale(.55); opacity: 0; } 70% { transform: scale(1.12); } 100% { transform: scale(1); opacity: 1; } }
  .bd-hero__text > * { animation: bd-fade-up .6s ease both; }
  .bd-hero__eyebrow { animation-delay: 0s; } .bd-hero__h { animation-delay: .08s; } .bd-hero__sub { animation-delay: .16s; }
  @keyframes bd-fade-up { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .bd *, .bd-hero__text > * { animation: none !important; transition: none !important; } }

  @media (max-width: 900px) {
    .bd-hero { grid-template-columns: 1fr; }
    .bd-hero__img { min-height: 280px; order: -1; }
    .bd-book { grid-template-columns: 1fr; }
    .bd-side { position: static; border-left: none; border-top: 1px solid var(--rule); }
    .bd-side__inner { padding: 28px clamp(28px,4vw,56px); }
  }
  @media (max-width: 620px) {
    .bd-strip { grid-template-columns: 1fr 1fr; }
    .bd-strip__i:nth-child(2) { border-right: none; }
    .bd-strip__i:nth-child(1), .bd-strip__i:nth-child(2) { border-bottom: 1px solid var(--rule); }
    .bd-fields { grid-template-columns: 1fr; }
    .bd-slot { min-width: 0; }
  }
</style>

<script is:inline>
  (function () {
    var selectedISO = '', selectedLabel = '', selectedSlot = '';
    var selectedBags = new Map(); // variantId -> title

    var $ = function (id) { return document.getElementById(id); };
    var val = function (id) { var el = $(id); return el ? (el.value || '').trim() : ''; };

    // ── Build the date rail (tomorrow → +45 days) ──
    var rail = $('rail');
    var today = new Date(); today.setHours(0, 0, 0, 0);
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    for (var i = 1; i <= 45; i++) {
      var d = new Date(today); d.setDate(d.getDate() + i);
      var iso = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
      var label = d.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' });
      var btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'bd-rdate';
      btn.dataset.iso = iso; btn.dataset.label = label;
      btn.innerHTML = '<span class="dw">' + d.toLocaleDateString('en-IN', { weekday: 'short' }) + '</span>' +
        '<span class="nm">' + d.getDate() + '</span>' +
        '<span class="mo">' + d.toLocaleDateString('en-IN', { month: 'short' }) + '</span>';
      btn.addEventListener('click', function () {
        rail.querySelectorAll('.bd-rdate').forEach(function (x) { x.classList.remove('sel'); });
        this.classList.add('sel');
        selectedISO = this.dataset.iso; selectedLabel = this.dataset.label;
        $('slotHint').hidden = true; $('slotBtns').hidden = false;
        updateSummary();
      });
      rail.appendChild(btn);
    }

    // ── Time slots ──
    document.querySelectorAll('.bd-slot').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('.bd-slot').forEach(function (x) { x.classList.remove('sel'); });
        b.classList.add('sel'); selectedSlot = b.dataset.slot; updateSummary();
      });
    });

    // ── Bags ──
    document.querySelectorAll('.bd-bag').forEach(function (tile) {
      tile.addEventListener('click', function () {
        var vid = tile.dataset.vid;
        if (selectedBags.has(vid)) { selectedBags.delete(vid); tile.classList.remove('sel'); }
        else {
          if (selectedBags.size >= 6) { flashErr('You can choose up to 6 bags for a home demo.'); return; }
          selectedBags.set(vid, tile.dataset.title); tile.classList.add('sel');
        }
        $('bagCount').textContent = String(selectedBags.size);
        updateSummary();
      });
    });

    // ── Details → summary "Area" ──
    ['f-area', 'f-pin', 'f-name'].forEach(function (id) {
      var el = $(id); if (el) el.addEventListener('input', updateSummary);
    });

    function updateSummary() {
      set('sum-date', selectedLabel, 'Choose a day');
      set('sum-time', selectedSlot, 'Choose a time');
      var names = []; selectedBags.forEach(function (t) { names.push(t); });
      set('sum-bags', names.length ? names.join(', ') : '', 'Up to six pieces');
      var area = val('f-area') || (val('f-pin') ? 'Mumbai ' + val('f-pin') : '');
      set('sum-area', area, 'Add your details');
    }
    function set(id, value, placeholder) {
      var el = $(id); if (!el) return;
      el.textContent = value || placeholder;
      el.classList.toggle('muted', !value);
    }

    function flashErr(msg) { var e = $('bookErr'); e.hidden = false; e.textContent = msg; }
    function clearErr() { $('bookErr').hidden = true; }

    // ── Confirm ──
    $('bookBtn').addEventListener('click', function () {
      clearErr();
      if (!selectedISO || !selectedSlot) { flashErr('Please choose a date and time above.'); return; }
      if (selectedBags.size < 1) { flashErr('Please select at least one bag to try.'); return; }
      var name = val('f-name'), phone = val('f-phone').replace(/\D/g, ''), email = val('f-email'),
        addr = val('f-addr'), area = val('f-area'), pin = val('f-pin');
      if (!name || !phone || !email || !addr) { flashErr('Please fill in your name, phone, email and address.'); return; }
      if (phone.length !== 10) { flashErr('Please enter a valid 10-digit phone number.'); return; }
      if (!/^\S+@\S+\.\S+$/.test(email)) { flashErr('Please enter a valid email address.'); return; }
      if (!/^40\d{4}$/.test(pin)) { flashErr('Home demos are Mumbai-only for now — please enter a Mumbai PIN.'); return; }

      var btn = $('bookBtn'); btn.disabled = true; btn.textContent = 'Booking…';
      var bagList = []; selectedBags.forEach(function (title, vid) { bagList.push({ variantId: vid, title: title }); });
      fetch('/api/book-demo', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ date: selectedLabel, slot: selectedSlot, bags: bagList, name: name, phone: phone, email: email, address: addr, area: area, pin: pin })
      }).then(function (res) {
        return res.json().then(function (data) { return { ok: res.ok, data: data }; });
      }).then(function (r) {
        if (!r.ok || !r.data.ok) throw new Error((r.data && r.data.error) || 'Could not book your demo.');
        $('bdMain').style.display = 'none';
        $('bdDoneBody').textContent = 'We’ll call you shortly to confirm your ' + selectedSlot + ' slot on ' + selectedLabel + '. Relax — there’s absolutely no pressure to buy.';
        $('bdDone').hidden = false;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }).catch(function (err) {
        flashErr(err.message); btn.disabled = false; btn.textContent = 'Confirm home demo';
      });
    });
  })();
</script>
