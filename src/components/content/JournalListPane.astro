---
// Shared app shell for the Journal: wallpaper + floating "glass" window +
// folders sidebar + note-list column — used by both the index page
// (/blog) and the article page (/blog/[slug]). The detail pane is passed in as
// the default slot so both pages render this exact same shell instead of drifting.
//
// This deliberately does NOT reuse <SiteHeader>/<SiteFooter> — the reference this
// is modeled on (a macOS Notes-style app window on a wallpaper) doesn't fit inside
// the site's normal nav chrome. Instead a minimal brand strip (monogram + "Shop"
// link) is woven into the window itself, just enough to get back to the store.
import { POSTS, CATEGORIES, groupByMonth, formatShortDate } from '~/data/journal';

interface Props { activeSlug?: string; mode: 'list' | 'detail' }
const { activeSlug, mode } = Astro.props;

const { marketConfig } = Astro.locals;
const prefix = marketConfig.urlPrefix;
const url = (slug: string) => `${prefix}/blog/${slug}`;
const homeHref = prefix || '/';
const shopHref = `${prefix}/shop`;
const folderIcon = 'M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z';

const byNewest = [...POSTS].sort((a, b) => b.date.localeCompare(a.date));
const pinned = byNewest.find((p) => p.role === 'cover') ?? null;
const stories = pinned ? byNewest.filter((p) => p.slug !== pinned.slug) : byNewest;
const monthGroups = groupByMonth(stories);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c, POSTS.filter((p) => p.category === c).length]));
const storyWord = (n: number) => `${n} ${n === 1 ? 'story' : 'stories'}`;
---
<div class="nt-shell">
  <div class="nt-window">
    <div class="nt-topbar">
      <a class="nt-topbar__brand" href={homeHref} aria-label="Mir Kash — home">
        <img src="/android-chrome-192x192.png" alt="" width="15" height="15" />
        <span>Mir Kash</span>
      </a>
      <a class="nt-topbar__shop" href={shopHref}>Shop</a>
    </div>

    <div class="nt-app" data-mode={mode}>
      <aside class="nt-sidebar" aria-label="Folders">
        <p class="nt-sidebar__lbl">Founder Notes</p>
        <p class="nt-sidebar__mtitle">Founder Notes</p>
        <ul class="nt-folders" id="ntFolders" role="listbox" aria-label="Filter by folder">
          <li role="presentation">
            <button type="button" data-cat="all" aria-selected="true" class="is-on">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={folderIcon}/></svg>
              <span class="nt-folder-name">All Notes</span>
              <span class="nt-folder-count">{POSTS.length}</span>
            </button>
          </li>
          {CATEGORIES.map((c) => (
            <li role="presentation">
              <button type="button" data-cat={c} aria-selected="false">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={folderIcon}/></svg>
                <span class="nt-folder-name">{c}</span>
                <span class="nt-folder-count">{counts[c]}</span>
              </button>
            </li>
          ))}
        </ul>
        <label class="nt-sidebar__search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="search" placeholder="Search" id="ntSearchMobile" autocomplete="off" />
        </label>
      </aside>

      <div class="nt-viewbar">
        <div class="nt-viewbar__title">
          <div class="nt-viewbar__name-wrap">
            <p class="nt-viewbar__name" id="ntFolderLabelDesktop">All Notes</p>
            <p class="nt-viewbar__count" id="ntFolderCountDesktop">{storyWord(POSTS.length)}</p>
          </div>
          <span class="nt-viewbar__more" aria-hidden="true" title="More">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="7.5" cy="12" r="0.5" fill="currentColor"/><circle cx="12" cy="12" r="0.5" fill="currentColor"/><circle cx="16.5" cy="12" r="0.5" fill="currentColor"/></svg>
          </span>
        </div>
        <div class="nt-viewbar__right">
          <div class="nt-pillgroup" aria-hidden="true">
            <span title="Text style">Aa</span>
            <span title="Checklist"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 6h11"/><path d="M10 12h11"/><path d="M10 18h11"/><path d="M3 6l1.5 1.5L7 5"/><path d="M3 12l1.5 1.5L7 11"/></svg></span>
            <span title="Table"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M12 3v18"/></svg></span>
            <span title="Attach"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg></span>
          </div>
          <div class="nt-pillgroup" aria-hidden="true">
            <span title="Listen"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5l12 7.5-12 7.5z"/></svg></span>
            <span title="Share"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M16 6l-4-4-4 4"/><path d="M12 2v13"/></svg></span>
          </div>
          <label class="nt-viewbar__search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="search" placeholder="Search" id="ntSearchDesktop" autocomplete="off" />
          </label>
        </div>
      </div>

      <div class="nt-list" id="ntList">
        <div class="nt-list__mhead">
          <button type="button" class="nt-list__mback" id="ntBackToFolders" aria-label="Back to folders">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <p class="nt-list__mtitle" id="ntFolderLabel">All Notes</p>
          <p class="nt-list__mcount" id="ntFolderCount">{storyWord(POSTS.length)}</p>
        </div>

        <div class="nt-groups" id="ntGroups" data-folder="all">
          {pinned && (
            <div class="nt-group" data-group="pinned">
              <h2 class="nt-month">Pinned</h2>
              <ul class="nt-rows">
                <li>
                  <a class:list={['nt-row', { 'is-active': activeSlug === pinned.slug }]} data-cat={pinned.category} data-search={`${pinned.title} ${pinned.excerpt} ${pinned.category}`.toLowerCase()} href={url(pinned.slug)}>
                    <p class="nt-row__t">{pinned.title}</p>
                    <p class="nt-row__l2"><time datetime={pinned.date} class="nt-row__date">{formatShortDate(pinned.date)}</time>{pinned.excerpt}</p>
                    <p class="nt-row__folder">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={folderIcon}/></svg>
                      {pinned.category}
                    </p>
                  </a>
                </li>
              </ul>
            </div>
          )}
          {monthGroups.map((g) => (
            <div class="nt-group" data-group={g.key}>
              <h2 class="nt-month">{g.label}</h2>
              <ul class="nt-rows">
                {g.posts.map((p) => (
                  <li>
                    <a class:list={['nt-row', { 'is-active': activeSlug === p.slug }]} data-cat={p.category} data-search={`${p.title} ${p.excerpt} ${p.category}`.toLowerCase()} href={url(p.slug)}>
                      <p class="nt-row__t">{p.title}</p>
                      <p class="nt-row__l2"><time datetime={p.date} class="nt-row__date">{formatShortDate(p.date)}</time>{p.excerpt}</p>
                      <p class="nt-row__folder">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={folderIcon}/></svg>
                        {p.category}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="nt-empty" id="ntEmpty" hidden>No stories in this folder yet.</p>
      </div>

      <slot />
    </div>
  </div>
</div>

<style is:global>
  /* ═══ Journal app shell — wallpaper, glass window, traffic lights, sidebar,
     list, and detail pane all styled here so the index and article pages (which
     both render this component) stay pixel-identical instead of drifting. Fonts/
     colors intentionally match the Apple Notes reference exactly (system font
     stack, its literal gold accents) rather than the site's normal Jost/brand
     palette — a deliberate one-off for this section only. ══ */

  .nt-window {
    --nt-font: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --nt-gold-deep: #ecae12;   /* selected sidebar folder */
    --nt-gold-pale: #fed87a;   /* selected/active note row */
    --nt-ink: #171717;         /* neutral-900 */
    --nt-mid: #6b6b6b;         /* neutral-500 */
    --nt-soft: #a3a3a3;        /* neutral-400 */
    --nt-line: rgba(0,0,0,.1);
    font-family: var(--nt-font);
    color: var(--nt-ink);
  }

  /* ── Wallpaper + floating window ─────────────────────── */
  .nt-shell {
    height: 100dvh; width: 100%; overflow: hidden;
    background: #000 url('/journal/wallpaper.svg') center/cover no-repeat;
    display: flex; align-items: center; justify-content: center;
    padding: 0; box-sizing: border-box;
  }
  @media (min-width: 640px) { .nt-shell { padding: 12px; } }
  @media (min-width: 1024px) { .nt-shell { padding: 20px; } }

  .nt-window {
    width: 100%; height: 100%; display: flex; flex-direction: column;
    overflow: hidden; background: #fff;
  }
  @media (min-width: 640px) {
    .nt-window {
      border-radius: 1.4rem; border: 1px solid rgba(0,0,0,.1);
      background: rgba(244,244,243,.78); backdrop-filter: blur(30px) saturate(1.3);
      -webkit-backdrop-filter: blur(30px) saturate(1.3);
      box-shadow: 0 45px 115px -15px rgba(0,0,0,.45), 0 15px 45px -10px rgba(0,0,0,.28);
    }
  }

  /* ── Minimal brand strip — the only site nav inside the window ─────────── */
  .nt-topbar {
    flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between;
    height: 38px; padding: 0 14px; border-bottom: 1px solid var(--nt-line);
    background: rgba(255,255,255,.5);
  }
  .nt-topbar__brand { display: flex; align-items: center; gap: 6px; text-decoration: none; color: var(--nt-ink); font-size: 12.5px; font-weight: 600; letter-spacing: .01em; }
  .nt-topbar__brand img { display: block; height: 15px; width: auto; }
  .nt-topbar__shop { font-size: 12.5px; color: var(--nt-mid); text-decoration: none; }
  .nt-topbar__shop:hover { color: var(--nt-ink); text-decoration: underline; }

  .nt-app {
    flex: 1; min-height: 0;
    display: grid;
    grid-template-columns: 224px 288px minmax(0, 1fr);
    grid-template-rows: 52px 1fr;
    grid-template-areas: "sidebar viewbar viewbar" "sidebar list detail";
  }
  @media (min-width: 1024px) { .nt-app { grid-template-columns: 224px 320px minmax(0, 1fr); } }

  /* ── View-options toolbar — mostly decorative (matches the reference's own
     disabled/aria-disabled state for everything but search, which is real). ── */
  .nt-viewbar { grid-area: viewbar; display: flex; align-items: stretch; min-width: 0; border-bottom: 1px solid var(--nt-line); background: rgba(255,255,255,.5); }
  .nt-viewbar__title { flex: 0 0 288px; min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 0 10px 0 16px; border-right: 1px solid var(--nt-line); }
  @media (min-width: 1024px) { .nt-viewbar__title { flex-basis: 320px; } }
  .nt-viewbar__name-wrap { min-width: 0; }
  .nt-viewbar__name { font-size: 15px; font-weight: 600; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nt-viewbar__count { font-size: 12px; color: var(--nt-mid); margin: 0; }
  .nt-viewbar__more {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--nt-line);
    background: rgba(255,255,255,.6); color: var(--nt-soft); cursor: not-allowed; opacity: .6;
  }
  .nt-viewbar__right { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: flex-end; gap: 10px; padding: 0 16px; }
  .nt-pillgroup { display: inline-flex; align-items: center; gap: 2px; padding: 3px; border-radius: 999px; border: 1px solid var(--nt-line); background: rgba(255,255,255,.6); flex: 0 0 auto; }
  .nt-pillgroup span { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 24px; color: var(--nt-soft); font-size: 13px; font-weight: 500; cursor: not-allowed; opacity: .6; }
  .nt-viewbar__search {
    display: flex; align-items: center; gap: 6px; height: 30px; width: 150px; flex: 0 1 auto;
    padding: 0 10px; border-radius: 999px; border: 1px solid var(--nt-line);
    background: rgba(255,255,255,.7); color: var(--nt-mid);
  }
  .nt-viewbar__search svg { flex: 0 0 auto; }
  .nt-viewbar__search input { flex: 1; min-width: 0; border: none; background: none; font-size: 13px; color: var(--nt-ink); outline: none; }
  .nt-viewbar__search input::placeholder { color: var(--nt-soft); }
  .nt-viewbar__search:focus-within { border-color: var(--nt-gold-deep); box-shadow: 0 0 0 3px rgba(236,174,18,.15); }

  /* ── Sidebar ─────────────────────────────────────────── */
  .nt-sidebar { grid-area: sidebar; min-width: 0; overflow-y: auto; background: rgba(251,251,252,.6); border-right: 1px solid var(--nt-line); padding-bottom: 16px; }
  .nt-sidebar__lbl { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: rgba(107,107,107,.8); margin: 0; padding: 20px 22px 8px 24px; }
  .nt-sidebar__mtitle { display: none; }
  .nt-sidebar__search { display: none; }
  .nt-folders { list-style: none; margin: 0; padding: 0 12px; display: flex; flex-direction: column; gap: 2px; }
  .nt-folders button {
    width: 100%; display: flex; align-items: center; gap: 10px;
    font-family: inherit; font-size: 13.5px; color: var(--nt-ink);
    background: none; border: none; padding: 6px 10px; border-radius: 8px;
    cursor: pointer; text-align: left; transition: background-color .15s;
  }
  .nt-folders button:hover { background: rgba(0,0,0,.05); }
  .nt-folders button.is-on { background: var(--nt-gold-deep); color: #fff; font-weight: 600; }
  .nt-folders button svg { flex: 0 0 auto; color: var(--nt-soft); }
  .nt-folders button.is-on svg { color: #fff; }
  .nt-folder-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .nt-folder-count { flex: 0 0 auto; font-size: 13px; font-weight: 500; color: var(--nt-soft); font-variant-numeric: tabular-nums; }
  .nt-folders button.is-on .nt-folder-count { color: rgba(255,255,255,.8); }

  /* ── List column ────────────────────────────────────── */
  .nt-list { grid-area: list; min-width: 0; border-right: 1px solid var(--nt-line); overflow-y: auto; padding: 0 12px 24px; }
  .nt-list__mback { display: none; }
  .nt-list__mtitle { display: none; }
  .nt-list__mcount { display: none; }
  .nt-list__mhead { display: none; }

  .nt-groups { padding-top: 8px; }
  .nt-group.is-empty { display: none; }
  .nt-month { font-size: 15px; font-weight: 700; margin: 0; padding: 16px 10px 6px; }

  .nt-rows { list-style: none; margin: 0; padding: 0; }
  .nt-rows li[hidden] { display: none; }
  .nt-row {
    display: block; border-radius: 12px; padding: 10px 12px;
    text-decoration: none; color: inherit; transition: background-color .15s;
  }
  .nt-row:hover { background: rgba(0,0,0,.04); }
  .nt-row.is-active { background: var(--nt-gold-pale); }
  .nt-row__t { font-size: 15px; font-weight: 600; line-height: 1.3; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .nt-row__l2 { font-size: 13px; line-height: 1.3; color: var(--nt-mid); margin: 1px 0 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .nt-row.is-active .nt-row__l2 { color: #3f3f3f; }
  .nt-row__date { margin-right: 8px; color: var(--nt-mid); font-variant-numeric: tabular-nums; }
  .nt-row.is-active .nt-row__date { color: #3f3f3f; }
  .nt-row__folder { display: none; align-items: center; gap: 6px; font-size: 13px; color: var(--nt-mid); margin: 4px 0 0; }
  .nt-row__folder svg { flex: 0 0 auto; }
  .nt-groups[data-folder="all"] .nt-row__folder { display: flex; }
  .nt-empty { text-align: center; font-size: 14px; color: var(--nt-soft); padding: 60px 0; }

  /* ── Detail pane (styled here; markup lives in each page) ───────────────── */
  .nt-detail { grid-area: detail; min-width: 0; overflow-y: auto; background: rgba(255,255,255,.97); }
  .nt-detail__date { width: 100%; text-align: center; font-size: 12px; color: var(--nt-soft); padding: 20px 0 16px; margin: 0; }
  .nt-detail__toolbar { display: none; }
  .nt-detail__back, .nt-detail__mshare { display: none; }
  .nt-detail__art { padding: 0 24px 80px; }
  @media (min-width: 640px) { .nt-detail__art { padding: 0 40px 80px; } }
  @media (min-width: 1024px) { .nt-detail__art { padding: 0 56px 80px; } }
  .nt-detail__title { font-size: 26px; font-weight: 700; line-height: 1.25; margin: 0 0 16px; }
  .nt-detail__sub { font-style: italic; color: var(--nt-mid); font-size: 16px; line-height: 1.5; margin: -8px 0 20px; }

  /* Values below are lifted verbatim from the reference site's own compiled
     markdown-styles-module CSS (not approximated) — font-size:15px/line-height
     1.625, exact heading sizes/weights, the gold #e0a30c link/blockquote accent. */
  .nt-detail__body { font-size: 15px; line-height: 1.625; color: var(--nt-ink); }
  .nt-detail__body > :first-child { margin-top: 0; }
  .nt-detail__body p { margin: 1rem 0; }
  .nt-detail__body div { margin: 0 0 14px; }
  .nt-detail__body h2 { font-family: inherit; font-weight: 700; font-size: 1.25rem; line-height: 1.375; margin: 2rem 0 .75rem; }
  .nt-detail__body h3 { font-family: inherit; font-weight: 600; font-size: 1.125rem; line-height: 1.375; margin: 1.5rem 0 .75rem; }
  .nt-detail__body h4 { font-family: inherit; font-weight: 600; font-size: 1rem; margin: 1.25rem 0 .5rem; }
  .nt-detail__body a { color: #e0a30c; text-decoration: underline; text-underline-offset: 2px; }
  .nt-detail__body strong { font-weight: 600; }
  .nt-detail__body ul, .nt-detail__body ol { margin: 1rem 0; padding-left: 1.5rem; }
  .nt-detail__body ul { list-style-type: disc; }
  .nt-detail__body ol { list-style-type: decimal; }
  .nt-detail__body li { margin-bottom: 6px; }
  .nt-detail__body img { display: block; max-width: 100%; height: auto; max-height: 60vh; margin: 1rem 0; object-fit: contain; border-radius: .5rem; }
  .nt-detail__body blockquote {
    margin: 1rem 0; padding: .5rem .75rem .5rem 1rem; border-left: 3px solid #e0a30c;
    border-top-right-radius: .5rem; border-bottom-right-radius: .5rem;
    background: #e0a30c12; color: #525252; font-style: italic;
  }
  .nt-detail__body hr { border: none; height: 1px; background: rgba(0,0,0,.1); margin: 2rem 0; }
  .nt-detail__body table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 14px; }
  .nt-detail__body th, .nt-detail__body td { text-align: left; padding: .375rem .75rem; border: 1px solid rgba(0,0,0,.1); vertical-align: top; }
  .nt-detail__body th { background: rgba(0,0,0,.05); font-weight: 600; }
  .nt-detail__body code { background: rgba(0,0,0,.05); border-radius: .25rem; padding: .125rem .25rem; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 13px; }
  .nt-detail__body pre { background: rgba(0,0,0,.05); border-radius: .5rem; margin: 1rem 0; padding: 1rem; overflow-x: auto; }
  .nt-detail__body pre code { background: none; padding: 0; }

  .nt-detail__share { display: flex; align-items: center; gap: 10px; margin-top: 34px; padding-top: 20px; border-top: 1px solid var(--nt-line); }
  .nt-detail__share-lbl { font-size: 12px; color: var(--nt-soft); margin-right: 2px; }
  .nt-ico {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--nt-line);
    background: none; padding: 0; cursor: pointer; color: var(--nt-ink); text-decoration: none;
    transition: background-color .15s, color .15s;
  }
  .nt-ico:hover { background: var(--nt-ink); border-color: var(--nt-ink); color: #fff; }
  .nt-detail__copied { font-size: 12px; color: var(--nt-mid); }

  .nt-detail__foot { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--nt-line); display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
  .nt-detail__foot a { font-size: 13px; font-weight: 500; color: var(--nt-ink); text-decoration: none; border-bottom: 1px solid var(--nt-line); padding-bottom: 2px; }
  .nt-detail__foot a:hover { color: var(--nt-mid); }

  .nt-detail__related { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--nt-line); }
  .nt-detail__related-lbl { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--nt-soft); margin: 0 0 10px; }
  .nt-detail__related ul { list-style: none; margin: 0; padding: 0; }
  .nt-detail__related li { border-bottom: 1px solid var(--nt-line); }
  .nt-detail__related a { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding: 10px 0; text-decoration: none; color: inherit; }
  .nt-detail__related a:hover { opacity: .6; }
  .nt-detail__related-t { font-size: 14px; font-weight: 600; }
  .nt-detail__related-c { flex: 0 0 auto; font-size: 11.5px; color: var(--nt-soft); }
  .nt-detail__empty { display: flex; align-items: center; justify-content: center; height: 100%; color: var(--nt-soft); font-size: 14px; }

  /* ── Responsive: < 640px collapses to three full-screen steps — Folders,
     then a note list, then a single open note — instead of side-by-side
     panes. Matches the reference's actual mobile navigation (confirmed from
     its own screenshots), not a compressed version of the desktop layout. ── */
  @media (max-width: 639px) {
    .nt-app { grid-template-columns: 1fr; grid-template-rows: none; grid-template-areas: none; }
    /* Resetting the parent's grid-template-areas isn't enough on its own —
       these still carry a named grid-area from the desktop layout, and with
       no matching area left to resolve against, browsers don't reliably fall
       back to plain auto-placement (produced stale multi-column tracks).
       Reset the items themselves too. */
    .nt-sidebar, .nt-list, .nt-detail, .nt-viewbar { grid-area: auto; }
    .nt-viewbar { display: none; }
    .nt-app[data-mode="list"] .nt-detail { display: none; }
    .nt-app[data-mode="detail"] .nt-sidebar,
    .nt-app[data-mode="detail"] .nt-list { display: none; }
    .nt-app[data-mode="detail"] .nt-detail { display: block; }

    /* Step 1 (default) — Folders, full screen. Step 2 (data-mstage="list") —
       swaps to the note list. JS drives this; the CSS default (no attribute
       yet) already matches step 1 so there's no flash before it runs. */
    .nt-app[data-mode="list"] .nt-list { display: none; }
    .nt-app[data-mode="list"][data-mstage="list"] .nt-sidebar { display: none; }
    .nt-app[data-mode="list"][data-mstage="list"] .nt-list { display: block; }

    .nt-sidebar { position: relative; height: 100%; background: #eeeef1; border-right: none; padding-bottom: 76px; }
    .nt-sidebar__lbl { display: none; }
    .nt-sidebar__mtitle { display: block; font-size: 34px; font-weight: 700; margin: 0; padding: 20px var(--gutter) 4px; }
    .nt-folders { flex-direction: column; gap: 0; margin: 14px var(--gutter) 0; padding: 0; background: #fff; border-radius: 16px; overflow: hidden; }
    .nt-folders li + li { border-top: 1px solid var(--nt-line); }
    .nt-folders button { padding: 13px 16px; border-radius: 0; font-size: 17px; gap: 12px; }
    .nt-folders button svg { width: 22px; height: 22px; color: #e0a30c; }
    .nt-folders button.is-on { background: none; color: var(--nt-ink); font-weight: 400; }
    .nt-folders button.is-on svg { color: #e0a30c; }
    .nt-folder-count { font-size: 17px; }
    .nt-folders button.is-on .nt-folder-count { color: var(--nt-soft); }
    .nt-folders button::after {
      content: ''; flex: 0 0 auto; width: 7px; height: 7px; margin-left: 2px;
      border-right: 1.8px solid #c7c7cc; border-bottom: 1.8px solid #c7c7cc; transform: rotate(-45deg);
    }
    .nt-sidebar__search { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 16px; display: flex; align-items: center; gap: 8px; height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--nt-line); background: rgba(255,255,255,.85); color: var(--nt-soft); }
    .nt-sidebar__search input { flex: 1; min-width: 0; border: none; background: none; font-size: 15px; color: inherit; outline: none; }
    .nt-sidebar__search input::placeholder { color: var(--nt-soft); }
    .nt-sidebar__search:focus-within { border-color: var(--nt-gold-deep); box-shadow: 0 0 0 3px rgba(236,174,18,.15); }

    .nt-list { border-right: none; padding: 0 var(--gutter) 60px; background: #f2f2f4; }
    .nt-list__mhead { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 14px 0 4px; }
    .nt-list__mback { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 36px; margin-left: -8px; border: none; background: none; color: var(--nt-ink); padding: 0; cursor: pointer; }
    .nt-list__mtitle { display: block; font-size: 30px; font-weight: 700; margin: 6px 0 0; }
    .nt-list__mcount { display: block; font-size: 13px; color: var(--nt-mid); margin: 0; }
    .nt-month { font-size: 20px; padding: 18px 2px 8px; }
    .nt-groups { border-top: none; }
    /* Card belongs to the rows only — the month label sits free above it on
       the page background (was wrapped inside the same card, reading as if
       the date were part of the first note). */
    .nt-group { margin-bottom: 14px; }
    .nt-rows { background: #fff; border: 1px solid var(--nt-line); border-radius: 16px; overflow: hidden; }
    .nt-row { border-radius: 0; margin: 0; padding: 12px 14px; }
    .nt-rows li + li .nt-row { border-top: 1px solid var(--nt-line); }
    .nt-row.is-active { background: none; }

    /* Note detail toolbar — plain borderless icons (back chevron left, share
       right), not the glass circular buttons used elsewhere in the shell. */
    .nt-detail__toolbar { display: flex; align-items: center; justify-content: space-between; padding: 10px 6px 0; }
    .nt-detail__back, .nt-detail__mshare {
      display: inline-flex; align-items: center; justify-content: center;
      width: 40px; height: 40px; border-radius: 8px; border: none; background: none;
      color: var(--nt-ink); padding: 0; cursor: pointer; text-decoration: none;
    }
    .nt-detail__back:active, .nt-detail__mshare:active { background: rgba(0,0,0,.06); }
    .nt-detail__art { padding: 0 var(--gutter) 60px; }
  }
  @media (prefers-reduced-motion: reduce) { .nt-app * { transition: none !important; } }
</style>

<script is:inline>
  (function () {
    var bar = document.getElementById('ntFolders');
    var groupsEl = document.getElementById('ntGroups');
    var label = document.getElementById('ntFolderLabel');
    var countEl = document.getElementById('ntFolderCount');
    var label2 = document.getElementById('ntFolderLabelDesktop');
    var count2 = document.getElementById('ntFolderCountDesktop');
    var empty = document.getElementById('ntEmpty');
    if (!bar || !groupsEl) return;

    var buttons = Array.prototype.slice.call(bar.querySelectorAll('button'));
    var groups = Array.prototype.slice.call(groupsEl.querySelectorAll('.nt-group'));
    var appEl = document.querySelector('.nt-app');
    var backBtn = document.getElementById('ntBackToFolders');
    var searchInputs = Array.prototype.slice.call(document.querySelectorAll('#ntSearchMobile, #ntSearchDesktop'));

    var currentCat = 'all';
    var currentQuery = '';

    function setMstage(stage) {
      if (appEl) appEl.setAttribute('data-mstage', stage);
    }

    // Search takes over row matching entirely (across every folder) while a
    // query is active — clearing it goes back to plain folder filtering.
    function rowMatches(r) {
      if (currentQuery) return (r.dataset.search || '').indexOf(currentQuery) !== -1;
      return currentCat === 'all' || r.dataset.cat === currentCat;
    }

    function refresh() {
      var total = 0;
      groups.forEach(function (g) {
        var rows = Array.prototype.slice.call(g.querySelectorAll('.nt-row'));
        var shown = 0;
        rows.forEach(function (r) {
          var li = r.closest('li');
          var show = rowMatches(r);
          if (li) li.hidden = !show;
          if (show) shown++;
        });
        g.classList.toggle('is-empty', shown === 0);
        total += shown;
      });
      groupsEl.setAttribute('data-folder', currentQuery ? 'all' : currentCat);
      var countText = total + (total === 1 ? ' story' : ' stories');
      if (countEl) countEl.textContent = countText;
      if (count2) count2.textContent = countText;
      if (empty) {
        empty.hidden = total > 0;
        empty.textContent = currentQuery ? 'No stories match “' + currentQuery + '”.' : 'No stories in this folder yet.';
      }
    }

    function setLabel(text) {
      if (label) label.textContent = text;
      if (label2) label2.textContent = text;
    }

    function apply(cat, push) {
      currentCat = cat;
      buttons.forEach(function (b) {
        var on = b.dataset.cat === cat;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
        if (on) setLabel(cat === 'all' ? 'All Notes' : b.querySelector('.nt-folder-name').textContent);
      });
      refresh();
      // Mobile: any folder pick (including "All Notes") moves from the Folders
      // screen to the note list — matches the reference's real navigation.
      setMstage('list');

      // "All Notes" used to drop the query param entirely, which left the URL
      // identical to the bare Folders screen — so there was no history entry
      // to return to, and a note opened from "All Notes" sent its back button
      // straight past the list to Folders. Every pick (including "all") now
      // gets its own ?topic= entry so the list stage is always reconstructable
      // from the URL alone, on both popstate and a fresh page load.
      var next = location.pathname + '?topic=' + encodeURIComponent(cat);
      if (push && next !== location.pathname + location.search) history.pushState({ cat: cat }, '', next);
    }

    // null = no ?topic= at all = the true entry point, show Folders.
    // 'all'/a known category = already drilled into the list, show it directly.
    function fromUrl() {
      var t = new URLSearchParams(location.search).get('topic');
      if (!t) return null;
      return t === 'all' || buttons.some(function (b) { return b.dataset.cat === t; }) ? t : 'all';
    }

    bar.addEventListener('click', function (e) {
      var btn = e.target.closest('button');
      if (btn) apply(btn.dataset.cat, true);
    });
    if (backBtn) backBtn.addEventListener('click', function () { setMstage('folders'); });
    window.addEventListener('popstate', function () {
      var t = fromUrl();
      if (t) apply(t, false); else setMstage('folders');
    });

    // Both search boxes (the mobile Folders-screen one and the desktop
    // toolbar one) drive the same query — typing in either updates both, so
    // resizing mid-search never leaves the hidden one out of sync.
    searchInputs.forEach(function (input) {
      input.addEventListener('input', function () {
        currentQuery = input.value.trim().toLowerCase();
        searchInputs.forEach(function (other) { if (other !== input) other.value = input.value; });
        if (currentQuery) {
          setLabel('Search');
          setMstage('list');
        } else {
          var activeBtn = buttons.filter(function (b) { return b.dataset.cat === currentCat; })[0];
          var nameEl = activeBtn && activeBtn.querySelector('.nt-folder-name');
          setLabel(currentCat === 'all' || !nameEl ? 'All Notes' : nameEl.textContent);
        }
        refresh();
      });
    });

    var initial = fromUrl();
    if (initial) apply(initial, false); else refresh();
  })();
</script>
