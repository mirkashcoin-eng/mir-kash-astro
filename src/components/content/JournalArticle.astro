---
import JournalListPane from './JournalListPane.astro';
import { relatedPosts, formatJournalDate, type JournalPost } from '~/data/journal';
import { SITE_ORIGIN, absoluteUrl } from '~/lib/markets';

interface Props { post: JournalPost }
const { post } = Astro.props;
const { marketConfig } = Astro.locals;
const prefix = marketConfig.urlPrefix;
const url = (slug: string) => `${prefix}/blog/${slug}`;

const related = relatedPosts(post.slug, 3);
const shareUrl = Astro.url.href;
const waHref = `https://wa.me/?text=${encodeURIComponent(post.title + ' — ' + shareUrl)}`;
const fbHref = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;
const pinHref = `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(shareUrl)}&description=${encodeURIComponent(post.title)}`;

const canonical = absoluteUrl(`${prefix}/blog/${post.slug}`);
const orgRef = { '@type': 'Organization', name: 'Mir Kash', url: SITE_ORIGIN, logo: SITE_ORIGIN + '/mir-kash-logo.webp' };
const postJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  dateModified: post.date,
  mainEntityOfPage: canonical,
  author: orgRef,
  publisher: orgRef,
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl(prefix || '/') },
    { '@type': 'ListItem', position: 2, name: 'The Journal', item: absoluteUrl(`${prefix}/blog`) },
    { '@type': 'ListItem', position: 3, name: post.title, item: canonical },
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(postJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

<JournalListPane activeSlug={post.slug} mode="detail">
  <main class="nt-detail">
    <div class="nt-detail__toolbar">
      <a class="nt-detail__back" href={`${prefix}/blog`} aria-label="Back to The Journal">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
      </a>
      <button type="button" class="nt-detail__mshare" data-url={shareUrl} data-title={post.title} aria-label="Share this note">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="M8 7l4-4 4 4"/><path d="M4 13v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-6"/></svg>
      </button>
    </div>
    <p class="nt-detail__date"><time datetime={post.date}>{formatJournalDate(post.date)}</time></p>
    <article class="nt-detail__art">
      <h1 class="nt-detail__title">{post.title}</h1>
      <p class="nt-detail__sub">{post.excerpt}</p>

      <div class="nt-detail__body" set:html={post.body} />

      <div class="nt-detail__share">
        <span class="nt-detail__share-lbl">Share</span>
        <a class="nt-ico" href={waHref} target="_blank" rel="noopener" aria-label="Share on WhatsApp" title="WhatsApp">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        </a>
        <a class="nt-ico" href={pinHref} target="_blank" rel="noopener" aria-label="Save to Pinterest" title="Pinterest">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.53.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0Z"/></svg>
        </a>
        <a class="nt-ico" href={fbHref} target="_blank" rel="noopener" aria-label="Share on Facebook" title="Facebook">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073Z"/></svg>
        </a>
        <button class="nt-ico nt-copy" type="button" data-url={shareUrl} aria-label="Copy link" title="Copy link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        </button>
        <span class="nt-detail__copied" id="ntCopied" role="status" hidden>Link copied</span>
      </div>

      <nav class="nt-detail__foot" aria-label="Post navigation">
        <a href={`${prefix}/blog`}>&larr; Back to The Journal</a>
        <a href={`${prefix}/shop`}>Shop the collection &rarr;</a>
      </nav>

      {related.length > 0 && (
        <div class="nt-detail__related">
          <p class="nt-detail__related-lbl">More notes</p>
          <ul>
            {related.map((r) => (
              <li>
                <a href={url(r.slug)}>
                  <span class="nt-detail__related-t">{r.title}</span>
                  <span class="nt-detail__related-c">{r.category}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </article>
  </main>
</JournalListPane>

<script is:inline>
  (function () {
    var flag = document.getElementById('ntCopied');
    function copyLink(url) {
      var u = url || location.href;
      var done = function () {
        if (!flag) return;
        flag.hidden = false;
        clearTimeout(flag._t);
        flag._t = setTimeout(function () { flag.hidden = true; }, 2200);
      };
      if (navigator.clipboard) navigator.clipboard.writeText(u).then(done, done); else done();
    }

    var btn = document.querySelector('.nt-copy');
    if (btn) btn.addEventListener('click', function () { copyLink(btn.getAttribute('data-url')); });

    // Mobile toolbar share button — native share sheet where available
    // (title/text/url, like sharing anything else on the phone), falling
    // back to the same copy-link behavior as the desktop share row.
    var mshare = document.querySelector('.nt-detail__mshare');
    if (mshare) {
      mshare.addEventListener('click', function () {
        var u = mshare.getAttribute('data-url') || location.href;
        var t = mshare.getAttribute('data-title') || document.title;
        if (navigator.share) {
          navigator.share({ title: t, url: u }).catch(function () {});
        } else {
          copyLink(u);
        }
      });
    }
  })();
</script>
