---
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import { getAllProducts } from '~/lib/shopify/queries';
import { shopifyImage } from '~/lib/shopifyImage';
import { POSTS, CATEGORIES, type JournalPost } from '~/data/journal';

const { marketConfig } = Astro.locals;
const prefix = marketConfig.urlPrefix;
const url = (slug: string) => `${prefix}/blog/${slug}`;
const cardDate = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// Shopify product photos stand in for post images (swappable later via post.image).
const products = await getAllProducts(marketConfig.store, marketConfig.countryCode, 48).catch(() => []);
const withImg = products.filter((p) => p.featuredImage?.url);

// Posts naming a product get that photo; the rest walk the remaining catalogue, so no
// two cards on the page show the same bag.
const match = (m: string) =>
  withImg.find((x) => x.handle.includes(m) || x.title.toLowerCase().includes(m));
const claimed = new Set(
  POSTS.filter((p) => !p.image && p.imageMatch).map((p) => match(p.imageMatch)?.handle).filter(Boolean) as string[],
);
const spare = withImg.filter((p) => !claimed.has(p.handle));
const used = new Set<string>();
let spareAt = 0;
const imageFor = new Map<string, string>();
for (const p of POSTS) {
  if (p.image) { imageFor.set(p.slug, p.image); continue; }
  let pick = p.imageMatch ? match(p.imageMatch) : undefined;
  if (!pick || used.has(pick.handle)) pick = spare.length ? spare[spareAt++ % spare.length] : pick;
  if (pick?.featuredImage?.url) {
    used.add(pick.handle);
    imageFor.set(p.slug, pick.featuredImage.url);
  }
}
const imgFor = (post: JournalPost, w: number) => {
  const src = imageFor.get(post.slug);
  if (!src) return '';
  return src.startsWith('/') ? src : shopifyImage(src, w);
};

const byNewest = [...POSTS].sort((a, b) => b.date.localeCompare(a.date));
const featured = byNewest.find((p) => p.role === 'cover') ?? byNewest[0];
const stories = byNewest.filter((p) => p.slug !== featured.slug);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c, stories.filter((p) => p.category === c).length]));
---
<SiteHeader />

<main class="jr">

  <!-- ══ MASTHEAD ══ -->
  <section class="jr-mast">
    <p class="jr-eyebrow">The Journal</p>
    <h1 class="jr-display jr-mast__h">Notes on craft, material and <em>living slowly.</em></h1>
    <p class="jr-mast__p">Stories from inside the atelier &mdash; how our bags are made, what they&rsquo;re made of, and how to wear them for years rather than seasons.</p>
  </section>

  <!-- ══ FEATURED STORY ══ -->
  <section class="jr-feat">
    <a class="jr-feat__img" href={url(featured.slug)} tabindex="-1" aria-hidden="true">
      {imgFor(featured, 1000)
        ? <img src={imgFor(featured, 1000)} alt="" />
        : <span class="jr-mk">MK</span>}
    </a>
    <div class="jr-feat__text">
      <p class="jr-eyebrow">Featured &middot; {featured.category}</p>
      <h2 class="jr-display jr-feat__h"><a href={url(featured.slug)}>{featured.title}</a></h2>
      <p class="jr-body">{featured.excerpt}</p>
      <p class="jr-meta">{cardDate(featured.date)} &middot; {featured.readMin} min read</p>
      <a class="jr-link" href={url(featured.slug)}>Read the story &rarr;</a>
    </div>
  </section>

  <!-- ══ ALL STORIES ══ -->
  <section class="jr-all">
    <div class="jr-bar">
      <h2 class="jr-display jr-bar__h">All stories</h2>
      <div class="jr-filters" id="jrFilters" role="group" aria-label="Filter stories by topic">
        <button type="button" data-cat="all" aria-pressed="true" class="is-on">All</button>
        {CATEGORIES.filter((c) => counts[c] > 0).map((c) => (
          <button type="button" data-cat={c} aria-pressed="false">{c}</button>
        ))}
      </div>
    </div>

    <p class="jr-count" id="jrCount" aria-live="polite">{stories.length} stories</p>

    <div class="jr-grid" id="jrGrid">
      {stories.map((p) => (
        <a class="jr-card" href={url(p.slug)} data-cat={p.category}>
          <span class="jr-card__img">
            {imgFor(p, 700)
              ? <img src={imgFor(p, 700)} alt="" loading="lazy" />
              : <span class="jr-mk jr-mk--sm">MK</span>}
          </span>
          <span class="jr-card__cat">{p.category}</span>
          <h3 class="jr-display jr-card__h">{p.title}</h3>
          <span class="jr-card__ex">{p.excerpt}</span>
          <span class="jr-meta">{cardDate(p.date)} &middot; {p.readMin} min read</span>
        </a>
      ))}
    </div>

    <p class="jr-empty" id="jrEmpty" hidden>No stories in this topic yet.</p>
  </section>

  <!-- ══ CLOSING CTA ══ -->
  <section class="jr-cta">
    <p class="jr-display jr-cta__line">Beauty you can feel proud to carry.</p>
    <div class="jr-cta__links">
      <a href={`${prefix}/shop`}>Explore the collection &rarr;</a>
      <a href={`${prefix}/pages/materials`}>Our materials &rarr;</a>
    </div>
  </section>

</main>

<SiteFooter />

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap');

  :root { --cherry: #8B1A1A; --depth: #2C1A0E; }
  body { background: #fff; }
  .hdr-menu-btn { display: none; }
  .site-header--minimal .logo { grid-column: 2; justify-self: center; }
  .site-header--minimal .logo img { height: 22px; }
  .site-header--minimal .hdr-right { grid-column: 3; justify-self: end; gap: 14px; }

  .jr {
    --serif-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --cream: #F6F1E9;
    --body-ink: #4a4038;
    background: #fff; color: var(--depth);
  }
  /* Elegant serif for every display line; em = cherry accent (never italic) */
  .jr-display { font-family: var(--serif-display); font-weight: 300; letter-spacing: 0; }
  .jr em { font-style: normal; color: var(--cherry); }

  .jr-eyebrow {
    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    font-weight: 500; color: var(--cherry); margin: 0 0 18px;
  }
  .jr-body { font-size: 15.5px; line-height: 1.9; color: var(--body-ink); margin: 0; }
  .jr-meta {
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-soft, #a8a39c); margin: 0;
  }
  .jr-link {
    display: inline-block;
    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    font-weight: 600; color: var(--depth); border-bottom: 1px solid var(--depth);
    padding-bottom: 3px; text-decoration: none; transition: color .2s, border-color .2s;
  }
  .jr-link:hover { color: var(--cherry); border-color: var(--cherry); }

  /* Placeholder mark for posts with no photo yet */
  .jr-mk {
    display: flex; align-items: center; justify-content: center;
    width: 100%; height: 100%;
    font-family: var(--serif-display); font-weight: 300;
    font-size: clamp(30px, 3vw, 46px); letter-spacing: .12em; color: #cbb79b;
  }
  .jr-mk--sm { font-size: 26px; }

  /* ── Masthead ────────────────────────────────────────── */
  .jr-mast {
    max-width: 800px; margin: 0 auto; text-align: center;
    padding: clamp(52px, 8vw, 108px) var(--gutter) clamp(28px, 3.5vw, 48px);
  }
  .jr-mast__h {
    color: var(--depth); font-size: clamp(34px, 5vw, 62px); line-height: 1.08;
    margin: 0 auto 24px; max-width: 16ch; text-wrap: balance;
  }
  .jr-mast__p { font-size: 15.5px; line-height: 1.9; color: var(--body-ink); margin: 0 auto; max-width: 54ch; }

  /* ── Featured story ──────────────────────────────────── */
  .jr-feat {
    display: grid; grid-template-columns: 1fr 1fr; align-items: center;
    gap: clamp(32px, 6vw, 88px); max-width: 1280px; margin: 0 auto;
    padding: clamp(8px, 2vw, 28px) var(--gutter) clamp(72px, 11vw, 132px);
  }
  .jr-feat__img {
    display: block; aspect-ratio: 4 / 5; overflow: hidden;
    background: var(--cream); position: relative;
  }
  .jr-feat__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .jr-feat__img:hover img { transform: scale(1.03); }
  .jr-feat__text { max-width: 34rem; }
  .jr-feat__h { font-size: clamp(30px, 4vw, 50px); line-height: 1.08; margin: 0 0 22px; text-wrap: balance; }
  .jr-feat__h a { color: var(--depth); text-decoration: none; transition: color .2s; }
  .jr-feat__h a:hover { color: var(--cherry); }
  .jr-feat .jr-meta { margin: 22px 0 0; }
  .jr-feat .jr-link { margin-top: 26px; }

  /* ── All stories ─────────────────────────────────────── */
  .jr-all { max-width: 1280px; margin: 0 auto; padding: 0 var(--gutter) clamp(72px, 11vw, 128px); }
  .jr-bar {
    display: flex; align-items: baseline; justify-content: space-between;
    flex-wrap: wrap; gap: 18px 40px;
    padding-bottom: 18px; border-bottom: 1px solid var(--rule, #e4dfd7);
  }
  .jr-bar__h { font-size: clamp(26px, 3vw, 36px); line-height: 1; color: var(--depth); margin: 0; }
  .jr-filters { display: flex; flex-wrap: wrap; gap: 10px 28px; }
  .jr-filters button {
    font-family: inherit; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    font-weight: 500; color: var(--ink-mid, #6e6a64);
    background: none; border: none; border-bottom: 1px solid transparent;
    padding: 0 0 4px; cursor: pointer; transition: color .2s, border-color .2s;
  }
  .jr-filters button:hover { color: var(--depth); }
  .jr-filters button.is-on { color: var(--depth); border-bottom-color: var(--cherry); font-weight: 600; }
  .jr-filters button:focus-visible { outline: 1px solid var(--cherry); outline-offset: 4px; }

  .jr-count {
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-soft, #a8a39c); margin: 18px 0 clamp(30px, 4vw, 46px);
  }

  .jr-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(40px, 5vw, 68px) clamp(24px, 3vw, 44px);
  }
  .jr-card { display: block; color: inherit; text-decoration: none; }
  .jr-card.is-hidden { display: none; }
  .jr-card__img {
    display: block; aspect-ratio: 4 / 5; overflow: hidden;
    background: var(--cream); margin-bottom: 22px;
  }
  .jr-card__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .jr-card:hover .jr-card__img img { transform: scale(1.03); }
  .jr-card__cat {
    display: block; font-size: 10.5px; letter-spacing: 0.18em; text-transform: uppercase;
    font-weight: 500; color: var(--cherry); margin-bottom: 12px;
  }
  .jr-card__h {
    font-size: clamp(21px, 1.9vw, 25px); line-height: 1.18; color: var(--depth);
    margin: 0 0 12px; text-wrap: balance; transition: color .2s;
  }
  .jr-card:hover .jr-card__h { color: var(--cherry); }
  .jr-card__ex {
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    font-size: 14.5px; line-height: 1.8; color: var(--body-ink); margin-bottom: 14px;
  }
  .jr-empty { text-align: center; font-size: 15px; color: var(--ink-soft, #a8a39c); padding: 60px 0; }

  /* ── Closing CTA (cream) ─────────────────────────────── */
  .jr-cta { background: var(--cream); text-align: center; padding: clamp(80px, 12vw, 150px) var(--gutter); }
  .jr-cta__line { color: var(--depth); font-size: clamp(28px, 3.8vw, 46px); line-height: 1.1; margin: 0 0 30px; }
  .jr-cta__links { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 16px 44px; }
  .jr-cta__links a {
    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    font-weight: 600; color: var(--depth); border-bottom: 1px solid var(--depth);
    padding-bottom: 3px; text-decoration: none; transition: color .2s, border-color .2s;
  }
  .jr-cta__links a:hover { color: var(--cherry); border-color: var(--cherry); }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 1024px) {
    .jr-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .jr-feat { grid-template-columns: 1fr; gap: 28px; }
    .jr-feat__text { max-width: none; }
    .jr-grid { grid-template-columns: 1fr; gap: 52px; }
    .jr-bar { flex-direction: column; align-items: flex-start; gap: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .jr-feat__img img, .jr-card__img img { transition: none; }
    .jr-feat__img:hover img, .jr-card:hover .jr-card__img img { transform: none; }
  }
</style>

<script is:inline>
  (function () {
    var bar = document.getElementById('jrFilters');
    var grid = document.getElementById('jrGrid');
    var count = document.getElementById('jrCount');
    var empty = document.getElementById('jrEmpty');
    if (!bar || !grid) return;

    var buttons = Array.prototype.slice.call(bar.querySelectorAll('button'));
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.jr-card'));

    function apply(cat, push) {
      var shown = 0;
      cards.forEach(function (c) {
        var show = cat === 'all' || c.dataset.cat === cat;
        c.classList.toggle('is-hidden', !show);
        if (show) shown++;
      });
      buttons.forEach(function (b) {
        var on = b.dataset.cat === cat;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      if (count) count.textContent = shown + (shown === 1 ? ' story' : ' stories') + (cat === 'all' ? '' : ' in ' + cat);
      if (empty) empty.hidden = shown > 0;

      // Keep the choice in the URL so it survives back/forward and can be shared.
      var next = cat === 'all' ? location.pathname : location.pathname + '?topic=' + encodeURIComponent(cat);
      if (push && next !== location.pathname + location.search) history.pushState({ cat: cat }, '', next);
    }

    function fromUrl() {
      var t = new URLSearchParams(location.search).get('topic');
      return t && buttons.some(function (b) { return b.dataset.cat === t; }) ? t : 'all';
    }

    bar.addEventListener('click', function (e) {
      var btn = e.target.closest('button');
      if (btn) apply(btn.dataset.cat, true);
    });
    window.addEventListener('popstate', function () { apply(fromUrl(), false); });

    var initial = fromUrl();
    if (initial !== 'all') apply(initial, false);
  })();
</script>
