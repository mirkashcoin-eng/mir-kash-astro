---
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import { POSTS, CATEGORIES } from '~/data/journal';

const { marketConfig } = Astro.locals;
const prefix = marketConfig.urlPrefix;
const url = (slug: string) => `${prefix}/blog/${slug}`;
const longDate = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const byNewest = [...POSTS].sort((a, b) => b.date.localeCompare(a.date));
const featured = byNewest.find((p) => p.role === 'cover') ?? byNewest[0];
const stories = byNewest.filter((p) => p.slug !== featured.slug);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c, stories.filter((p) => p.category === c).length]));
const pad = (n: number) => String(n).padStart(2, '0');
---
<SiteHeader />

<main class="jr">

  <!-- ══ MASTHEAD ══ -->
  <section class="jr-mast">
    <div class="jr-mast__l">
      <p class="jr-eyebrow">The Journal</p>
      <h1 class="jr-display jr-mast__h">Notes on craft, material and <em>living slowly.</em></h1>
    </div>
    <p class="jr-mast__p">Stories from inside the atelier &mdash; how our bags are made, what they&rsquo;re made of, and how to wear them for years rather than seasons.</p>
  </section>

  <!-- ══ FEATURED STORY ══ -->
  <section class="jr-feat">
    <div class="jr-feat__in">
      <p class="jr-eyebrow">Featured &middot; {featured.category}</p>
      <div class="jr-feat__grid">
        <h2 class="jr-display jr-feat__h"><a href={url(featured.slug)}>{featured.title}</a></h2>
        <p class="jr-feat__ex">{featured.excerpt}</p>
      </div>
      <div class="jr-feat__foot">
        <a class="jr-link" href={url(featured.slug)}>Read the story &rarr;</a>
        <p class="jr-meta">{longDate(featured.date)} &middot; {featured.readMin} min read</p>
      </div>
    </div>
  </section>

  <!-- ══ INDEX ══ -->
  <section class="jr-all">
    <div class="jr-bar">
      <h2 class="jr-display jr-bar__h">All stories</h2>
      <div class="jr-filters" id="jrFilters" role="group" aria-label="Filter stories by topic">
        <button type="button" data-cat="all" aria-pressed="true" class="is-on">All</button>
        {CATEGORIES.filter((c) => counts[c] > 0).map((c) => (
          <button type="button" data-cat={c} aria-pressed="false">{c}</button>
        ))}
      </div>
      <p class="jr-count" id="jrCount" aria-live="polite">{stories.length} stories</p>
    </div>

    <ol class="jr-list" id="jrList">
      {stories.map((p, i) => (
        <li class="jr-row" data-cat={p.category}>
          <a href={url(p.slug)}>
            <span class="jr-display jr-row__n">{pad(i + 1)}</span>
            <span class="jr-row__body">
              <span class="jr-row__cat">{p.category}</span>
              <span class="jr-display jr-row__t">{p.title}</span>
              <span class="jr-row__ex">{p.excerpt}</span>
            </span>
            <span class="jr-row__meta">
              <span class="jr-row__date">{longDate(p.date)}</span>
              <span class="jr-row__min">{p.readMin} min read</span>
            </span>
            <span class="jr-row__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ol>

    <p class="jr-empty" id="jrEmpty" hidden>No stories in this topic yet.</p>
  </section>

  <!-- ══ CLOSING CTA ══ -->
  <section class="jr-cta">
    <p class="jr-display jr-cta__line">Beauty you can feel proud to carry.</p>
    <div class="jr-cta__links">
      <a href={`${prefix}/shop`}>Explore the collection &rarr;</a>
      <a href={`${prefix}/pages/materials`}>Our materials &rarr;</a>
    </div>
  </section>

</main>

<SiteFooter />

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap');

  :root { --cherry: #8B1A1A; --depth: #2C1A0E; }
  body { background: #fff; }
  .hdr-menu-btn { display: none; }
  .site-header--minimal .logo { grid-column: 2; justify-self: center; }
  .site-header--minimal .logo img { height: 22px; }
  .site-header--minimal .hdr-right { grid-column: 3; justify-self: end; gap: 14px; }

  .jr {
    --serif-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --cream: #F6F1E9;
    --oat: #EBE1D2;
    --body-ink: #4a4038;
    background: #fff; color: var(--depth);
  }
  /* Elegant serif for every display line; em = cherry accent (never italic) */
  .jr-display { font-family: var(--serif-display); font-weight: 300; letter-spacing: 0; }
  .jr em { font-style: normal; color: var(--cherry); }

  .jr-eyebrow {
    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    font-weight: 500; color: var(--cherry); margin: 0 0 18px;
  }
  .jr-meta {
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-soft, #a8a39c); margin: 0; font-variant-numeric: tabular-nums;
  }
  .jr-link {
    display: inline-block;
    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    font-weight: 600; color: var(--depth); border-bottom: 1px solid var(--depth);
    padding-bottom: 3px; text-decoration: none; transition: color .2s, border-color .2s;
  }
  .jr-link:hover { color: var(--cherry); border-color: var(--cherry); }

  /* ── Masthead — headline left, intro right, edge to edge ─ */
  .jr-mast {
    display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: end; gap: clamp(24px, 5vw, 96px);
    padding: clamp(52px, 8vw, 116px) var(--gutter) clamp(34px, 4vw, 54px);
  }
  .jr-mast__h {
    color: var(--depth); font-size: clamp(38px, 6.4vw, 104px); line-height: 1.02;
    margin: 0; text-wrap: balance;
  }
  .jr-mast__p {
    font-size: clamp(14.5px, 1.1vw, 17px); line-height: 1.85; color: var(--body-ink);
    margin: 0; max-width: 46ch; justify-self: end; padding-bottom: 8px;
  }

  /* ── Featured story — full-bleed cream band ──────────── */
  .jr-feat { background: var(--cream); padding: clamp(52px, 7vw, 108px) var(--gutter); }
  .jr-feat__grid {
    display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end; gap: clamp(24px, 5vw, 88px);
  }
  .jr-feat__h { font-size: clamp(32px, 4.6vw, 76px); line-height: 1.05; margin: 0; max-width: 20ch; text-wrap: balance; }
  .jr-feat__h a { color: var(--depth); text-decoration: none; transition: color .2s; }
  .jr-feat__h a:hover { color: var(--cherry); }
  .jr-feat__ex {
    font-size: clamp(15px, 1.15vw, 18px); line-height: 1.85; color: var(--body-ink);
    margin: 0; max-width: 52ch; justify-self: end; padding-bottom: 6px;
  }
  .jr-feat__foot {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 18px 40px; margin-top: clamp(30px, 3.5vw, 46px);
    padding-top: clamp(24px, 3vw, 36px); border-top: 1px solid rgba(44, 26, 14, 0.16);
  }

  /* ── Index bar ───────────────────────────────────────── */
  .jr-all { padding: clamp(48px, 6vw, 86px) var(--gutter) clamp(64px, 9vw, 120px); }
  .jr-bar {
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 16px clamp(24px, 4vw, 64px);
    padding-bottom: 20px; border-bottom: 2px solid var(--depth);
  }
  .jr-bar .jr-count { margin-left: clamp(8px, 2vw, 40px); }
  .jr-bar__h { font-size: clamp(26px, 3vw, 40px); line-height: 1; color: var(--depth); margin: 0; margin-right: auto; }
  .jr-filters { display: flex; flex-wrap: wrap; gap: 10px clamp(18px, 2vw, 32px); }
  .jr-filters button {
    font-family: inherit; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    font-weight: 500; color: var(--ink-mid, #6e6a64);
    background: none; border: none; border-bottom: 1px solid transparent;
    padding: 0 0 4px; cursor: pointer; transition: color .2s, border-color .2s;
  }
  .jr-filters button:hover { color: var(--depth); }
  .jr-filters button.is-on { color: var(--depth); border-bottom-color: var(--cherry); font-weight: 600; }
  .jr-filters button:focus-visible { outline: 1px solid var(--cherry); outline-offset: 4px; }
  .jr-count {
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-soft, #a8a39c); margin: 0; white-space: nowrap;
  }

  /* ── Index rows — full width, contents-page rhythm ───── */
  .jr-list { list-style: none; margin: 0; padding: 0; }
  .jr-row { border-bottom: 1px solid var(--rule, #e4dfd7); }
  .jr-row.is-hidden { display: none; }
  .jr-row > a {
    display: grid; align-items: start;
    grid-template-columns: clamp(56px, 6vw, 104px) minmax(0, 1fr) auto clamp(32px, 3vw, 56px);
    gap: clamp(16px, 2.5vw, 48px);
    padding: clamp(26px, 3.2vw, 44px) clamp(8px, 1.2vw, 22px);
    margin: 0 clamp(-8px, -1.2vw, -22px);
    color: inherit; text-decoration: none;
    transition: background-color .25s ease;
  }
  .jr-row > a:hover { background-color: var(--cream); }
  .jr-row__n {
    font-size: clamp(18px, 1.7vw, 26px); line-height: 1.4; color: var(--ink-soft, #a8a39c);
    font-variant-numeric: lining-nums tabular-nums; transition: color .25s;
  }
  .jr-row > a:hover .jr-row__n { color: var(--cherry); }
  .jr-row__body { display: block; min-width: 0; }
  .jr-row__cat {
    display: block; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
    font-weight: 500; color: var(--cherry); margin-bottom: 12px;
  }
  .jr-row__t {
    display: block; font-size: clamp(24px, 2.6vw, 40px); line-height: 1.12; color: var(--depth);
    max-width: 38ch; text-wrap: balance; transition: color .25s;
  }
  .jr-row > a:hover .jr-row__t { color: var(--cherry); }
  .jr-row__ex {
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    font-size: 14.5px; line-height: 1.8; color: var(--body-ink); margin-top: 12px; max-width: 96ch;
  }
  .jr-row__meta {
    display: flex; flex-direction: column; align-items: flex-end; gap: 8px;
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-soft, #a8a39c); white-space: nowrap; padding-top: 2px;
    font-variant-numeric: tabular-nums;
  }
  .jr-row__arrow {
    justify-self: end; font-size: 18px; color: var(--ink-soft, #a8a39c); line-height: 1.2;
    transition: transform .25s ease, color .25s;
  }
  .jr-row > a:hover .jr-row__arrow { transform: translateX(6px); color: var(--cherry); }
  .jr-empty { text-align: center; font-size: 15px; color: var(--ink-soft, #a8a39c); padding: 64px 0; }

  /* ── Closing CTA (oat) ───────────────────────────────── */
  .jr-cta { background: var(--oat); text-align: center; padding: clamp(80px, 12vw, 156px) var(--gutter); }
  .jr-cta__line { color: var(--depth); font-size: clamp(28px, 4vw, 52px); line-height: 1.1; margin: 0 0 30px; }
  .jr-cta__links { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 16px 44px; }
  .jr-cta__links a {
    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    font-weight: 600; color: var(--depth); border-bottom: 1px solid var(--depth);
    padding-bottom: 3px; text-decoration: none; transition: color .2s, border-color .2s;
  }
  .jr-cta__links a:hover { color: var(--cherry); border-color: var(--cherry); }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 1100px) {
    .jr-row > a { grid-template-columns: clamp(46px, 6vw, 72px) minmax(0, 1fr) clamp(28px, 4vw, 40px); }
    .jr-row__meta {
      grid-column: 2; flex-direction: row; align-items: baseline; gap: 14px;
      justify-content: flex-start; padding-top: 14px;
    }
    .jr-row__t { max-width: none; }
  }
  @media (max-width: 860px) {
    .jr-mast { grid-template-columns: 1fr; align-items: start; gap: 22px; }
    .jr-mast__p { justify-self: start; max-width: none; padding-bottom: 0; }
    .jr-bar { flex-direction: column; align-items: flex-start; gap: 14px; }
    .jr-bar__h { margin-right: 0; }
    .jr-bar .jr-count { margin-left: 0; }
    .jr-feat__grid { grid-template-columns: 1fr; align-items: start; gap: 22px; }
    .jr-feat__ex { justify-self: start; max-width: none; padding-bottom: 0; }
    .jr-feat__foot { flex-direction: column; align-items: flex-start; gap: 16px; }
  }
  @media (max-width: 560px) {
    .jr-row > a { grid-template-columns: 34px minmax(0, 1fr); gap: 14px; padding-left: 0; padding-right: 0; margin: 0; }
    .jr-row__n { font-size: 15px; line-height: 1.6; }
    .jr-row__arrow { display: none; }
    .jr-row__ex { -webkit-line-clamp: 3; }
  }
  @media (prefers-reduced-motion: reduce) {
    .jr-row > a, .jr-row__arrow { transition: none; }
    .jr-row > a:hover .jr-row__arrow { transform: none; }
  }
</style>

<script is:inline>
  (function () {
    var bar = document.getElementById('jrFilters');
    var list = document.getElementById('jrList');
    var count = document.getElementById('jrCount');
    var empty = document.getElementById('jrEmpty');
    if (!bar || !list) return;

    var buttons = Array.prototype.slice.call(bar.querySelectorAll('button'));
    var rows = Array.prototype.slice.call(list.querySelectorAll('.jr-row'));

    function apply(cat, push) {
      var shown = 0;
      rows.forEach(function (r) {
        var show = cat === 'all' || r.dataset.cat === cat;
        r.classList.toggle('is-hidden', !show);
        if (show) shown++;
      });
      buttons.forEach(function (b) {
        var on = b.dataset.cat === cat;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      if (count) count.textContent = shown + (shown === 1 ? ' story' : ' stories') + (cat === 'all' ? '' : ' in ' + cat);
      if (empty) empty.hidden = shown > 0;

      // Keep the choice in the URL so it survives back/forward and can be shared.
      var next = cat === 'all' ? location.pathname : location.pathname + '?topic=' + encodeURIComponent(cat);
      if (push && next !== location.pathname + location.search) history.pushState({ cat: cat }, '', next);
    }

    function fromUrl() {
      var t = new URLSearchParams(location.search).get('topic');
      return t && buttons.some(function (b) { return b.dataset.cat === t; }) ? t : 'all';
    }

    bar.addEventListener('click', function (e) {
      var btn = e.target.closest('button');
      if (btn) apply(btn.dataset.cat, true);
    });
    window.addEventListener('popstate', function () { apply(fromUrl(), false); });

    var initial = fromUrl();
    if (initial !== 'all') apply(initial, false);
  })();
</script>
