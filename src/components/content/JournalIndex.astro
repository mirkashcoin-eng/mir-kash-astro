---
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import { getAllProducts } from '~/lib/shopify/queries';
import { shopifyImage } from '~/lib/shopifyImage';
import { POSTS, CATEGORIES, formatJournalDate, type JournalPost } from '~/data/journal';

const { marketConfig } = Astro.locals;
const prefix = marketConfig.urlPrefix;
const url = (slug: string) => `${prefix}/blog/${slug}`;
const shortDate = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

// Shopify product photos stand in for post images (swappable later via post.image).
const products = await getAllProducts(marketConfig.store, marketConfig.countryCode, 48).catch(() => []);
const withImg = products.filter((p) => p.featuredImage?.url);
function imgFor(post: JournalPost, i: number, w = 800): string {
  if (post.image) return post.image;
  if (post.imageMatch) {
    const m = withImg.find(
      (p) => p.handle.includes(post.imageMatch) || p.title.toLowerCase().includes(post.imageMatch),
    );
    if (m?.featuredImage?.url) return shopifyImage(m.featuredImage.url, w);
  }
  const f = withImg[i % Math.max(withImg.length, 1)];
  return f?.featuredImage?.url ? shopifyImage(f.featuredImage.url, w) : '';
}

const cover = POSTS.find((p) => p.role === 'cover') ?? POSTS[0];
const rest = POSTS.filter((p) => p.slug !== cover.slug);
const issue = formatJournalDate(POSTS[0].date).replace(/^\d+ /, ''); // "Month Year"
const leadImg = imgFor(cover, 0, 900);
---
<SiteHeader />

<main class="jr">
  <div class="jr-paper">
    <section class="jr-rv">
      <!-- ── Masthead ── -->
      <div class="jr-mast">
        <span class="jr-mast__orn">&#10086;</span>
        <p class="jr-mast__wm">The Journal</p>
        <p class="jr-mast__sub"><span>Field notes from Mir Kash</span><span class="jr-mast__d">&middot;</span><span>No.&nbsp;01 &middot; {issue}</span></p>
      </div>

      <!-- ── Lead essay (cover story) ── -->
      <a class="jr-lead" href={url(cover.slug)}>
        <div class="jr-lead__txt">
          <span class="jr-eyebrow">The Cover Story &middot; {cover.category}</span>
          <h1 class="jr-display jr-lead__h">{cover.title}</h1>
          <p class="jr-lead__ex">{cover.excerpt}</p>
          <span class="jr-rd">Read the essay &rarr;</span>
        </div>
        <span class="jr-ph jr-lead__img">
          <span class="jr-ph__z">{leadImg ? <img src={leadImg} alt={cover.title} /> : <span class="jr-ph__mk">MK</span>}</span>
        </span>
      </a>

      <!-- ── Filter row ── -->
      <div class="jr-filters" id="jrFilters">
        <button class="on" data-cat="all">All stories</button>
        {CATEGORIES.map((c) => <button data-cat={c}>{c}</button>)}
      </div>

      <!-- ── Index ── -->
      <div class="jr-index" id="jrIndex">
        {rest.map((p, i) => (
          <a class="jr-item" href={url(p.slug)} data-cat={p.category}>
            <span class="jr-ph jr-item__img">
              <span class="jr-ph__z">{imgFor(p, i + 1, 320) ? <img src={imgFor(p, i + 1, 320)} alt={p.title} loading="lazy" /> : <span class="jr-ph__mk jr-ph__mk--sm">MK</span>}</span>
            </span>
            <span class="jr-item__body">
              <span class="jr-eyebrow jr-item__cat">{p.category}</span>
              <h3 class="jr-display jr-item__t">{p.title}</h3>
              <span class="jr-item__ex">{p.excerpt}</span>
              <span class="jr-item__meta">{shortDate(p.date)} &middot; {p.readMin} min read</span>
            </span>
          </a>
        ))}
      </div>
      <p class="jr-empty" id="jrEmpty" hidden>No stories in this section yet.</p>
    </section>
  </div>

  <!-- ── Subscribe ── -->
  <section class="jr-sub">
    <p class="jr-eyebrow jr-eyebrow--rose jr-sub__lbl">Letters from the atelier</p>
    <h2 class="jr-display jr-sub__h">A new story, once a season. Never more.</h2>
    <p class="jr-sub__p">Slow reading for slow fashion &mdash; materials, making, and the quiet craft behind every Mir Kash piece.</p>
    <form class="jr-sub__form" onsubmit="event.preventDefault();">
      <input type="email" placeholder="Your email address" aria-label="Email address" required />
      <button type="submit">Subscribe</button>
    </form>
  </section>
</main>

<SiteFooter />

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap');
  :root { --cherry: #8B1A1A; --depth: #2C1A0E; }
  body { background: #FCFAF5; }
  .hdr-menu-btn { display: none; }
  .site-header--minimal .logo { grid-column: 2; justify-self: center; }
  .site-header--minimal .logo img { height: 22px; }
  .site-header--minimal .hdr-right { grid-column: 3; justify-self: end; gap: 14px; }

  .jr {
    --serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --ground: #FCFAF5; --cream: #F6F1E9; --ink: #3d342b; --mid: #6a655d; --faint: #a79f92; --rule: #e2dac9;
    background: var(--ground); color: var(--depth);
  }
  .jr-display { font-family: var(--serif); font-weight: 300; letter-spacing: 0; }
  .jr em { font-style: italic; color: var(--cherry); }
  .jr-eyebrow { font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: var(--cherry); font-weight: 600; margin: 0; }
  .jr-eyebrow--rose { color: #e7b7ae; }
  .jr-rd { font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase; font-weight: 600; color: var(--depth); border-bottom: 1.5px solid var(--cherry); padding-bottom: 3px; display: inline-block; transition: color .2s; }

  /* Full-bleed: use the whole viewport, only capping on ultra-wide screens */
  .jr-paper { max-width: 1760px; margin: 0 auto; }
  .jr-rv { padding: clamp(34px,4vw,60px) clamp(24px,5vw,104px) clamp(24px,3vw,36px); }

  /* ── Masthead ── */
  .jr-mast { text-align: center; border-bottom: 2px solid var(--depth); padding-bottom: 20px; }
  .jr-mast__orn { display: block; color: var(--cherry); font-size: 15px; margin-bottom: 6px; opacity: .8; }
  .jr-mast__wm { font-family: var(--serif); font-weight: 400; font-size: clamp(38px,6vw,70px); letter-spacing: .04em; color: var(--depth); margin: 0; line-height: 1; }
  .jr-mast__sub { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin: 14px 0 0; font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: var(--mid); }
  .jr-mast__d { color: var(--faint); }

  /* ── Lead essay ── */
  .jr-lead { display: grid; grid-template-columns: 1.45fr 1fr; gap: clamp(28px,4vw,60px); align-items: center; text-decoration: none; color: inherit; padding: clamp(36px,4.5vw,58px) 0; border-bottom: 1px solid var(--rule); }
  .jr-lead__txt { display: flex; flex-direction: column; align-items: flex-start; }
  .jr-lead__txt .jr-eyebrow { margin-bottom: 14px; }
  .jr-lead__h { font-size: clamp(34px,4.8vw,62px); line-height: 1.0; color: var(--depth); margin: 0 0 18px; text-wrap: balance; transition: color .2s; }
  .jr-lead:hover .jr-lead__h { color: var(--cherry); }
  .jr-lead__ex { font-size: 16px; line-height: 1.78; color: var(--ink); margin: 0 0 26px; max-width: 44ch; }
  .jr-lead__img { aspect-ratio: 5/6; }

  /* ── Filters ── */
  .jr-filters { display: flex; gap: clamp(16px,2.4vw,30px); flex-wrap: wrap; padding: 22px 0; }
  .jr-filters button { font-family: 'Jost', sans-serif; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--mid); background: none; border: none; border-bottom: 1.5px solid transparent; padding: 3px 0; cursor: pointer; transition: color .2s, border-color .2s; }
  .jr-filters button:hover { color: var(--depth); }
  .jr-filters button.on { color: var(--depth); border-bottom-color: var(--cherry); }

  /* ── Index ── */
  .jr-index { display: grid; grid-template-columns: 1fr 1fr; gap: 0 clamp(36px,5vw,72px); }
  .jr-item { display: grid; grid-template-columns: 88px 1fr; gap: 20px; align-items: start; padding: 28px 0; border-top: 1px solid var(--rule); text-decoration: none; color: inherit; }
  .jr-item[hidden] { display: none; }  /* class display:grid would otherwise beat the UA [hidden] rule */
  .jr-item__img { aspect-ratio: 1; border-radius: 2px; }
  .jr-item__body { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .jr-item__cat { font-size: 9.5px; margin-bottom: 8px; }
  .jr-item__t { font-size: 23px; line-height: 1.1; color: var(--depth); margin: 0 0 8px; text-wrap: balance; transition: color .2s; }
  .jr-item:hover .jr-item__t { color: var(--cherry); }
  .jr-item__ex { font-size: 13px; line-height: 1.62; color: var(--mid); margin: 0 0 10px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .jr-item__meta { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--faint); font-variant-numeric: tabular-nums; }
  .jr-empty { text-align: center; color: var(--faint); font-size: 14px; padding: 44px 0; }

  /* Image frame — warm, deep editorial tone (not washed out); colour on hover */
  .jr-ph { display: block; position: relative; overflow: hidden; background: var(--cream); }
  .jr-ph__z { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; transition: transform .55s ease; }
  .jr-ph__z img { width: 100%; height: 100%; object-fit: cover; filter: sepia(.48) saturate(.72) brightness(.97) contrast(1.06); transition: filter .7s ease; }
  .jr-ph__mk { font-family: var(--serif); font-weight: 400; font-size: clamp(30px,3vw,46px); letter-spacing: .12em; color: #cbb79b; }
  .jr-ph__mk--sm { font-size: 22px; }
  .jr-lead:hover .jr-lead__img .jr-ph__z { transform: scale(1.035); }
  .jr-lead:hover .jr-ph__z img, .jr-item:hover .jr-ph__z img { filter: none; }

  /* ── Subscribe (rich dark anchor) ── */
  .jr-sub { background: var(--depth); color: #fff; text-align: center; padding: clamp(52px,6.5vw,92px) 24px; }
  .jr-sub__lbl { margin-bottom: 14px; }
  .jr-sub__h { font-size: clamp(28px,3.6vw,46px); line-height: 1.05; margin: 0 auto 12px; max-width: 20ch; color: #fff; }
  .jr-sub__p { font-size: 14px; color: rgba(255,255,255,.72); max-width: 44ch; margin: 0 auto 28px; line-height: 1.7; }
  .jr-sub__form { display: inline-flex; border-bottom: 1px solid rgba(255,255,255,.5); gap: 14px; padding-bottom: 8px; min-width: min(420px, 82vw); }
  .jr-sub__form input { flex: 1; background: none; border: none; color: #fff; font-family: var(--serif); font-size: 17px; outline: none; }
  .jr-sub__form input::placeholder { color: rgba(255,255,255,.5); }
  .jr-sub__form button { background: none; border: none; color: #fff; font-family: 'Jost', sans-serif; font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase; font-weight: 600; cursor: pointer; }

  /* wide screens: fill the width with a third column */
  @media (min-width: 1180px) { .jr-index { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1500px) { .jr-lead__ex, .jr-item__ex { max-width: 46ch; } }

  @media (max-width: 820px) {
    .jr-lead { grid-template-columns: 1fr; gap: 22px; }
    .jr-lead__img { aspect-ratio: 3/2; order: -1; }
    .jr-index { grid-template-columns: 1fr; gap: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .jr *, .jr-ph__z { transition: none !important; } }
</style>

<script is:inline>
  (function () {
    var wrap = document.getElementById('jrFilters');
    var items = Array.prototype.slice.call(document.querySelectorAll('#jrIndex > [data-cat]'));
    var empty = document.getElementById('jrEmpty');
    if (!wrap) return;
    wrap.addEventListener('click', function (e) {
      var btn = e.target.closest('button'); if (!btn) return;
      wrap.querySelectorAll('button').forEach(function (b) { b.classList.remove('on'); });
      btn.classList.add('on');
      var cat = btn.dataset.cat;
      var shown = 0;
      items.forEach(function (t) {
        var show = cat === 'all' || t.dataset.cat === cat;
        t.hidden = !show;
        if (show) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
  })();
</script>
