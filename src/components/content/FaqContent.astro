---
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';

const GROUPS = [
  {
    cat: 'General',
    items: [
      {
        q: 'What are your bags made from?',
        a: `<p>A mix of plant-based and synthetic vegan leathers.</p>
            <p>The most common plant leather we use is apple leather &mdash; made from the pulp and skin left over from apple juice production. It has the look and feel of conventional leather, with no animals involved at any stage. Other plant leathers follow the same principle: fruit and vegetable matter that would otherwise go to waste, processed into a material that performs.</p>
            <p>We also use high-grade synthetic vegan leathers. These are engineered materials &mdash; and in our testing, several have outperformed real leather on durability, scratch resistance, and consistency. We don&rsquo;t use a material because it has a good story. We use it because it holds up.</p>`,
      },
      { q: 'Are the bags vegan?', a: `<p>Yes. Every bag, every lining, every hardware detail. Nothing we use comes from an animal.</p>` },
      { q: 'How long will a bag last?', a: `<p>We design for years, not seasons. With normal use and basic care, your bag should last very long. We also provide a 1-year warranty.</p>` },
      { q: 'Do the bags smell like leather?', a: `<p>Plant leather has a very faint, clean scent. Nothing synthetic or chemical. Most people can&rsquo;t tell it apart from conventional leather.</p>` },
    ],
  },
  {
    cat: 'Orders',
    items: [
      { q: 'Where do you ship?', a: `<p>Worldwide.</p>` },
      { q: 'How much does shipping cost?', a: `<p>Free across India and Hong Kong. For all other countries, shipping costs are calculated at checkout.</p>` },
      { q: 'How long does delivery take?', a: `<p>Most orders arrive within 2 weeks. If your order is time-sensitive, write to us at <a href="mailto:order@mirkash.com">order@mirkash.com</a> before placing it and we&rsquo;ll do what we can.</p>` },
      { q: 'Can I track my order?', a: `<p>Yes. You&rsquo;ll receive a tracking link once your order is dispatched.</p>` },
    ],
  },
  {
    cat: 'Returns',
    items: [
      {
        q: 'What&rsquo;s your return policy?',
        a: `<p>You can return your bag within 14 days of delivery for a full refund. The bag must be unused and in its original packaging, dust bag included. Once we receive and inspect the bag, refunds are processed within 14 working days.</p>
            <p><a href="/pages/returns-portal">Start a return or exchange &rarr;</a></p>`,
      },
      { q: 'What does the warranty cover?', a: `<p>Manufacturing defects &mdash; stitching, hardware, structural issues. It does not cover wear from regular use, accidental damage, or misuse.</p>` },
      { q: 'What happens if something goes wrong under warranty?', a: `<p>Get in touch. We&rsquo;ll assess it and either repair or replace it.</p>` },
      { q: 'Do you offer repairs after the warranty period?', a: `<p>Not currently.</p>` },
    ],
  },
  {
    cat: 'Care',
    items: [
      { q: 'Is apple leather durable?', a: `<p>Yes. It&rsquo;s built for daily use &mdash; not delicate. Avoid prolonged exposure to direct sun or heavy rain, and it&rsquo;ll age well.</p>` },
      {
        q: 'How do I care for my bag?',
        a: `<p>Wipe with a soft dry cloth. For deeper cleaning, use a slightly damp cloth and air dry. Keep it away from sharp objects and store it in the dust bag when not in use.</p>
            <p>A few things that make the biggest difference over time:</p>
            <ul>
              <li>Use your bags. Leaving them idle is one of the main reasons bags lose their shape and the material starts to deteriorate. Rotation and regular use actually keeps them in better condition.</li>
              <li>Always store in the dust bag to prevent scuffing against other things.</li>
              <li>If you&rsquo;ve been out in the rain or humidity, let the bag dry fully before putting it away.</li>
              <li>Avoid storing near bathrooms or other damp areas.</li>
            </ul>`,
      },
      { q: 'Is apple leather waterproof?', a: `<p>Water-resistant, not waterproof. Fine in light rain. We wouldn&rsquo;t take it into a downpour.</p>` },
    ],
  },
  {
    cat: 'Other',
    items: [
      { q: 'Do you do gifting or corporate orders?', a: `<p>Yes. Write to us at <a href="mailto:order@mirkash.com">order@mirkash.com</a> for bulk or gifting enquiries, or see <a href="/pages/bulk-gifting">Bulk Gifting</a>.</p>` },
      { q: 'Can I try before I buy?', a: `<p>Yes &mdash; we offer complimentary home demos in Mumbai. <a href="/book-demo">Book a home demo &rarr;</a></p>` },
      { q: 'Something else on your mind?', a: `<p>Write to us at <a href="mailto:info@mirkash.com">info@mirkash.com</a>. We&rsquo;ll get back to you.</p>` },
    ],
  },
];

const CHIPS = ['All', ...GROUPS.map((g) => g.cat)];
const strip = (s: string) => s.replace(/<[^>]+>/g, ' ').replace(/&[a-z]+;/g, ' ').replace(/\s+/g, ' ').toLowerCase().trim();
const ITEMS = GROUPS.flatMap((g) => g.items.map((it) => ({ ...it, cat: g.cat, text: strip(it.q + ' ' + it.a) })));
---
<SiteHeader />

<main class="faq">
  <!-- ── Search hero ── -->
  <section class="faq-hero">
    <p class="faq-eyebrow faq-eyebrow--rose">Help Centre</p>
    <h1 class="faq-display faq-hero__h">How can we help?</h1>
    <form class="faq-search" id="faqSearchForm" onsubmit="event.preventDefault();">
      <svg class="faq-search__ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="search" id="faqSearch" placeholder="Search returns, shipping, care…" aria-label="Search the FAQ" autocomplete="off" />
      <button type="submit">Search</button>
    </form>
  </section>

  <!-- ── Body ── -->
  <section class="faq-body">
    <div class="faq-chips" id="faqChips">
      {CHIPS.map((c, i) => <button class={i === 0 ? 'on' : ''} data-cat={c}>{c}</button>)}
    </div>

    <div class="faq-list" id="faqList">
      {ITEMS.map((item) => (
        <details class="faq-item" data-cat={item.cat} data-text={item.text}>
          <summary class="faq-q">
            <span set:html={item.q}></span>
            <span class="faq-ic" aria-hidden="true">&#9662;</span>
          </summary>
          <div class="faq-a" set:html={item.a}></div>
        </details>
      ))}
    </div>

    <p class="faq-none" id="faqNone" hidden>No answers match that &mdash; try different words, or <a href="/pages/contact">write to us</a>.</p>

    <div class="faq-help">
      <h2 class="faq-display faq-help__h">Still have a question?</h2>
      <p class="faq-help__p">We&rsquo;re a small team, and we read every note.</p>
      <a class="faq-help__btn" href="/pages/contact">Write to us</a>
    </div>
  </section>
</main>

<SiteFooter />

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap');
  :root { --cherry: #8B1A1A; --depth: #2C1A0E; }
  body { background: #fff; }
  .hdr-menu-btn { display: none; }
  .site-header--minimal .logo { grid-column: 2; justify-self: center; }
  .site-header--minimal .logo img { height: 22px; }
  .site-header--minimal .hdr-right { grid-column: 3; justify-self: end; gap: 14px; }

  .faq {
    --serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --cream: #F6F1E9; --ink: #463d34; --mid: #6a655d; --faint: #a79f92; --rule: #e2dac9;
    background: #fff; color: var(--depth);
  }
  .faq-display { font-family: var(--serif); font-weight: 300; letter-spacing: 0; }
  .faq-eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--cherry); font-weight: 600; margin: 0; }
  .faq-eyebrow--rose { color: #e7b7ae; }

  /* Hero */
  .faq-hero { background: var(--depth); color: #fff; text-align: center; padding: clamp(52px,7vw,104px) 24px; }
  .faq-hero__h { font-size: clamp(36px,5vw,64px); line-height: 1.02; color: #fff; margin: 14px 0 30px; }
  .faq-search { display: flex; align-items: center; gap: 10px; max-width: 540px; margin: 0 auto; background: #fff; border-radius: 999px; padding: 6px 6px 6px 22px; }
  .faq-search__ic { color: var(--mid); flex: none; }
  .faq-search input { flex: 1; border: none; outline: none; background: none; font-family: 'Jost', sans-serif; font-size: 15px; color: var(--depth); padding: 13px 0; min-width: 0; }
  .faq-search input::placeholder { color: var(--faint); }
  .faq-search input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .faq-search button { flex: none; background: var(--depth); color: #fff; border: none; border-radius: 999px; padding: 13px 26px; font-family: 'Jost', sans-serif; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; cursor: pointer; transition: background .2s; }
  .faq-search button:hover { background: var(--cherry); }

  /* Body */
  .faq-body { max-width: 860px; margin: 0 auto; padding: clamp(40px,5vw,72px) clamp(24px,5vw,40px) clamp(48px,6vw,88px); }
  .faq-chips { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-bottom: clamp(28px,3.5vw,44px); }
  .faq-chips button { font-family: 'Jost', sans-serif; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--mid); background: var(--cream); border: none; padding: 10px 18px; border-radius: 999px; cursor: pointer; transition: background .2s, color .2s; }
  .faq-chips button:hover { color: var(--depth); }
  .faq-chips button.on { background: var(--depth); color: #fff; }

  .faq-list { border-top: 1px solid var(--rule); }
  .faq-item { border-bottom: 1px solid var(--rule); }
  .faq-item[hidden] { display: none; }
  .faq-item > summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 22px; padding: 24px 4px; }
  .faq-item > summary::-webkit-details-marker { display: none; }
  .faq-q > span:first-child { font-family: var(--serif); font-weight: 400; font-size: clamp(19px,2vw,24px); line-height: 1.2; color: var(--depth); transition: color .2s; }
  .faq-item > summary:hover span:first-child { color: var(--cherry); }
  .faq-ic { flex: none; width: 27px; height: 27px; border-radius: 50%; border: 1px solid var(--rule); display: flex; align-items: center; justify-content: center; font-size: 12px; color: var(--cherry); transition: transform .3s ease, background .25s, border-color .25s, color .25s; }
  .faq-item[open] .faq-ic { transform: rotate(180deg); background: var(--depth); border-color: var(--depth); color: #fff; }
  .faq-item[open] > summary span:first-child { color: var(--cherry); }
  .faq-a { padding: 0 4px 26px; max-width: 66ch; }
  .faq-item[open] .faq-a { animation: faqIn .3s ease; }
  @keyframes faqIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .faq-a p { font-size: 15px; line-height: 1.8; color: var(--ink); margin: 0 0 12px; }
  .faq-a p:last-child { margin-bottom: 0; }
  .faq-a ul { list-style: disc; padding-left: 22px; margin: 0 0 12px; }
  .faq-a li { font-size: 15px; line-height: 1.7; color: var(--ink); margin: 0 0 8px; }
  .faq-a a { color: var(--cherry); text-decoration: none; border-bottom: 1px solid rgba(139,26,26,.35); transition: border-color .2s; }
  .faq-a a:hover { border-color: var(--cherry); }
  .faq-none { text-align: center; color: var(--mid); font-size: 15px; padding: 44px 0; }
  .faq-none a { color: var(--cherry); }

  /* Help card */
  .faq-help { text-align: center; background: var(--cream); border-radius: 3px; padding: clamp(38px,4.5vw,60px); margin-top: clamp(36px,4vw,56px); }
  .faq-help__h { font-size: clamp(26px,3vw,38px); color: var(--depth); margin: 0 0 10px; }
  .faq-help__p { font-size: 14.5px; color: var(--mid); margin: 0 0 24px; }
  .faq-help__btn { display: inline-block; background: var(--depth); color: #fff; font-family: 'Jost', sans-serif; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; text-decoration: none; padding: 15px 34px; transition: background .25s; }
  .faq-help__btn:hover { background: var(--cherry); }

  @media (prefers-reduced-motion: reduce) { .faq-item[open] .faq-a { animation: none; } .faq-ic { transition: none; } }
</style>

<script is:inline>
  (function () {
    var search = document.getElementById('faqSearch');
    var chips = document.getElementById('faqChips');
    var items = Array.prototype.slice.call(document.querySelectorAll('#faqList > .faq-item'));
    var none = document.getElementById('faqNone');
    if (!chips) return;
    var cat = 'All';
    var q = '';

    function apply() {
      var shown = 0;
      items.forEach(function (el) {
        var okCat = cat === 'All' || el.getAttribute('data-cat') === cat;
        var okText = !q || (el.getAttribute('data-text') || '').indexOf(q) !== -1;
        var show = okCat && okText;
        el.hidden = !show;
        if (!show) el.open = false;
        if (show) shown++;
      });
      if (none) none.hidden = shown > 0;
    }

    chips.addEventListener('click', function (e) {
      var btn = e.target.closest('button'); if (!btn) return;
      chips.querySelectorAll('button').forEach(function (b) { b.classList.remove('on'); });
      btn.classList.add('on');
      cat = btn.getAttribute('data-cat');
      apply();
    });
    if (search) search.addEventListener('input', function () {
      q = (search.value || '').trim().toLowerCase();
      apply();
    });
  })();
</script>
