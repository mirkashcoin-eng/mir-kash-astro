---
import { TERMS } from './terms';
// Today view mount. Painted by the client modules (views.ts / people.ts / ops.ts); no data here.
---
<section class="ad-view" data-section="today" hidden aria-labelledby="viewTitle">
  <section class="ad-block" aria-labelledby="inboxH">
    <div class="ad-block__h"><h2 class="ad-h2" id="inboxH">Do today</h2><button type="button" class="ad-i" data-def={TERMS['Do today']} aria-label={'What this means: ' + TERMS['Do today']}>?</button><span class="ad-mut" id="inboxCount"></span></div>
    <div id="inboxBody"></div>
  </section>
  <section class="ad-block" aria-labelledby="todayKpiTitle">
    <div class="ad-titlerow"><h2 class="ad-h2" id="todayKpiTitle">The shop</h2><button type="button" class="ad-i" data-def={TERMS['The shop']} aria-label={'What this means: ' + TERMS['The shop']}>?</button></div>
    <div id="todayOverview" class="ad-stack-y"></div>
  </section>
</section>
