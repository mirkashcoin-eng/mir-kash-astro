---
// "Before you go": a quiet question for someone leaving a full cart, and an answer that helps.
// Never a discount. Shown on the back button (phones), the mouse heading for the tab bar
// (desktop), or a long pause on the cart, every time someone visits the cart and is about to
// leave (once per page view, never twice in a row). Same visual language as ViewingPrompt.
import { shopifyImage } from '~/lib/shopifyImage';
import { trustLine, deliveryLines } from '~/lib/product-page';
import { MAX_BAGS } from '~/lib/cart-exit';

interface Line { id: string; handle: string; title: string; image?: string | null }
interface Props { lines: Line[]; checkoutHref: string }

const { lines, checkoutHref } = Astro.props;
const { market, marketConfig } = Astro.locals;
const prefix = marketConfig.urlPrefix;
const isIndia = marketConfig.countryCode === 'IN';

const thumbs = lines.slice(0, 3).map((l) => ({ src: l.image ? shopifyImage(l.image, 160) : '', alt: l.title }));
const more = Math.max(0, lines.length - thumbs.length);
const one = lines.length === 1;

// The safety net around the price: the same lines the product page shows, plus warranty and COD.
// The warranty covers handbags only (charms and other accessories have none), so it says so.
const trust = trustLine(marketConfig, { warranty: false });
const reassure = [
  ...trust,
  '1-year warranty on all handbags',
  ...(isIndia ? ['Cash on Delivery available'] : []),
  deliveryLines(marketConfig).arrives,
];

const it = one ? 'it' : 'them';
const offers = {
  tryhome: {
    eyebrow: 'Mumbai · Try at Home',
    body: `We'll bring ${one ? 'the piece' : 'the pieces'} in your bag to your door, so you can try ${it} in your own light. Complimentary, with no pressure to buy.`,
    cta: 'Book a Try at Home',
    href: '/try-at-home',
  },
  viewing: {
    eyebrow: 'Private Viewing',
    body: `A client advisor will show you ${one ? 'the piece' : 'the pieces'} in your bag over live video: the size in the hand, the true colour, the detail. Complimentary, 15 to 30 minutes.`,
    cta: 'Book a Private Viewing',
    href: `${prefix}/private-viewing`,
  },
};
const data = {
  lines: lines.map((l) => ({ id: l.id, handle: l.handle })),
  offers,
  maxBags: MAX_BAGS,
  isIndia,
  store: market,
};
---
<div class="cx" id="cx" hidden>
  <div class="cx__scrim" data-cx-close></div>
  <div class="cx__card" role="dialog" aria-modal="true" aria-labelledby="cxTitle" tabindex="-1">
    <button class="cx__close" type="button" data-cx-close aria-label="Close">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1" fill="none" /></svg>
    </button>

    {thumbs.length > 0 && (
      <div class="cx__bag" aria-hidden="true">
        {thumbs.map((t) => <span class="cx__thumb">{t.src && <img src={t.src} alt="" loading="lazy" decoding="async" />}</span>)}
        {more > 0 && <span class="cx__thumb cx__thumb--more">+{more}</span>}
      </div>
    )}

    <!-- Step 1: the question -->
    <section class="cx__step is-current" data-step="ask">
      <p class="cx__eye">Your bag</p>
      <h2 class="cx__h" id="cxTitle">Before you go.</h2>
      <span class="cx__rule" aria-hidden="true"></span>
      <p class="cx__p">Is anything holding you back?</p>
      <div class="cx__choices">
        <button type="button" class="cx__choice" data-reason="seeit">I'd like to see {it} in person first<span aria-hidden="true">&rarr;</span></button>
        <button type="button" class="cx__choice" data-reason="size">I'm not sure about the size or colour<span aria-hidden="true">&rarr;</span></button>
        <button type="button" class="cx__choice" data-reason="price">It's more than I planned to spend<span aria-hidden="true">&rarr;</span></button>
        <button type="button" class="cx__choice" data-reason="looking">I'm just looking for now<span aria-hidden="true">&rarr;</span></button>
      </div>
      <button type="button" class="cx__later" data-cx-close>Not now</button>
    </section>

    <!-- Step 2a: see it first / size or colour -->
    <section class="cx__step" data-step="book" hidden>
      <p class="cx__eye" data-offer="eyebrow"></p>
      <h2 class="cx__h" data-book-h>See {it} before you decide.</h2>
      <span class="cx__rule" aria-hidden="true"></span>
      <p class="cx__p" data-offer="body"></p>
      <a class="cx__cta" data-cx-book href={offers.viewing.href}><span data-offer="cta"></span><span class="cx__ar" aria-hidden="true">&rarr;</span></a>
      <button type="button" class="cx__later" data-cx-back>Back</button>
    </section>

    <!-- Step 2b: price -->
    <section class="cx__step" data-step="price" hidden>
      <p class="cx__eye">What you're paying for</p>
      <h2 class="cx__h">Made slowly, made to last.</h2>
      <span class="cx__rule" aria-hidden="true"></span>
      <p class="cx__p">Every piece is handmade and finished to be carried for years, not a season. And if it isn't right, you're covered.</p>
      <ul class="cx__list">
        {reassure.map((r) => <li>{r}</li>)}
      </ul>
      <button type="button" class="cx__cta" data-cx-close><span>Return to my bag</span><span class="cx__ar" aria-hidden="true">&rarr;</span></button>
      <a class="cx__later" data-cx-checkout href={checkoutHref}>Continue to checkout</a>
    </section>

    <!-- Step 2c: just looking -->
    <section class="cx__step" data-step="save" hidden>
      <p class="cx__eye">Just looking</p>
      <h2 class="cx__h">We'll keep your bag for you.</h2>
      <span class="cx__rule" aria-hidden="true"></span>
      <p class="cx__p">Leave your WhatsApp number and we'll hold on to your selection. We'll only message you about this bag.</p>
      <form class="cx__form" data-cx-form novalidate>
        <label class="cx__field">
          <span class="cx__sr">WhatsApp number</span>
          {isIndia && <span class="cx__cc" aria-hidden="true">+91</span>}
          <input class="cx__input" name="phone" type="tel" inputmode="tel" autocomplete="tel"
            placeholder={isIndia ? '10-digit mobile number' : 'Number with country code'} maxlength={isIndia ? 14 : 20} />
        </label>
        <p class="cx__err" data-cx-err hidden></p>
        <button type="submit" class="cx__cta"><span>Keep my bag</span><span class="cx__ar" aria-hidden="true">&rarr;</span></button>
      </form>
      <button type="button" class="cx__later" data-cx-back>Back</button>
    </section>

    <!-- Step 3: thank you -->
    <section class="cx__step" data-step="thanks" hidden>
      <p class="cx__eye">Set aside</p>
      <h2 class="cx__h">Thank you.</h2>
      <span class="cx__rule" aria-hidden="true"></span>
      <p class="cx__p">Your bag is set aside. Someone from our team will be in touch on WhatsApp.</p>
      <button type="button" class="cx__cta" data-cx-close><span>Continue browsing</span><span class="cx__ar" aria-hidden="true">&rarr;</span></button>
    </section>
  </div>
</div>
<script type="application/json" id="cxData" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />

<script>
  import {
    CX_LINGER_MS, CX_EXIT_MIN_MS,
  } from '~/lib/cart-exit';
  import { createDialog } from '~/lib/dialog';

  type Offer = 'tryhome' | 'viewing';
  type Data = {
    lines: { id: string; handle: string }[];
    offers: Record<Offer, { eyebrow: string; body: string; cta: string; href: string }>;
    maxBags: number;
    isIndia: boolean;
    store: string;
  };

  const EXIT_MS = 600; // keep in step with the exit transitions in the <style> below
  const STEP_MS = 280; // crossfade between steps

  const root = document.getElementById('cx');
  if (root) init(root);

  function init(root: HTMLElement) {
    const data = JSON.parse(document.getElementById('cxData')?.textContent || '{}') as Data;
    const card = root.querySelector<HTMLElement>('.cx__card')!;
    // Dev only: ?cx=1 (or a step name) opens the panel at once; ?cx=live keeps the real triggers,
    // with the sample bags CartPage renders, so the back-button behaviour can be tried locally.
    const cxParam = import.meta.env.DEV ? new URLSearchParams(location.search).get('cx') : null;
    const devLive = cxParam === 'live';
    const force = cxParam !== null && !devLive;

    // Shown every time someone is about to leave a full cart: once per visit to the cart page (the
    // `shown` flag below), with no cross-visit memory. Within one page view it never repeats, so a
    // second back press always leaves.
    const allowed = () => true;

    const dialog = createDialog(root, card, EXIT_MS);

    // Mumbai → Try at Home; everyone else (or no answer in time) → Private Viewing.
    const offerReady: Promise<Offer> = Promise.race([
      (window.mkGeo ?? Promise.resolve(null)).then((g) => (g?.mumbai ? 'tryhome' : 'viewing') as Offer).catch(() => 'viewing' as Offer),
      new Promise<Offer>((r) => setTimeout(() => r('viewing'), 2500)),
    ]);
    let offer: Offer = 'viewing';
    offerReady.then((o) => { offer = o; });

    const track = (event: string) => { if (!force) window.mkTrack?.(event, { offer }); };

    // Bags still in the cart (the visitor may have removed some since the page loaded).
    const currentHandles = () => data.lines
      .filter((l) => document.querySelector(`.c-item[data-line-id="${CSS.escape(l.id)}"]`))
      .map((l) => l.handle);
    const cartHasItems = () => force || devLive || currentHandles().length > 0;

    // ── Steps ──
    let answered = false;
    function go(step: string) {
      const cur = root.querySelector<HTMLElement>('.cx__step.is-current');
      const next = root.querySelector<HTMLElement>(`.cx__step[data-step="${step}"]`);
      if (!next || cur === next) return;
      cur?.classList.add('is-leaving');
      setTimeout(() => {
        cur?.classList.remove('is-current', 'is-leaving');
        if (cur) cur.hidden = true;
        next.hidden = false;
        void next.offsetWidth;
        next.classList.add('is-current');
        next.querySelector<HTMLElement>('.cx__h')?.setAttribute('id', 'cxTitle');
        if (cur && cur !== next) cur.querySelector('.cx__h')?.removeAttribute('id');
        card.scrollTop = 0;
        card.focus({ preventScroll: true }); // the dialog itself: no stray focus ring, no phone keyboard
      }, STEP_MS);
    }

    function fillOffer() {
      const o = data.offers[offer];
      root.querySelectorAll<HTMLElement>('[data-offer]').forEach((n) => { n.textContent = o[n.dataset.offer as keyof typeof o] ?? ''; });
      const bags = currentHandles().slice(0, data.maxBags);
      const a = root.querySelector<HTMLAnchorElement>('[data-cx-book]')!;
      a.href = o.href + (bags.length ? `?bags=${bags.map(encodeURIComponent).join(',')}` : '');
    }

    root.querySelectorAll<HTMLButtonElement>('[data-reason]').forEach((b) => b.addEventListener('click', () => {
      const reason = b.dataset.reason!;
      answered = true;
      track(`cx_reason_${reason}`);
      if (reason === 'seeit' || reason === 'size') {
        fillOffer();
        const h = root.querySelector<HTMLElement>('[data-book-h]');
        if (h && reason === 'size') h.textContent = 'Find the one that feels right.';
        go('book');
      } else if (reason === 'price') go('price');
      else go('save');
    }));
    root.querySelectorAll('[data-cx-back]').forEach((b) => b.addEventListener('click', () => go('ask')));
    root.querySelector('[data-cx-book]')?.addEventListener('click', () => track('cx_book_click'));
    root.querySelector('[data-cx-checkout]')?.addEventListener('click', () => track('cx_checkout_click'));

    // ── Keep my bag ──
    const form = root.querySelector<HTMLFormElement>('[data-cx-form]');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[name="phone"]')!;
      const err = root.querySelector<HTMLElement>('[data-cx-err]')!;
      const digits = input.value.replace(/\D/g, '');
      let phone = '';
      if (data.isIndia) {
        const ten = digits.length === 12 && digits.startsWith('91') ? digits.slice(2) : digits;
        if (/^[6-9]\d{9}$/.test(ten)) phone = '+91' + ten;
      } else if (digits.length >= 7 && digits.length <= 15) phone = '+' + digits;
      if (!phone) {
        err.textContent = data.isIndia ? 'Please enter a 10-digit mobile number.' : 'Please enter your number with its country code.';
        err.hidden = false;
        input.focus();
        return;
      }
      err.hidden = true;
      // What's in the bag right now, so the team sees it on the lead in admin People.
      let cart: unknown;
      try {
        const res = await fetch(`/api/cart?store=${encodeURIComponent(data.store)}`, { headers: { Accept: 'application/json' } });
        if (res.ok) { const c = await res.json(); if (c?.lines?.length) cart = window.cartSnapshot?.(c); }
      } catch { /* the number alone is still worth saving */ }
      if (!force) window.mkLead?.({ event: 'phone', phone, ...(cart ? { cart: cart as never } : {}) });
      track('cx_saved');
      go('thanks');
    });

    // ── Show / close ──
    const stops: Array<() => void> = []; // trigger cleanups, run once the panel shows
    function stopTriggers() { stops.forEach((s) => s()); stops.length = 0; }
    let shown = false;
    function show() {
      if (shown || !cartHasItems()) return;
      shown = true;
      stopTriggers();
      offerReady.then(() => {
        dialog.open();
        track('cx_shown');
      });
    }
    function close() {
      if (!dialog.isOpen) return;
      if (!answered) {
        track('cx_dismiss');
      }
      dialog.close();
    }
    root.querySelectorAll('[data-cx-close]').forEach((b) => b.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    if (force) {
      show();
      // Dev preview of a later step: ?cx=book | price | save | thanks.
      const step = new URLSearchParams(location.search).get('cx');
      if (step && step !== '1') setTimeout(() => { if (step === 'book') fillOffer(); go(step); }, 1800);
      return;
    }

    // ── Triggers ──

    // Phones (and anyone): the back button. One extra history entry, added only after the first
    // tap or keypress (Chrome skips entries added without a user gesture). Pressing back pops it:
    // we show the panel instead of leaving, and their next back press leaves normally. Never a loop.
    let armed = history.state?.mkCx === 1; // a bfcache/reload restore may already sit on our entry
    let leavingTo = '';
    const arm = () => {
      if (armed || shown || !allowed() || !cartHasItems()) return;
      history.pushState({ ...(history.state || {}), mkCx: 1 }, '', location.href);
      armed = true;
    };
    document.addEventListener('pointerdown', arm, { once: true, capture: true });
    document.addEventListener('keydown', arm, { once: true, capture: true });

    window.addEventListener('popstate', () => {
      if (!armed) return;
      armed = false;
      if (leavingTo) { location.href = leavingTo; return; } // finishing a forward navigation, see below
      if (!shown && allowed() && cartHasItems()) show();
      else history.back(); // the panel's already had its moment: let them leave as they meant to
    });

    // Following a link while our extra entry is in place would leave it stranded in history
    // (one more back press later). Pop it first, then navigate.
    document.addEventListener('click', (e) => {
      if (!armed || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
      if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;
      const href = a.href;
      if (!/^https?:/i.test(href) || href.split('#')[0] === location.href.split('#')[0]) return;
      e.preventDefault();
      leavingTo = href;
      history.back();
    });

    // Desktop: heading for the tab bar after a moment on the page.
    if (matchMedia('(pointer: fine)').matches) {
      const onLeave = (e: MouseEvent) => {
        if (!e.relatedTarget && e.clientY <= 0 && performance.now() >= CX_EXIT_MIN_MS) show();
      };
      document.addEventListener('mouseout', onLeave);
      stops.push(() => document.removeEventListener('mouseout', onLeave));
    } else {
      // Phones: a long pause on the cart without checking out.
      let visibleMs = 0;
      let last = performance.now();
      const timer = window.setInterval(() => {
        const now = performance.now();
        if (document.visibilityState === 'visible') visibleMs += now - last;
        last = now;
        if (visibleMs >= CX_LINGER_MS) show();
      }, 1000);
      stops.push(() => clearInterval(timer));
    }

    // Back from the bfcache: never leave the page locked behind an open panel.
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      leavingTo = '';
      armed = history.state?.mkCx === 1;
      if (dialog.isOpen) dialog.close();
    });
  }
</script>

<style>
  .cx {
    --cx-paper: #FAF7F2;   /* Parchment */
    --cx-ink: #2C1A0E;     /* Deep Fig */
    --cx-accent: #8B1A1A;  /* Cherry */
    --cx-rule: rgba(44, 26, 14, .12);
    --cx-ease: cubic-bezier(.16, 1, .3, 1);
    --cx-fade: cubic-bezier(.4, 0, .2, 1);
    --cx-exit: cubic-bezier(.4, 0, 1, 1);
    position: fixed; inset: 0; z-index: 1000;
    display: grid; place-items: center;
    padding: 32px;
    font-family: var(--font, 'Brooklyn', -apple-system, 'Helvetica Neue', sans-serif);
    color: var(--cx-ink);
  }
  .cx[hidden] { display: none; }

  .cx__scrim {
    position: absolute; inset: 0;
    background: rgba(44, 26, 14, .56);
    -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);
    opacity: 0; transition: opacity .5s var(--cx-exit);
  }
  .cx.is-in .cx__scrim { opacity: 1; transition: opacity 1.1s var(--cx-fade); }

  .cx__card {
    position: relative;
    width: min(560px, 100%);
    max-height: 100%;
    overflow-y: auto;
    padding: 52px 56px 40px;
    background: var(--cx-paper);
    box-shadow: 0 50px 100px -40px rgba(20, 10, 4, .6);
    outline: none;
    opacity: 0; transform: translateY(26px) scale(.985);
    will-change: opacity, transform;
    transition: opacity .4s var(--cx-exit), transform .5s var(--cx-exit);
  }
  .cx.is-in .cx__card { opacity: 1; transform: none; transition: opacity 1.1s var(--cx-fade) .2s, transform 1.5s var(--cx-ease) .2s; }

  .cx__close {
    position: absolute; top: 14px; right: 14px; z-index: 2;
    width: 38px; height: 38px; display: grid; place-items: center;
    background: none; border: 0; padding: 0; cursor: pointer;
    color: rgba(44, 26, 14, .6);
    opacity: 0;
    transition: opacity .3s var(--cx-exit), color .2s, transform .4s var(--cx-ease);
  }
  .cx.is-in .cx__close { opacity: 1; transition: opacity .9s var(--cx-fade) 1.2s, color .2s, transform .4s var(--cx-ease); }
  .cx__close:hover { color: var(--cx-ink); transform: rotate(90deg); }

  /* The bag itself, quietly at the top. */
  .cx__bag { display: flex; gap: 8px; margin-bottom: 28px; opacity: 0; transform: translateY(10px); transition: opacity .3s var(--cx-exit), transform .3s var(--cx-exit); }
  .cx.is-in .cx__bag { opacity: 1; transform: none; transition: opacity 1s var(--cx-fade) .5s, transform 1.3s var(--cx-ease) .5s; }
  .cx__thumb { width: 52px; height: 65px; background: #efe7da; overflow: hidden; display: grid; place-items: center; }
  .cx__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .cx__thumb--more { font-size: 11px; letter-spacing: .08em; color: rgba(44, 26, 14, .6); background: transparent; border: 1px solid var(--cx-rule); }

  /* Entrance choreography for the first step; later steps crossfade (below). */
  .cx__step { display: flex; flex-direction: column; }
  .cx__step[hidden] { display: none; } /* the display above would otherwise override [hidden] */
  .cx__step > * { opacity: 0; transform: translateY(14px); }
  .cx__step .cx__rule { transform: scaleX(0); transform-origin: left center; }
  .cx.is-in .cx__step.is-current > * { opacity: 1; transform: none; }
  .cx__step > :nth-child(1) { --d: .65s; }
  .cx__step > :nth-child(2) { --d: .8s; }
  .cx__step > :nth-child(3) { --d: 1s; }
  .cx__step > :nth-child(4) { --d: 1.1s; }
  .cx__step > :nth-child(5) { --d: 1.25s; }
  .cx__step > :nth-child(6) { --d: 1.4s; }
  .cx__step > :nth-child(7) { --d: 1.5s; }
  .cx__step > * { transition: opacity .3s var(--cx-exit), transform .3s var(--cx-exit); }
  .cx.is-in .cx__step.is-current > * { transition: opacity 1s var(--cx-fade) var(--d), transform 1.3s var(--cx-ease) var(--d); }
  /* After the first step, moving between steps is quicker: a soft crossfade with a short stagger. */
  .cx.is-in .cx__step.is-current:not([data-step="ask"]) > * { transition: opacity .7s var(--cx-fade) calc(var(--d) * .25), transform .9s var(--cx-ease) calc(var(--d) * .25); }
  .cx.is-in .cx__step.is-leaving > * { opacity: 0; transform: translateY(-8px); transition: opacity .25s var(--cx-exit), transform .25s var(--cx-exit); }

  .cx__eye { margin: 0 0 16px; font-size: 10.5px; font-weight: 500; letter-spacing: .26em; text-transform: uppercase; color: rgba(44, 26, 14, .6); }
  .cx__h { margin: 0; font-family: 'DM Serif Display', Georgia, serif; /* not var(--serif): the cart page maps it to Brooklyn */ font-weight: 400; font-size: 34px; line-height: 1.12; letter-spacing: -.005em; color: var(--cx-ink); }
  .cx__rule { display: block; width: 32px; height: 1px; margin: 22px 0 18px; background: var(--cx-accent); }
  .cx__p { margin: 0 0 26px; font-size: 14.5px; font-weight: 300; line-height: 1.7; color: rgba(44, 26, 14, .82); }

  .cx__choices { display: flex; flex-direction: column; border-top: 1px solid var(--cx-rule); }
  .cx__choice {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    width: 100%; padding: 17px 2px; text-align: left;
    background: none; border: 0; border-bottom: 1px solid var(--cx-rule); cursor: pointer;
    font: inherit; font-size: 14.5px; font-weight: 400; color: var(--cx-ink);
    transition: color .25s, padding .35s var(--cx-ease);
  }
  .cx__choice span { color: rgba(44, 26, 14, .4); transition: transform .35s var(--cx-ease), color .25s; }
  .cx__choice:hover, .cx__choice:focus-visible { color: var(--cx-accent); padding-left: 8px; }
  .cx__choice:hover span, .cx__choice:focus-visible span { color: var(--cx-accent); transform: translateX(4px); }

  .cx__list { list-style: none; margin: 0 0 28px; padding: 0; border-top: 1px solid var(--cx-rule); }
  .cx__list li { padding: 12px 0 12px 22px; border-bottom: 1px solid var(--cx-rule); font-size: 13.5px; line-height: 1.5; color: rgba(44, 26, 14, .85); position: relative; }
  .cx__list li::before { content: ''; position: absolute; left: 2px; top: 50%; width: 9px; height: 5px; border-left: 1px solid var(--cx-accent); border-bottom: 1px solid var(--cx-accent); transform: translateY(-70%) rotate(-45deg); }

  .cx__cta {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    width: 100%; padding: 18px 22px; border: 0; cursor: pointer;
    background: var(--cx-ink); color: var(--cx-paper);
    font: inherit; font-size: 11.5px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase;
    white-space: nowrap; text-decoration: none;
  }
