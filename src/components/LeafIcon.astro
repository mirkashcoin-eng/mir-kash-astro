---
// The quiet "vegan" mark: a small Forest Green leaf (#3D6B4F, Brand Guidelines: kindness, materials).
// Used next to the material name only — material dropdown, cart and checkout lines. Never as a badge.
interface Props { size?: number }
const { size = 13 } = Astro.props;
---
<svg class="leaf-icon" viewBox="0 0 24 24" width={size} height={size} role="img" aria-label="Vegan"><title>Vegan</title><path fill="currentColor" d="M20.5 3.5C11 3.5 4.5 8.6 4.5 16.4c0 1.3.2 2.5.5 3.6 1.3-4 5.1-8 10.4-10.3-4.2 3-7 6.5-8.3 10.6 9.4.3 13.4-6.4 13.4-16.8z"/></svg>

<style>
  .leaf-icon { color: #3D6B4F; flex-shrink: 0; }
</style>
