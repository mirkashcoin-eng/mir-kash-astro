---
import BrandTicker from './BrandTicker.astro';
import SiteHeader from './SiteHeader.astro';
import NavDrawer from './NavDrawer.astro';
import SiteFooter from './SiteFooter.astro';
import { getProductsByCollection, getAllProducts } from '~/lib/shopify/queries';
import { shopifyImage } from '~/lib/shopifyImage';
import { formatMoney, absoluteUrl } from '~/lib/markets';
import { getCategory, listCategories } from '~/lib/categories';
import type { Product } from '~/types/shopify';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const cat = getCategory(slug)!;
const { market, marketConfig } = Astro.locals;
const country = marketConfig.countryCode;
const prefix = marketConfig.urlPrefix;
const homeHref = prefix || '/';
const shopHref = `${prefix}/shop`;

// The collection is the merchandiser's hand-ordered list, so it goes first; the
// productType match then picks up anything it missed (and carries Totes, which
// has no collection at all). See src/lib/categories.ts.
const [curated, all] = await Promise.all([
  cat.collection
    ? getProductsByCollection(market, country, cat.collection, 60)
    : Promise.resolve([] as Product[]),
  getAllProducts(market, country, 100),
]);

const seen = new Set<string>();
const inCategory: Product[] = [];
for (const p of [...curated, ...all.filter((p) => cat.match.test(p.productType || ''))]) {
  if (seen.has(p.id)) continue;
  seen.add(p.id);
  inCategory.push(p);
}
const others = all.filter((p) => !seen.has(p.id));

const count = inCategory.length;

function view(p: Product) {
  const alt =
    p.images?.edges?.find((e) => e.node.url !== p.featuredImage?.url)?.node ??
    p.images?.edges?.[1]?.node ??
    null;
  return {
    handle: p.handle,
    name: p.title.toUpperCase(),
    price: formatMoney(p.priceRange.minVariantPrice, marketConfig.locale),
    variantId: p.variants?.edges?.[0]?.node.id ?? '',
    type: p.productType || '',
    badge: p.tags.includes('best-seller')
      ? 'Best Seller'
      : p.tags.includes('new')
      ? 'New'
      : p.tags.includes('selling-fast')
      ? 'Selling Fast'
      : null,
    image: p.featuredImage ? shopifyImage(p.featuredImage.url, 600) : null,
    imageAlt: p.featuredImage?.altText ?? p.title,
    hoverImage: alt ? shopifyImage(alt.url, 600) : null,
  };
}

const cards = inCategory.map(view);
const otherCards = others.map(view);

// A thin category would otherwise leave a half-empty last row. One bridge card
// absorbs exactly the slots left over at each breakpoint — `cols - (n % cols)`,
// falling back to a full row when the products divide evenly.
const span = (cols: number) => (count % cols === 0 ? cols : cols - (count % cols));
const bridgeCat = getCategory(cat.bridge.slug);
const bridgeProduct = bridgeCat
  ? others.find((p) => bridgeCat.match.test(p.productType || '')) ?? others[0] ?? null
  : null;
// Also covers count === 0 (a category emptied out, or Shopify unreachable): the
// page still hands the visitor somewhere to go instead of dead-ending.
const showBridge = count < 4 && bridgeProduct !== null;
const bridgeImage = bridgeProduct?.featuredImage
  ? shopifyImage(bridgeProduct.featuredImage.url, 600)
  : null;
const bridgeWide = showBridge && span(4) >= 2;
const bridgeHref = `${prefix}/shop/${cat.bridge.slug}`;

const canonical = absoluteUrl(`${prefix}/shop/${cat.slug}`);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl(homeHref) },
      { '@type': 'ListItem', position: 2, name: 'Shop All', item: absoluteUrl(shopHref) },
      { '@type': 'ListItem', position: 3, name: cat.title, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: cat.title,
    description: cat.seoDescription,
    url: canonical,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: count,
      itemListElement: inCategory.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: absoluteUrl(`${prefix}/products/${p.handle}`),
        name: p.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cat.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BrandTicker />
<SiteHeader />
<NavDrawer />

<main>

  <nav class="shop-crumb" aria-label="Breadcrumb">
    <p class="shop-crumb__inner">
      <a href={homeHref}>Home</a><span class="sep">/</span><a href={shopHref}>Shop</a><span class="sep">/</span>{cat.title}
    </p>
  </nav>

  <section class="cat-head">
    <div>
      <h1 class="cat-head__h1">{cat.h1[0]}<br />{cat.h1[1]}<span class="cat-head__dot">.</span></h1>
      <p class="cat-head__sub">{cat.sub}</p>
    </div>
    <p class="cat-head__count">
      <strong>{count}</strong> {count === 1 ? 'Style' : 'Styles'}
    </p>
  </section>

  <nav class="cat-rail" aria-label="Bag categories">
    <div class="cat-rail__list">
      {listCategories().map((c) => (
        <a
          class:list={['cat-rail__link', { 'is-active': c.slug === cat.slug }]}
          href={`${prefix}/shop/${c.slug}`}
          aria-current={c.slug === cat.slug ? 'page' : undefined}
        >{c.short}</a>
      ))}
    </div>
    <a class="cat-rail__all" href={shopHref}>Shop all {all.length} &rarr;</a>
  </nav>

  {(count > 0 || showBridge) && (
    <section class="shop-grid" style={`--br2:${span(2)};--br3:${span(3)};--br4:${span(4)}`}>
      {cards.map((p) => (
        <a class="shop-card" href={`${prefix}/products/${p.handle}`}>
          <div class="shop-card__img-wrap">
            {p.image ? (
              <img class="shop-card__img shop-card__img--primary" src={p.image} alt={p.imageAlt} loading="lazy" />
            ) : (
              <div class="shop-card__img shop-card__img--primary shop-card__img--empty">
                <span class="shop-card__placeholder-mono">{p.name.toLowerCase()}</span>
              </div>
            )}
            {p.hoverImage && (
              <img class="shop-card__img shop-card__img--alt" src={p.hoverImage} alt="" loading="lazy" aria-hidden="true" />
            )}
            {p.badge && (
              <span class:list={['shop-card__badge', { 'shop-card__badge--new': p.badge === 'New' }]}>{p.badge}</span>
            )}
            <button class="shop-card__wish" data-handle={p.handle} aria-label={`Save ${p.name}`} type="button">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
            <button
              class="shop-card__quick-add"
              type="button"
              data-variant={p.variantId}
              data-handle={p.handle}
              data-name={p.name}
              aria-label={`Add ${p.name} to bag`}
            >Add to bag</button>
          </div>
          <div class="shop-card__meta">
            <p class="shop-card__name">{p.name}</p>
            <p class="shop-card__price">{p.price}</p>
          </div>
        </a>
      ))}

      {showBridge && (
        <a class="cat-bridge" href={bridgeHref} data-wide={bridgeWide ? '1' : null}>
          {bridgeImage && (
            <div class="cat-bridge__img">
              <img src={bridgeImage} alt="" loading="lazy" aria-hidden="true" />
            </div>
          )}
          <div class="cat-bridge__text">
            <p class="cat-bridge__eyebrow">Nearest shape</p>
            <p class="cat-bridge__h">{cat.bridge.heading}</p>
            <p class="cat-bridge__p">{cat.bridge.text}</p>
            <span class="cat-bridge__cta">Shop {bridgeCat?.title.toLowerCase() ?? 'more'} &rarr;</span>
          </div>
        </a>
      )}
    </section>
  )}

  <section class="cat-band">
    <div class="cat-band__text">
      <p class="cat-band__eyebrow">{cat.eyebrow}</p>
      <h2 class="cat-band__h">{cat.headline[0]}<br />{cat.headline[1]}</h2>
      <div class="cat-band__notes">
        {cat.notes.map((n, i) => (
          <div class="cat-note">
            <span class="cat-note__num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <p class="cat-note__label">{n.label}</p>
              <p class="cat-note__text">{n.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {otherCards.length > 0 && (
    <>
      <section class="cat-more">
        <div class="cat-more__head">
          <h2 class="cat-more__title">More from <em>Mir Kash</em></h2>
          <a class="cat-more__hint" href={shopHref}>View all {all.length} &rarr;</a>
        </div>
      </section>

      <section class="shop-grid shop-grid--more">
        {otherCards.map((p) => (
          <a class="shop-card" href={`${prefix}/products/${p.handle}`}>
            <div class="shop-card__img-wrap">
              {p.image ? (
                <img class="shop-card__img shop-card__img--primary" src={p.image} alt={p.imageAlt} loading="lazy" />
              ) : (
                <div class="shop-card__img shop-card__img--primary shop-card__img--empty">
                  <span class="shop-card__placeholder-mono">{p.name.toLowerCase()}</span>
                </div>
              )}
              {p.hoverImage && (
                <img class="shop-card__img shop-card__img--alt" src={p.hoverImage} alt="" loading="lazy" aria-hidden="true" />
              )}
              <button class="shop-card__wish" data-handle={p.handle} aria-label={`Save ${p.name}`} type="button">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>
              <button
                class="shop-card__quick-add"
                type="button"
                data-variant={p.variantId}
                data-handle={p.handle}
                data-name={p.name}
                aria-label={`Add ${p.name} to bag`}
              >Add to bag</button>
            </div>
            <div class="shop-card__meta">
              {p.type && <p class="shop-card__eyebrow">{p.type}</p>}
              <p class="shop-card__name">{p.name}</p>
              <p class="shop-card__price">{p.price}</p>
            </div>
          </a>
        ))}
      </section>
    </>
  )}

  <section class="cat-faq">
    <div>
      <p class="cat-faq__eyebrow">Good to know</p>
      <h2 class="cat-faq__h">{cat.title},<br />answered.</h2>
    </div>
    <div class="cat-faq__list">
      {cat.faqs.map((f) => (
        <div class="cat-faq__row">
          <p class="cat-faq__q">{f.q}</p>
          <p class="cat-faq__a">{f.a}</p>
        </div>
      ))}
    </div>
  </section>

</main>

<SiteFooter />

{jsonLd.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}

<script define:vars={{ marketPrefix: prefix, store: market, countryCode: country }}>
  // Favorites + quick-add on the server-rendered cards. Same storage key and
  // endpoints as the Shop All grid, so a saved bag stays saved across both.
  const FAV_KEY = 'mk_favorites';
  const getFavs = () => { try { return JSON.parse(localStorage.getItem(FAV_KEY) || '[]'); } catch { return []; } };

  let favToastTimer;
  function favToast(msg) {
    let t = document.getElementById('favToast');
    if (!t) { t = document.createElement('div'); t.id = 'favToast'; t.className = 'fav-toast'; document.body.appendChild(t); }
    t.textContent = msg;
    t.classList.add('is-shown');
    clearTimeout(favToastTimer);
    favToastTimer = setTimeout(() => t.classList.remove('is-shown'), 1800);
  }

  const favs = getFavs();
  document.querySelectorAll('.shop-card__wish').forEach((btn) => {
    if (favs.includes(btn.dataset.handle)) btn.classList.add('is-saved');
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const list = getFavs();
      const i = list.indexOf(btn.dataset.handle);
      const added = i < 0;
      if (added) list.push(btn.dataset.handle); else list.splice(i, 1);
      localStorage.setItem(FAV_KEY, JSON.stringify(list));
      btn.classList.toggle('is-saved', added);
      favToast(added ? 'Added to favorites' : 'Removed from favorites');
    });
  });

  document.querySelectorAll('.shop-card__quick-add').forEach((qa) => {
    qa.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (qa.dataset.busy === '1') return;
      const handle = qa.dataset.handle;
      const name = qa.dataset.name;
      // No variant id — send them to the product page to pick one.
      if (!qa.dataset.variant) { window.location.href = `${marketPrefix}/products/${handle}`; return; }
      const original = qa.dataset.label || qa.textContent;
      qa.dataset.label = original;
      qa.dataset.busy = '1';
      qa.textContent = 'Adding…';
      try {
        const res = await fetch('/api/cart/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ merchandiseId: qa.dataset.variant, quantity: 1, store, countryCode }),
        });
        if (!res.ok) throw new Error('add failed');
        const cart = await res.json();
        if (window.mkTrack) window.mkTrack('add_to_cart', { product: name });
        if (window.mkLead) window.mkLead({ event: 'add_to_cart', item: name, cart: window.cartSnapshot && window.cartSnapshot(cart) });
        document.querySelectorAll('.hdr-bag__count, .bag-count').forEach((el) => { el.textContent = String(cart.totalQuantity ?? 0); });
        qa.classList.add('is-added');
        qa.textContent = 'Added ✓';
        setTimeout(() => { qa.textContent = original; qa.classList.remove('is-added'); qa.dataset.busy = ''; }, 1500);
      } catch {
        qa.textContent = original;
        qa.dataset.busy = '';
        window.location.href = `${marketPrefix}/products/${handle}`;
      }
    });
  });
</script>

<style is:global>
  /* ══════════════════════════════════════
     Shared shop chrome — ticker, header, drawer, cards.
     Same values as ShopAll.astro; this page renders its grid on the
     server rather than in JS, so it carries its own copy of the skin.
     ══════════════════════════════════════ */
  /* ══════════════════════════════════════
     SHOP V2 — brand-aligned redesign
     Cherry-red signature · serif/sans pair · Orchardcraft story
     ══════════════════════════════════════ */

  :root {
    --serif:        'Jost', -apple-system, 'Helvetica Neue', sans-serif;
    --cherry:       #8B1A1A;
    --plum:         #5C2D3E;
    --earth:        #C8895A;
    --tan:          #D4B896;
    --depth:        #2C1A0E;

    --paper:        #ffffff;
    --white:        #ffffff;
  }

  body { background: var(--paper); }

  :root { --ticker-h: 32px; }
  body { padding-top: var(--ticker-h); }
  .page-header.hdr--solid { top: var(--ticker-h); }

  :root { --hdr-h: 64px; }

  .site-header--minimal { border-bottom: 1px solid var(--rule); }
  .site-header--minimal .hdr-wrap {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--hdr-h);
    padding: 0 var(--gutter);
    gap: 24px;
  }
  .site-header--minimal .hdr-right {
    display: flex;
    justify-self: end;
    grid-column: 3;
    align-items: center;
    gap: 14px;
  }
  .site-header--minimal .logo {
    justify-self: center;
    grid-column: 2;
  }
  .site-header--minimal .logo img { height: 22px; }

  .hdr-menu-btn {
    display: none; /* desktop: tabs row replaces the hamburger; shown on mobile */
    align-items: center;
    gap: 12px;
    justify-self: start;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 0;
    color: var(--depth);
    font-family: inherit;
    font-size: 11px;
    letter-spacing: var(--tr-caps);
    text-transform: uppercase;
    font-weight: 500;
  }
  .hdr-menu-btn__bars {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    width: 18px;
  }
  .hdr-menu-btn__bars span {
    display: block;
    height: 1px;
    width: 100%;
    background: var(--depth);
    transition: transform .25s, opacity .2s;
  }
  .hdr-menu-btn:hover .hdr-menu-btn__bars span:first-child { transform: translateX(-3px); }
  .hdr-menu-btn:hover { color: var(--cherry); }
  .hdr-menu-btn:hover .hdr-menu-btn__bars span { background: var(--cherry); }

  .hdr-icon-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: var(--depth);
    transition: color .2s;
  }
  .hdr-icon-btn:hover { color: var(--cherry); }
  .hdr-bag__count {
    font-family: var(--serif);
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    letter-spacing: 0;
    margin-left: 2px;
    line-height: 1;
  }

  .nav-drawer {
    position: fixed;
    inset: 0;
    z-index: 300;
    pointer-events: none;
    visibility: hidden;
  }
  .nav-drawer.is-open {
    pointer-events: auto;
    visibility: visible;
  }
  .nav-drawer__scrim {
    position: absolute;
    inset: 0;
    background: rgba(20, 12, 8, 0);
    border: none;
    cursor: pointer;
    transition: background .35s ease;
  }
  .nav-drawer.is-open .nav-drawer__scrim {
    background: rgba(20, 12, 8, 0.32);
  }
  .nav-drawer__panel {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: min(440px, 90vw);
    background: var(--paper);
    transform: translateX(-100%);
    transition: transform .42s cubic-bezier(.2,.7,.2,1);
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 4vw, 48px) clamp(28px, 4vw, 48px) clamp(28px, 3vw, 40px);
    box-shadow: 0 0 60px rgba(0,0,0,0);
  }
  .nav-drawer.is-open .nav-drawer__panel {
    transform: translateX(0);
    box-shadow: 0 0 60px rgba(0,0,0,0.10);
  }
  .nav-drawer__close {
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--depth);
    font-family: inherit;
    font-size: 11px;
    letter-spacing: var(--tr-caps);
    text-transform: uppercase;
    font-weight: 500;
    padding: 4px 0;
    margin-bottom: clamp(24px, 4vw, 56px);
    transition: color .2s;
  }
  .nav-drawer__close:hover { color: var(--cherry); }

  .nav-drawer__list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nav-drawer__list li a {
    display: grid;
    grid-template-columns: 28px 1fr;
    column-gap: 16px;
    align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--depth);
    transition: color .25s, padding-left .25s;
  }
  .nav-drawer__list li a:hover {
    color: var(--cherry);
    padding-left: 6px;
  }
  .nav-num {
    font-family: var(--serif);
    font-style: normal;
    font-weight: 400;
    font-size: 13px;
    color: var(--ink-mid);
  }
  .nav-word {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1;
    letter-spacing: 0;
  }
  .nav-word em {
    font-style: normal;
    color: var(--cherry);
  }
  .nav-sub {
    grid-column: 2 / 3;
    font-family: var(--serif);
    font-style: normal;
    font-weight: 300;
    font-size: 14px;
    color: var(--ink-mid);
    margin-top: 4px;
  }

  .nav-drawer__foot {
    margin-top: auto;
    padding-top: clamp(24px, 3vw, 36px);
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .nav-drawer__foot a {
    font-size: 11px;
    letter-spacing: var(--tr-caps);
    text-transform: uppercase;
    font-weight: 500;
    color: var(--depth);
    transition: color .2s;
  }
  .nav-drawer__foot a:hover { color: var(--cherry); }
  .nav-drawer__sig {
    font-family: var(--serif);
    font-style: normal;
    font-weight: 300;
    font-size: 13px;
    color: var(--ink-mid);
    margin-top: 6px;
    letter-spacing: 0;
    text-transform: none;
  }

  @media (max-width: 768px) {
    :root { --hdr-h: 56px; }
    .site-header--minimal .hdr-wrap {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      position: static;
      padding: 0 16px;
      gap: 12px;
    }
    .site-header--minimal .logo {
      position: static;
      transform: none;
      justify-self: center;
    }
    .site-header--minimal .logo img { height: 18px; }
    .hdr-menu-btn__label { display: none; }
    .hdr-menu-btn { display: none; }
    .hdr-icon-btn .hdr-bag__count { font-size: 13px; }
    .site-header--minimal .hdr-right { gap: 8px; }
  }

  .brand-ticker {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: var(--ticker-h);
    background: #000;
    color: #fff;
    overflow: hidden;
    z-index: 200;
    display: flex;
    align-items: center;
    user-select: none;
  }
  .brand-ticker__track {
    display: flex;
    flex-wrap: nowrap;
    white-space: nowrap;
    animation: tickerScroll 48s linear infinite;
    will-change: transform;
  }
  .brand-ticker:hover .brand-ticker__track { animation-play-state: paused; }
  .brand-ticker__seq {
    display: flex;
    align-items: center;
    gap: 38px;
    padding-right: 38px;
    font-size: 11px;
