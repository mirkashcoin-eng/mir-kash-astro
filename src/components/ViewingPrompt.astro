---
// An invitation to book Try at Home (Mumbai visitors) or a Private Viewing (everyone
// else): a centered editorial dialog over a dimmed page. Shown once someone has clearly
// studied a bag without buying it, or on the homepage once they reach the bottom. It is
// a real modal (scroll locked, focus trapped, Esc / backdrop / close dismiss) but asks
// only once; see ~/lib/viewing-prompt.ts for how often.
//
// When it may appear (once per visit, quiet after dismissal, never after booking)
// lives in ~/lib/viewing-prompt.ts. The trigger point is an element carrying
// `data-vp-sentinel`, placed by the page: below the buy area on product pages,
// at the end of <main> on the homepage.
interface Props {
  page: 'product' | 'home' | 'shop';
  handle?: string;
  title?: string;
  image?: string;
}

const { page, handle = '', title = '', image } = Astro.props;
// Private Viewing exists in every market (/en-us/private-viewing…), so keep visitors in their own storefront.
// Try at Home is Mumbai-only and lives at the root.
const prefix = Astro.locals.marketConfig?.urlPrefix ?? '';
const bag = handle ? `?bag=${encodeURIComponent(handle)}` : '';
const isProduct = page === 'product' && !!title;

const copy = {
  tryhome: {
    eyebrow: 'Mumbai · Try at Home',
    heading: isProduct ? 'See it in your own light.' : 'Try them at home.',
    body: isProduct
      ? `We'll bring the ${title}, and up to five other pieces, to your door. Complimentary, with no pressure to buy.`
      : `We'll bring up to six pieces to your door, so you can choose in your own light. Complimentary, with no pressure to buy.`,
    cta: 'Book a Try at Home',
    href: `/try-at-home${bag}`,
  },
  viewing: {
    eyebrow: 'Private Viewing',
    heading: isProduct ? 'See it up close, live.' : 'See them up close, live.',
    body: isProduct
      ? `A client advisor will show you the ${title} over video: the grain, the hardware, the scale in the hand. Complimentary, 15 to 30 minutes.`
      : 'Book a video viewing with a client advisor and see the pieces you choose in natural light, from anywhere. Complimentary.',
    cta: 'Book a Private Viewing',
    href: `${prefix}/private-viewing${bag}`,
  },
};
const imgSrc = image || '/ed-tophandle.jpeg';
---
<div class="vp" id="vp" data-page={page} hidden>
  <div class="vp__scrim" data-vp-dismiss></div>
  <div class="vp__card" role="dialog" aria-modal="true" aria-labelledby="vpTitle" aria-describedby="vpBody" tabindex="-1">
    <button class="vp__close" type="button" data-vp-dismiss aria-label="Close">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1" fill="none" /></svg>
    </button>
    <div class="vp__media">
      <img src={imgSrc} alt="" loading="lazy" decoding="async" />
    </div>
    <div class="vp__body">
      <p class="vp__eye" data-vp="eyebrow"></p>
      <h2 class="vp__h" id="vpTitle" data-vp="heading"></h2>
      <span class="vp__rule" aria-hidden="true"></span>
      <p class="vp__p" id="vpBody" data-vp="body"></p>
      <a class="vp__cta" data-vp-cta href={copy.viewing.href}>
        <span data-vp="cta"></span><span class="vp__ar" aria-hidden="true">&rarr;</span>
      </a>
      <button class="vp__later" type="button" data-vp-dismiss>Not now</button>
    </div>
  </div>
</div>
<script type="application/json" id="vpCopy" set:html={JSON.stringify(copy).replace(/</g, '\\u003c')} />

<script>
  import { readState, mark, canShow, shownThisSession, markShownThisSession, productReady } from '~/lib/viewing-prompt';

  type Offer = 'tryhome' | 'viewing';
  type Copy = Record<Offer, { eyebrow: string; heading: string; body: string; cta: string; href: string }>;

  // Keep in step with the exit transition durations in the <style> below.
  const EXIT_MS = 600;
  // A modal is louder than a card: never within the first moments of a page view.
  const MIN_PAGE_AGE_MS = 10_000;
  // Bottom of the page (homepage; product pages too): the visitor has to stay there this long, so a fast scroll past doesn't trigger it.
  const HOME_LINGER_MS = 600;

  const el = document.getElementById('vp');
  if (el) init(el);

  function storage(kind: 'localStorage' | 'sessionStorage'): Storage | null {
    try { return window[kind]; } catch { return null; } // the getter itself throws when storage is blocked
  }

  function init(el: HTMLElement) {
    const page = el.dataset.page === 'product' ? 'product' : el.dataset.page === 'shop' ? 'shop' : 'home';
    const copy = JSON.parse(document.getElementById('vpCopy')?.textContent || '{}') as Copy;
    const card = el.querySelector<HTMLElement>('.vp__card')!;
    const ls = storage('localStorage');
    const ss = storage('sessionStorage');
    const force = import.meta.env.DEV && new URLSearchParams(location.search).has('vp');
    if (!force && !canShow(readState(ls, page), shownThisSession(ss, page), Date.now())) return;

    // Direct child of <body>, so the page behind can be made inert without inerting the dialog.
    document.body.appendChild(el);

    // Start fetching the photo once the page is idle, so the dialog never opens with an empty panel.
    const img = el.querySelector('img');
    const preload = () => { if (img) img.loading = 'eager'; };
    if ('requestIdleCallback' in window) requestIdleCallback(preload, { timeout: 4000 }); else setTimeout(preload, 2000);

    // Mumbai (per BaseLayout's /api/geo lookup) → Try at Home; anyone else, or no answer in time → Private Viewing.
    const offerReady: Promise<Offer> = Promise.race([
      (window.mkGeo ?? Promise.resolve(null)).then((g) => (g?.mumbai ? 'tryhome' : 'viewing') as Offer).catch(() => 'viewing' as Offer),
      new Promise<Offer>((r) => setTimeout(() => r('viewing'), 2500)),
    ]);
    let offer: Offer = 'viewing';

    const track = (event: string) => {
      (window.dataLayer = window.dataLayer || []).push({ event, offer, page });
      // First-party counters for /admin (Overview → Booking prompt). Not for the ?vp=1 dev preview.
      if (!force) window.mkTrack?.(event.replace('viewing_prompt_', 'vp_'), { page, offer });
    };

    // ── Modal plumbing: scroll lock, inert page, focus ──
    let previousFocus: Element | null = null;
    let inerted: Element[] = [];
    const root = document.documentElement;

    function lockPage() {
      const gap = window.innerWidth - root.clientWidth; // classic scrollbar width; 0 for overlay scrollbars
      root.style.overflow = 'hidden';
      if (gap > 0) root.style.paddingRight = `${gap}px`;
      inerted = [...document.body.children].filter((n) => n !== el && !/^(SCRIPT|STYLE|LINK|NOSCRIPT)$/.test(n.tagName) && !(n as HTMLElement).inert);
      inerted.forEach((n) => { (n as HTMLElement).inert = true; });
    }
    function unlockPage() {
      root.style.overflow = '';
      root.style.paddingRight = '';
      inerted.forEach((n) => { (n as HTMLElement).inert = false; });
      inerted = [];
    }
    function trapTab(e: KeyboardEvent) {
      if (e.key !== 'Tab') return;
      const focusables = [...card.querySelectorAll<HTMLElement>('a[href], button')].filter((n) => n.offsetParent !== null);
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && (document.activeElement === first || document.activeElement === card)) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }

    // ── Show / hide ──
    let triggered = false;
    let open = false;
    const stops: Array<() => void> = [];

    function show() {
      if (triggered) return;
      triggered = true;
      stops.forEach((s) => s());
      const imgReady = img && !img.complete
        ? Promise.race([img.decode().catch(() => {}), new Promise((r) => setTimeout(r, 1500))])
        : Promise.resolve();
      Promise.all([offerReady, imgReady]).then(([o]) => {
        offer = o;
        const c = copy[o];
        el.querySelectorAll<HTMLElement>('[data-vp]').forEach((n) => { n.textContent = c[n.dataset.vp as keyof typeof c] ?? ''; });
        el.querySelector<HTMLAnchorElement>('[data-vp-cta]')!.href = c.href;
        previousFocus = document.activeElement;
        el.hidden = false;
        lockPage();
        void el.offsetWidth; // commit the start state so the entrance transitions
        el.classList.add('is-in');
        card.focus({ preventScroll: true });
        document.addEventListener('keydown', trapTab);
        open = true;
        markShownThisSession(ss, page);
        track('viewing_prompt_shown');
      });
    }

    function hide() {
      if (!open) return;
      open = false;
      el.classList.remove('is-in');
      document.removeEventListener('keydown', trapTab);
      unlockPage();
      if (previousFocus instanceof HTMLElement) previousFocus.focus({ preventScroll: true });
      // Fixed length, matching the exit transitions below. transitionend isn't used: it bubbles up from
      // whichever child finishes first and would hide the dialog mid-fade.
      setTimeout(() => { if (!open) el.hidden = true; }, EXIT_MS);
    }

    function dismiss() {
      if (!open) return;
      mark(ls, 'dismissedAt', Date.now(), page);
      track('viewing_prompt_dismiss');
      hide();
    }

    el.querySelectorAll('[data-vp-dismiss]').forEach((b) => b.addEventListener('click', dismiss));
    el.querySelector('[data-vp-cta]')?.addEventListener('click', () => {
      mark(ls, 'clickedAt', Date.now(), page);
      track('viewing_prompt_click');
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') dismiss(); });
    // Back button restoring this page from the bfcache must not leave it locked behind the dialog.
    window.addEventListener('pageshow', (e) => { if (e.persisted) hide(); });

    if (force) { show(); return; }

    // ── Triggers ──
    const sentinel = document.querySelector('[data-vp-sentinel]');
    if (!sentinel || !('IntersectionObserver' in window)) return;

    if (page !== 'product') {
      // Homepage / Shop All: once they reach the bottom and stay there a moment (and not in the first seconds of the visit).
      let timer: number | undefined;
      const io = new IntersectionObserver((entries) => {
        const inView = entries.some((e) => e.isIntersecting);
        clearTimeout(timer);
        if (inView) timer = window.setTimeout(show, Math.max(HOME_LINGER_MS, MIN_PAGE_AGE_MS - performance.now()));
      });
      io.observe(sentinel);
      stops.push(() => { io.disconnect(); clearTimeout(timer); });
      return;
    }

    // Product page: studied the bag (visible time + scrolled past the buy area), or heading
    // for the tab bar on desktop, and hasn't tapped Add to Cart / Buy Now.
    let dwellMs = 0;
    let last = performance.now();
    let visible = document.visibilityState === 'visible';
    let pastBuyArea = false;
    let exitIntent = false;
    let atBottom = false;
    let buying = false;

    const tick = () => { const now = performance.now(); if (visible) dwellMs += now - last; last = now; };
    const check = () => { tick(); if (productReady({ dwellMs, pastBuyArea, exitIntent, atBottom, buying })) show(); };

    const onVisibility = () => { tick(); visible = document.visibilityState === 'visible'; };
    document.addEventListener('visibilitychange', onVisibility);
    stops.push(() => document.removeEventListener('visibilitychange', onVisibility));

    const timer = window.setInterval(check, 1000);
    stops.push(() => clearInterval(timer));

    const io = new IntersectionObserver((entries) => {
      // In view, or already scrolled above the viewport (a fast fling skips past it).
      if (entries.some((e) => e.isIntersecting || e.boundingClientRect.top < 0)) {
        pastBuyArea = true;
        io.disconnect();
        check();
      }
    });
    io.observe(sentinel);
    stops.push(() => io.disconnect());

    // Also: they've read all the way down. Same linger and minimum page age as the homepage.
    const end = document.querySelector('[data-vp-end]');
    if (end) {
      let endTimer: number | undefined;
      const endIo = new IntersectionObserver((entries) => {
        clearTimeout(endTimer);
        if (entries.some((e) => e.isIntersecting)) {
          endTimer = window.setTimeout(() => { atBottom = true; check(); }, Math.max(HOME_LINGER_MS, MIN_PAGE_AGE_MS - performance.now()));
        }
      });
      endIo.observe(end);
      stops.push(() => { endIo.disconnect(); clearTimeout(endTimer); });
    }

    if (matchMedia('(pointer: fine)').matches) {
      const onLeave = (e: MouseEvent) => { if (!e.relatedTarget && e.clientY <= 0) { exitIntent = true; check(); } };
      document.addEventListener('mouseout', onLeave);
      stops.push(() => document.removeEventListener('mouseout', onLeave));
    }

    // Buying beats booking: never interrupt a purchase.
    ['atcBtn', 'buyNowBtn', 'mobAtcBtn', 'mobBuyBtn'].forEach((id) => {
      document.getElementById(id)?.addEventListener('click', () => { buying = true; });
    });
  }
</script>

<style>
  .vp {
    --vp-paper: #FAF7F2;   /* Parchment */
    --vp-ink: #2C1A0E;     /* Deep Fig */
    --vp-accent: #8B1A1A;  /* Cherry */
    --vp-ease: cubic-bezier(.16, 1, .3, 1);       /* long, soft landing: movement */
    --vp-fade: cubic-bezier(.4, 0, .2, 1);        /* opacity */
    --vp-exit: cubic-bezier(.4, 0, 1, 1);         /* leaving: quick, no bounce */
    position: fixed;
    inset: 0;
    z-index: 1000; /* above the header, sticky bar and nav drawer */
    display: grid;
    place-items: center;
    padding: 32px;
    font-family: var(--font, 'Brooklyn', -apple-system, 'Helvetica Neue', sans-serif);
    color: var(--vp-ink);
  }
  .vp[hidden] { display: none; }

  .vp__scrim {
    position: absolute; inset: 0;
    background: rgba(44, 26, 14, .56);
    -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity .5s var(--vp-exit);
  }
  /* Entrance: the page dims first and slowly, then the card arrives into the quiet. */
  .vp.is-in .vp__scrim { opacity: 1; transition: opacity 1.1s var(--vp-fade); }

  .vp__card {
    position: relative;
    width: min(780px, 100%);
    max-height: 100%;
    min-height: 470px;
    display: grid;
    grid-template-columns: 45% 1fr;
    background: var(--vp-paper);
    box-shadow: 0 50px 100px -40px rgba(20, 10, 4, .6);
    outline: none;
    overflow: hidden;
    opacity: 0; transform: translateY(26px) scale(.985);
    will-change: opacity, transform;
    transition: opacity .4s var(--vp-exit), transform .5s var(--vp-exit);
  }
  .vp.is-in .vp__card {
    opacity: 1; transform: none;
    transition: opacity 1.1s var(--vp-fade) .2s, transform 1.5s var(--vp-ease) .2s;
  }

  .vp__media { position: relative; overflow: hidden; background: #efe7da; }
  .vp__media img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transform: scale(1.12);
    transition: transform .5s var(--vp-exit);
  }
  /* The photo settles slowly, a beat longer than the card itself. */
  .vp.is-in .vp__media img { transform: none; transition: transform 2.6s var(--vp-ease) .2s; }

  /* Entrance choreography: the text arrives line by line after the card, the rule draws itself,
     the button comes last. Each piece has its own delay (--d); on exit they all leave together. */
  .vp__eye, .vp__h, .vp__p, .vp__cta, .vp__later { opacity: 0; transform: translateY(14px); }
  .vp__rule { transform: scaleX(0); transform-origin: left center; }
  .vp__close { opacity: 0; }
  .vp.is-in .vp__eye, .vp.is-in .vp__h, .vp.is-in .vp__p, .vp.is-in .vp__cta, .vp.is-in .vp__later { opacity: 1; transform: none; }
  .vp.is-in .vp__rule { transform: none; }
  .vp.is-in .vp__close { opacity: 1; }
  .vp__eye   { --d: .65s; }
  .vp__h     { --d: .8s; }
  .vp__rule  { --d: 1s; }
  .vp__p     { --d: 1.1s; }
  .vp__cta   { --d: 1.28s; }
  .vp__later { --d: 1.45s; }
  .vp__close { --d: 1.3s; }
  .vp.is-in .vp__eye, .vp.is-in .vp__h, .vp.is-in .vp__p {
    transition: opacity 1s var(--vp-fade) var(--d), transform 1.3s var(--vp-ease) var(--d);
  }
  .vp.is-in .vp__rule { transition: transform 1.1s var(--vp-ease) var(--d); }

  .vp__body {
    position: relative; overflow-y: auto;
    padding: 56px 52px 40px;
    display: flex; flex-direction: column; justify-content: center;
  }

  .vp__close {
    position: absolute; z-index: 2; top: 14px; right: 14px;
    width: 38px; height: 38px; display: grid; place-items: center;
    background: none; border: 0; padding: 0; cursor: pointer;
    color: rgba(44, 26, 14, .6);
    transition: opacity .3s var(--vp-exit), color .2s, transform .4s var(--vp-ease);
  }
  .vp.is-in .vp__close { transition: opacity .9s var(--vp-fade) var(--d), color .2s, transform .4s var(--vp-ease); }
  .vp__close:hover { color: var(--vp-ink); transform: rotate(90deg); }

  .vp__eye {
    margin: 0 0 18px;
    font-size: 10.5px; font-weight: 500; letter-spacing: .26em; text-transform: uppercase;
    color: rgba(44, 26, 14, .6);
  }
  .vp__h {
    margin: 0;
    font-family: var(--serif, 'DM Serif Display', Georgia, serif);
    font-weight: 400; font-size: 36px; line-height: 1.1; letter-spacing: -.005em;
    color: var(--vp-ink);
  }
  .vp__rule { display: block; width: 32px; height: 1px; margin: 24px 0 20px; background: var(--vp-accent); }
  .vp__p { margin: 0 0 32px; font-size: 14.5px; font-weight: 300; line-height: 1.7; color: rgba(44, 26, 14, .82); }

  .vp__cta {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 18px 22px;
    background: var(--vp-ink); color: var(--vp-paper);
    font-size: 11.5px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase;
    white-space: nowrap; text-decoration: none;
    transition: background .3s, opacity .3s var(--vp-exit), transform .3s var(--vp-exit);
  }
  .vp.is-in .vp__cta { transition: background .3s, opacity 1s var(--vp-fade) var(--d), transform 1.3s var(--vp-ease) var(--d); }
  .vp__cta:hover, .vp__cta:focus-visible { background: var(--vp-accent); }
  .vp__ar { transition: transform .3s var(--vp-ease); }
  .vp__cta:hover .vp__ar { transform: translateX(4px); }

  .vp__later {
    align-self: center; margin-top: 18px; padding: 6px 4px;
    background: none; border: 0; cursor: pointer;
    font: inherit; font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase;
    color: rgba(44, 26, 14, .58);
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px;
    transition: color .2s, opacity .3s var(--vp-exit), transform .3s var(--vp-exit);
  }
  .vp.is-in .vp__later { transition: color .2s, opacity 1s var(--vp-fade) var(--d), transform 1.3s var(--vp-ease) var(--d); }
  .vp__later:hover { color: var(--vp-ink); }

  .vp :focus-visible { outline: 1px solid var(--vp-ink); outline-offset: 3px; }
  .vp__cta:focus-visible { outline-color: var(--vp-paper); outline-offset: -5px; }

  /* Phones: photo on top, text below, full-width button; 16px gutter. */
  @media (max-width: 768px) {
    .vp { padding: 16px; }
    .vp__card {
      width: 100%;
      min-height: 0;
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(0, 1fr);
      max-height: 100%;
    }
    .vp__media { height: min(34dvh, 280px); }
    .vp__body { padding: 28px 24px 22px; justify-content: flex-start; }
    .vp__close { top: 10px; right: 10px; background: rgba(250, 247, 242, .92); color: var(--vp-ink); border-radius: 50%; }
    .vp__eye { margin-bottom: 12px; font-size: 10px; letter-spacing: .22em; }
    .vp__h { font-size: 28px; }
    .vp__rule { margin: 18px 0 16px; }
    .vp__p { margin-bottom: 24px; font-size: 14px; line-height: 1.65; }
    .vp__cta { padding: 17px 18px; font-size: 11px; letter-spacing: .16em; }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Fade only: no movement, no stagger. */
    .vp__scrim, .vp.is-in .vp__scrim { transition: opacity .3s linear; }
    .vp__card, .vp.is-in .vp__card { transform: none; transition: opacity .3s linear; }
    .vp__media img, .vp.is-in .vp__media img { transform: none; transition: none; }
    .vp__eye, .vp__h, .vp__p, .vp__cta, .vp__later, .vp__rule,
    .vp.is-in .vp__eye, .vp.is-in .vp__h, .vp.is-in .vp__p, .vp.is-in .vp__cta, .vp.is-in .vp__later, .vp.is-in .vp__rule { opacity: 1; transform: none; transition: none; }
    .vp__close, .vp.is-in .vp__close { opacity: 1; transition: none; }
    .vp__close:hover { transform: none; }
  }
</style>
