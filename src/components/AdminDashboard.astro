---
// Founders' dashboard gate. Primary: Google sign-in as the Mir Kash account
// (verified server-side, email must be in ADMIN_EMAILS). Fallback: shared ADMIN_PASSCODE.
---
<main class="ad">
  <!-- Sign-in gate -->
  <section class="ad-gate" id="gate" hidden>
    <div class="ad-gate__card">
      <p class="ad-eyebrow">Founders only</p>
      <h1 class="ad-display ad-gate__h">Mir Kash</h1>
      <p class="ad-gate__p">Orders, abandoned checkouts and home-demo bookings — all in one place.</p>
      <button class="ad-google" id="googleBtn" type="button">
        <span class="ad-google__g" aria-hidden="true">G</span> Sign in with Google
      </button>
      <p class="ad-signin-status" id="signinStatus"></p>
      <button class="ad-altlink" id="usePass" type="button">Use a passcode instead</button>
      <form class="ad-pass" id="gateForm" hidden>
        <input class="ad-input" id="passInput" type="password" placeholder="Passcode" autocomplete="off" />
        <button class="ad-enter" id="enterBtn" type="submit">Enter</button>
      </form>
    </div>
  </section>

  <!-- Console -->
  <div class="ad-shell" id="shell" hidden>
    <nav class="ad-nav">
      <div class="ad-nav__logo"><img src="/mir-kash-logo.webp" alt="Mir Kash" /></div>
      <span class="ad-nav__grp">People</span>
      <button class="ad-nav__item on" data-view="people">Everyone <span class="ad-nav__n" id="nPeople"></span></button>
      <span class="ad-nav__grp">Business</span>
      <button class="ad-nav__item" data-view="overview">Overview</button>
      <button class="ad-nav__item" data-view="daily">Daily funnel</button>
      <button class="ad-nav__item" data-view="orders">Orders &amp; revenue <span class="ad-nav__n" id="nOrders"></span></button>
      <button class="ad-nav__item" data-view="fulfilment">Fulfilment &amp; payments <span class="ad-nav__n" id="nFulfil"></span></button>
      <button class="ad-nav__item" data-view="demos">Home demos <span class="ad-nav__n" id="nDemos"></span></button>
      <button class="ad-nav__item" data-view="affiliates">Affiliates <span class="ad-nav__n" id="nAff"></span></button>
      <div class="ad-nav__foot">
        <span class="ad-nav__upd" id="updated"></span>
        <button class="ad-nav__out" id="lockBtn" type="button">Lock dashboard</button>
      </div>
    </nav>

    <div class="ad-main">
      <section class="ad-view" data-view="people">
        <h1 class="ad-display ad-h1">People</h1>
        <p class="ad-sub">Everyone who's shown intent — what they did, what's in their bag, and where they stopped.</p>
        <div class="ad-filters" id="peopleFilters"></div>
        <div class="ad-daterow">
          <div class="ad-filters ad-filters--dates" id="peopleDates"></div>
          <span class="ad-customrange" id="customRange" hidden>
            <input class="ad-finput ad-dateinput" id="dateFrom" type="date" aria-label="From date" />
            <span class="ad-daterow__to">to</span>
            <input class="ad-finput ad-dateinput" id="dateTo" type="date" aria-label="To date" />
          </span>
        </div>
        <div class="ad-searchwrap"><input class="ad-search" id="peopleSearch" type="search" placeholder="Search name, phone, email or bag…" autocomplete="off" /></div>
        <div id="peopleBody"></div>
      </section>
      <section class="ad-view" data-view="overview" hidden>
        <h1 class="ad-display ad-h1">Overview</h1>
        <div class="ad-kpis" id="kpis"></div>
        <div id="productsBody"></div>
        <div class="ad-panel">
          <div class="ad-panel__h"><span class="ad-panel__t">Recent orders</span><button class="ad-panel__more" data-view="orders" type="button">View all →</button></div>
          <div class="ad-scroll" id="ovOrders"></div>
        </div>
        <p class="ad-oppnote">Page views, time on page and traffic sources live in Google Analytics — this dashboard covers people and money.</p>
      </section>
      <section class="ad-view" data-view="daily" hidden>
        <h1 class="ad-display ad-h1">Daily funnel</h1>
        <p class="ad-sub">One month at a time. Each column is a day (IST); each row counts the people who reached that step.</p>
        <div class="ad-daterow">
          <span class="ad-customrange">
            <button class="ad-dbtn" id="monthPrev" type="button" aria-label="Previous month">‹</button>
            <input class="ad-finput ad-dateinput" id="monthPick" type="month" aria-label="Month" />
            <button class="ad-dbtn" id="monthNext" type="button" aria-label="Next month">›</button>
          </span>
          <button class="ad-chip ad-chip--date" id="monthCsv" type="button">Download CSV</button>
        </div>
        <div id="dailyBody"></div>
      </section>
      <section class="ad-view" data-view="orders" hidden>
        <h1 class="ad-display ad-h1">Orders &amp; revenue</h1>
        <div id="revenueBody"></div>
        <div class="ad-panel"><div class="ad-panel__h"><span class="ad-panel__t">All recent orders</span></div><div class="ad-scroll" id="allOrders"></div></div>
      </section>
      <section class="ad-view" data-view="fulfilment" hidden>
        <h1 class="ad-display ad-h1">Fulfilment &amp; payments</h1>
        <div id="fulfilBody"></div>
      </section>
      <section class="ad-view" data-view="demos" hidden>
        <h1 class="ad-display ad-h1">Home-demo bookings</h1>
        <div class="ad-panel"><div class="ad-scroll" id="allDemos"></div></div>
      </section>
      <section class="ad-view" data-view="affiliates" hidden>
        <h1 class="ad-display ad-h1">Affiliates</h1>
        <p class="ad-sub">Give a creator their own link. Any India order that starts from it is credited to them.</p>
        <div class="ad-panel ad-affnew">
          <div class="ad-panel__h"><span class="ad-panel__t">New link</span></div>
          <form class="ad-affform" id="affForm">
            <label class="ad-flabel">Link name
              <span class="ad-affslug">
                <input class="ad-finput" id="affSlug" type="text" placeholder="priya" autocomplete="off" />
                <button class="ad-affgen" id="affGen" type="button" title="Use a random code instead">Random</button>
              </span>
            </label>
            <label class="ad-flabel">Creator (optional)<input class="ad-finput" id="affLabel" type="text" placeholder="Priya Sharma" autocomplete="off" /></label>
            <button class="ad-dbtn ad-dbtn--fill" id="affCreate" type="submit">Create link</button>
          </form>
          <p class="ad-actmsg" id="affMsg"></p>
        </div>
        <div id="affBody"></div>
      </section>
    </div>
  </div>

  <!-- Detail drawer — a person's full journey, or a booking's detail -->
  <div class="ad-drawer" id="drawer" hidden>
    <div class="ad-drawer__scrim" id="drawerScrim"></div>
    <aside class="ad-drawer__panel" role="dialog" aria-modal="true" aria-label="Detail">
      <button class="ad-drawer__close" id="drawerClose" type="button" aria-label="Close">&times;</button>
      <div id="drawerBody"></div>
    </aside>
  </div>
</main>

<script>
  import { getIdToken, getSessionUser, signInWithGoogle, signOut } from '~/lib/firebaseClient';

  (function () {
    var LS = 'mk_admin_key';
    var ABANDONED = [];
    var DEMOS = [];
    var PEOPLE = [];
    var ORDERS = [];
    var AFFILIATES = [];
    var FULFIL_PENDING = 0;
    var FILTER = 'all';   // active stage filter in the People view
    var DATE_FILTER = 'all';
    var SEARCH = '';
    var AUTH = null; // { kind:'key', key } | { kind:'token' } — in memory only, never persisted
    var $ = function (id) { return document.getElementById(id); };
    // Auth header for follow-up admin actions, reusing this session's credential.
    async function authHeaders() {
      if (!AUTH) return null;
      if (AUTH.kind === 'key') return { 'x-admin-key': AUTH.key };
      var t = null; try { t = await getIdToken(); } catch (e) {}
      return t ? { Authorization: 'Bearer ' + t } : null;
    }
    var inr = function (amount, cur) {
      cur = cur || 'INR';
      if (amount == null) return '—';
      var n = Math.round(Number(amount));
      try { return new Intl.NumberFormat('en-IN', { style: 'currency', currency: cur, maximumFractionDigits: 0 }).format(n); }
      catch (e) { return cur + ' ' + n; }
    };
    var when = function (iso, withTime) {
      if (!iso) return '—';
      try { return new Date(iso).toLocaleDateString('en-IN', withTime ? { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' } : { day: 'numeric', month: 'short' }); }
      catch (e) { return iso; }
    };
    var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
    var contact = function (email, phone) { return [email ? esc(email) : '', phone ? esc(phone) : ''].filter(Boolean).join(' · ') || '—'; };

    function orderPill(o) {
      if (o.cancelled) return '<span class="ad-pill ad-pill--cancel">Cancelled</span>';
      var f = String(o.fulfillment || '').toUpperCase();
      if (f.indexOf('FULFILLED') > -1 && f.indexOf('UNFULFILLED') === -1) return '<span class="ad-pill ad-pill--good">Fulfilled</span>';
      var fin = String(o.financial || '').toUpperCase();
      var paid = fin === 'PAID' ? '' : ' · ' + (fin.charAt(0) + fin.slice(1).toLowerCase());
      return '<span class="ad-pill">Ordered' + esc(paid) + '</span>';
    }
    function ordersTable(orders) {
      if (!orders.length) return '<p class="ad-note ad-pad">No orders yet.</p>';
      return '<table class="ad-table"><thead><tr><th>Customer</th><th>Order</th><th>Items</th><th>Date</th><th class="r">Total</th><th>Status</th></tr></thead><tbody>' + orders.map(function (o) {
        return '<tr><td class="nm">' + esc(o.customer || 'Guest') + (o.email ? '<div class="sub">' + esc(o.email) + '</div>' : '') + '</td><td>' + esc(o.name) + '</td><td>' + esc(o.items || '—') + '</td><td>' + when(o.createdAt) + '</td><td class="r amt">' + esc(inr(o.total && o.total.amount, o.total && o.total.currencyCode)) + '</td><td>' + orderPill(o) + '</td></tr>';
      }).join('') + '</tbody></table>';
    }
    function demoPill(status) {
      if (status === 'completed') return '<span class="ad-pill ad-pill--done">Completed</span>';
      if (status === 'confirmed') return '<span class="ad-pill ad-pill--good">Confirmed</span>';
      return '<span class="ad-pill ad-pill--wait">Requested</span>';
    }
    function demosTable(demos) {
      if (!demos.length) return '<p class="ad-note ad-pad">No home-demo bookings yet.</p>';
      return '<table class="ad-table ad-table--click"><thead><tr><th>Customer</th><th>Status</th><th>Date &amp; slot</th><th>Bags</th><th>Contact</th><th></th></tr></thead><tbody>' + demos.map(function (d, i) {
        return '<tr data-idx="' + i + '"><td class="nm">' + esc(d.customer || 'Guest') + '</td><td>' + demoPill(d.status) + '</td><td>' + esc(d.date || '—') + (d.slot ? '<div class="sub">' + esc(d.slot) + '</div>' : '') + '</td><td>' + esc(d.bags || '—') + '</td><td class="sub">' + contact(d.email, d.phone) + '</td><td class="r"><span class="ad-rowview">View →</span></td></tr>';
      }).join('') + '</tbody></table>';
    }
    // ── Unread badges ─────────────────────────────────────────────────────────
    // Each nav badge counts records newer than the last time that tab was opened,
    // so it reads as "new since you last looked" rather than a running total.
    // Marks live in localStorage — view timestamps, not credentials, so they can
    // safely outlive the session (unlike the passcode, which never persists).
    var SEEN_LS = 'mk_admin_seen';
    var SEEN = {};
    try { SEEN = JSON.parse(localStorage.getItem(SEEN_LS) || '{}') || {}; } catch (e) { SEEN = {}; }
    function saveSeen() { try { localStorage.setItem(SEEN_LS, JSON.stringify(SEEN)); } catch (e) {} }
    // Records created after the mark. First ever visit has no mark — show nothing
    // rather than flagging the entire backlog as "new".
    function unreadCount(view, rows, stamp) {
      var mark = SEEN[view];
      if (!mark) return 0;
      var n = 0;
      for (var i = 0; i < rows.length; i++) {
        var t = new Date(stamp(rows[i]) || 0).getTime();
        if (isFinite(t) && t > mark) n++;
      }
      return n;
    }
    function setBadge(id, n) {
      var el = $(id); if (!el) return;
      el.textContent = n ? String(n) : '';
      el.classList.toggle('is-new', !!n);
    }
    // Opening a tab clears its badge and re-marks it as read from now.
    function markSeen(view) {
      SEEN[view] = Date.now();
      saveSeen();
      renderBadges();
    }
    // Badges reflect the data currently loaded; called after each fetch and on
    // every tab switch.
    function renderBadges() {
      var byCreated = function (r) { return r.createdAt; };
      setBadge('nPeople', unreadCount('people', PEOPLE, function (p) { return p.lastSeen || p.firstSeen; }));
      setBadge('nOrders', unreadCount('orders', ORDERS, byCreated));
      setBadge('nDemos', unreadCount('demos', DEMOS, byCreated));
      setBadge('nAff', unreadCount('affiliates', AFFILIATES, function (a) { return a.createdAt; }));
      // Fulfilment is a work queue, not a feed: the badge is how much is waiting
      // on you right now, so it stays a live count rather than an unread mark.
      setBadge('nFulfil', FULFIL_PENDING);
    }

    function switchView(view) {
      var items = document.querySelectorAll('.ad-nav__item');
      for (var i = 0; i < items.length; i++) items[i].classList.toggle('on', items[i].getAttribute('data-view') === view);
      var views = document.querySelectorAll('.ad-view');
      for (var j = 0; j < views.length; j++) views[j].hidden = views[j].getAttribute('data-view') !== view;
      var main = document.querySelector('.ad-main'); if (main) main.scrollTo(0, 0);
      markSeen(view);
    }

    function render(data) {
      $('gate').hidden = true;
      $('shell').hidden = false;
      var orders = data.orders || [];
      var abandoned = data.abandoned || [];
      ABANDONED = abandoned;
      var demos = data.demos || [];
      DEMOS = demos;
      PEOPLE = data.people || [];
      ORDERS = orders;
      AFFILIATES = data.affiliates || [];

      var now = Date.now();
      var recent = orders.filter(function (o) { var t = new Date(o.createdAt).getTime(); return isFinite(t) && now - t <= 30 * 864e5 && !o.cancelled; });
      var revenue = recent.reduce(function (s, o) { return s + Number((o.total && o.total.amount) || 0); }, 0);
      var f = data.funnel;
      var conv = (f && f.visit) ? ((recent.length / f.visit) * 100).toFixed(1) + '%' : '—';
      $('kpis').innerHTML = [
        { n: inr(String(revenue)), k: 'Revenue · 30d', d: recent.length + ' orders →', v: 'orders' },
        { n: String(PEOPLE.length), k: 'People captured', d: 'view all →', v: 'people' },
        { n: String(abandoned.length), k: 'Abandoned', d: 'chase them →', v: 'people' },
        { n: conv, k: 'Visitor → order', d: f ? 'last ' + f.days + 'd' : '', v: 'overview' },
      ].map(function (x) { return '<button type="button" class="ad-kpi ad-kpi--click" data-view="' + x.v + '"><span class="ad-kpi__n">' + esc(x.n) + '</span><span class="ad-kpi__k">' + esc(x.k) + '</span><span class="ad-kpi__d">' + esc(x.d) + '</span></button>'; }).join('');

      $('ovOrders').innerHTML = ordersTable(orders.slice(0, 8));
      $('allOrders').innerHTML = ordersTable(orders);
      $('allDemos').innerHTML = demosTable(demos);
      renderRevenue(orders, abandoned);
      renderFulfilment(orders);
      renderProducts(data.products);
      renderAffiliates(data.affiliates);
      renderPeople();
      renderDaily();
      renderBadges(); // after renderFulfilment, which computes the pending count

      // Re-bind only the (regenerated) KPI cards; the static sidebar nav is bound
      // once at setup so auto-refresh re-renders don't stack listeners.
      var kpis = $('kpis').querySelectorAll('[data-view]');
      for (var i = 0; i < kpis.length; i++) {
        (function (el) { el.addEventListener('click', function () { switchView(el.getAttribute('data-view')); }); })(kpis[i]);
      }
      stampUpdated();
      startAutoRefresh();
      // The open tab can't have unread items — mark it read on the first paint.
      if (!FIRST_PAINT_DONE) {
        FIRST_PAINT_DONE = true;
        var open = document.querySelector('.ad-nav__item.on');
        if (open) markSeen(open.getAttribute('data-view'));
      }
    }
    var FIRST_PAINT_DONE = false;

    // ── People (every visitor who showed intent, one row each) ────────────────
    // The journey stages, in order. `key` matches Person.stage from the API.
    var STAGES = [
      { key: 'visited',  label: 'Just visited',   cls: 'ad-pill--wait' },
      { key: 'cart',     label: 'Added to bag',   cls: 'ad-pill--wait' },
      { key: 'phone',    label: 'Entered phone',  cls: 'ad-pill--good' },
      { key: 'address',  label: 'Entered address', cls: 'ad-pill--good' },
      { key: 'payment',  label: 'Abandoned at payment', cls: 'ad-pill--cancel' },
      { key: 'ordered',  label: 'Ordered',        cls: 'ad-pill--done' },
    ];
    function stageMeta(k) {
      for (var i = 0; i < STAGES.length; i++) if (STAGES[i].key === k) return STAGES[i];
      return STAGES[0];
    }
    function stagePill(k) {
      var m = stageMeta(k);
      return '<span class="ad-pill ' + m.cls + '">' + esc(m.label) + '</span>';
    }
    // Best label we have: a real name, else the phone, else the email. Legacy imports
    // only ever carry a phone, so "Visitor" is a genuine last resort.
    function personName(p) { return p.name || p.phone || p.email || 'Visitor'; }
    // Contact line under the title — skip whatever's already used as the title.
    function personSub(p) {
      var title = personName(p);
      return [p.phone, p.email].filter(function (v) { return v && v !== title; })
        .map(esc).join(' · ') || '';
    }
    // ── Date range ────────────────────────────────────────────────────────────
    // Presets are relative to the store's day (IST), so "today" means today in
    // Mumbai regardless of where the founder is browsing from.
    var DATE_PRESETS = [
      { key: 'all', label: 'All time' },
      { key: 'today', label: 'Today' },
      { key: 'yesterday', label: 'Yesterday' },
      { key: '7d', label: 'Last 7 days' },
      { key: '30d', label: 'Last 30 days' },
      { key: 'month', label: 'This month' },
      { key: 'custom', label: 'Custom' },
    ];
    // Midnight IST for a given day-offset, as epoch ms.
    function istMidnight(daysAgo) {
      var nowIst = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Kolkata' }));
      nowIst.setHours(0, 0, 0, 0);
      nowIst.setDate(nowIst.getDate() - (daysAgo || 0));
      // Reinterpret that IST wall-clock time as a real instant (IST = UTC+5:30).
      return nowIst.getTime() - (nowIst.getTimezoneOffset() * 60000) - (5.5 * 3600000);
    }
    // { from, to } in epoch ms; null bound = open-ended.
    function activeRange() {
      if (DATE_FILTER === 'all') return null;
      if (DATE_FILTER === 'today') return { from: istMidnight(0), to: null };
      // The only preset that closes at the top — yesterday excludes today.
      if (DATE_FILTER === 'yesterday') return { from: istMidnight(1), to: istMidnight(0) - 1 };
      if (DATE_FILTER === '7d') return { from: istMidnight(6), to: null };
      if (DATE_FILTER === '30d') return { from: istMidnight(29), to: null };
      if (DATE_FILTER === 'month') {
        var d = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Kolkata' }));
        return { from: istMidnight(d.getDate() - 1), to: null };
      }
      if (DATE_FILTER === 'custom') {
        var f = ($('dateFrom') || {}).value, t = ($('dateTo') || {}).value;
        if (!f && !t) return null;
        return {
          from: f ? new Date(f + 'T00:00:00+05:30').getTime() : null,
          // `to` is inclusive: the whole of that day counts.
          to: t ? new Date(t + 'T23:59:59.999+05:30').getTime() : null,
        };
      }
      return null;
    }
    // A person belongs to the range if they were active in it — lastSeen is the
    // "when did this person matter" signal, falling back to firstSeen.
    function inRange(p, range) {
      if (!range) return true;
      var t = new Date(p.lastSeen || p.firstSeen || 0).getTime();
      if (!isFinite(t) || !t) return false;
      if (range.from && t < range.from) return false;
      if (range.to && t > range.to) return false;
      return true;
    }
    function renderDateFilters() {
      var wrap = $('peopleDates'); if (!wrap) return;
      wrap.innerHTML = DATE_PRESETS.map(function (d) {
        return '<button type="button" class="ad-chip ad-chip--date' + (DATE_FILTER === d.key ? ' on' : '') +
          '" data-date="' + d.key + '">' + esc(d.label) + '</button>';
      }).join('');
      var cr = $('customRange'); if (cr) cr.hidden = DATE_FILTER !== 'custom';
    }

    // ── Daily funnel grid ─────────────────────────────────────────────────────
    // One column per day of a month, one row per funnel step. A person counts on
    // the day they FIRST reached a step, so each row is "how many new people got
    // this far that day" — the columns are comparable and nobody is double-counted.
    var MONTH = '';       // 'YYYY-MM'; set on first render
    var SHOW_BOTS = false; // crawlers are recorded but excluded from counts by default
    // The IST calendar day (YYYY-MM-DD) an instant falls on. Firestore stores UTC,
    // but the store's day is Mumbai's, so bucketing must match the People filters.
    function istDay(ts) {
      if (!ts) return '';
      var t = new Date(ts).getTime();
      if (!isFinite(t) || !t) return '';
      return new Date(t).toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
    }
    function currentIstMonth() { return istDay(Date.now()).slice(0, 7); }
    function daysInMonth(m) {
      var y = Number(m.slice(0, 4)), mo = Number(m.slice(5, 7));
      return new Date(y, mo, 0).getDate(); // day 0 of next month = last day of this one
    }
    // The nine rows, in funnel order. Each returns the day a person counts on, or
    // '' to skip them. Product-count rows are mutually exclusive buckets.
    var DAILY_ROWS = [
      { key: 'visits',   label: 'Unique visitors',    day: function (p) { return istDay(p.firstSeen); } },
      { key: 'p1',       label: 'Viewed 1 product',   day: function (p) { return p.viewed.length === 1 ? istDay(p.viewedAt || p.firstSeen) : ''; } },
      { key: 'p2',       label: 'Viewed 2 products',  day: function (p) { return p.viewed.length === 2 ? istDay(p.viewedAt || p.firstSeen) : ''; } },
      { key: 'p3',       label: 'Viewed 2+ products', day: function (p) { return p.viewed.length > 2 ? istDay(p.viewedAt || p.firstSeen) : ''; } },
      { key: 'cart',     label: 'Added to cart',      day: function (p) { return istDay(p.cartAt); } },
      { key: 'phone',    label: 'Added phone number', day: function (p) { return istDay(p.phoneAt); } },
      { key: 'address',  label: 'Added address',      day: function (p) { return istDay(p.addressAt); } },
    ];
    // Builds { rowKey: { 'YYYY-MM-DD': n } } for the given month.
    function dailyCounts(month) {
      var grid = {};
      DAILY_ROWS.forEach(function (r) { grid[r.key] = {}; });
      grid.checkout = {}; grid.ordered = {};
      var bump = function (key, day) {
        if (!day || day.slice(0, 7) !== month) return;
