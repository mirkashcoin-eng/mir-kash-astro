---
// Founders' dashboard. A thin composition of the partials in ./admin/.
// Google sign-in only, verified server-side: full access for ADMIN_EMAILS (root founders)
// or anyone granted 'full' in Team access; the restricted 'affiliate' role sees only
// Affiliates. All behaviour lives in ./admin/main.ts (auth, routing) and the client modules.
import AdminShell from './admin/AdminShell.astro';
import TodaySection from './admin/TodaySection.astro';
import OverviewSection from './admin/OverviewSection.astro';
import AcquisitionSection from './admin/AcquisitionSection.astro';
import ProductsSection from './admin/ProductsSection.astro';
import CheckoutSection from './admin/CheckoutSection.astro';
import AudienceSection from './admin/AudienceSection.astro';
import RetentionSection from './admin/RetentionSection.astro';
import PeopleSection from './admin/PeopleSection.astro';
import DailyFunnelSection from './admin/DailyFunnelSection.astro';
import OrdersSection from './admin/OrdersSection.astro';
import FulfilmentSection from './admin/FulfilmentSection.astro';
import DemosSection from './admin/DemosSection.astro';
import ViewingsSection from './admin/ViewingsSection.astro';
import AffiliatesSection from './admin/AffiliatesSection.astro';
import NewsletterSection from './admin/NewsletterSection.astro';
import TeamSection from './admin/TeamSection.astro';
---
<AdminShell>
  <TodaySection />
  <OverviewSection />
  <AcquisitionSection />
  <ProductsSection />
  <CheckoutSection />
  <AudienceSection />
  <RetentionSection />
  <PeopleSection />
  <DailyFunnelSection />
  <OrdersSection />
  <FulfilmentSection />
  <DemosSection />
  <ViewingsSection />
  <AffiliatesSection />
  <NewsletterSection />
  <TeamSection />
</AdminShell>
