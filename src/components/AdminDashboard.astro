        DAILY_ROWS.forEach(function (r) { bump(r.key, r.day(p)); });
      });
      // The two money steps come from Shopify, which is authoritative for both.
      ABANDONED.forEach(function (a) { bump('checkout', istDay(a.createdAt)); });
      ORDERS.forEach(function (o) {
        if (o.cancelled) return;
        bump('checkout', istDay(o.createdAt)); // an order necessarily attempted checkout
        bump('ordered', istDay(o.createdAt));
