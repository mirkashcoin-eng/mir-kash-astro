---
// Founders' dashboard gate. Primary: Google sign-in as the Mir Kash account
// (verified server-side, email must be in ADMIN_EMAILS). Fallback: shared ADMIN_PASSCODE.
---
<main class="ad">
  <!-- Sign-in gate -->
  <section class="ad-gate" id="gate" hidden>
    <div class="ad-gate__card">
      <p class="ad-eyebrow">Founders only</p>
      <h1 class="ad-display ad-gate__h">Mir Kash</h1>
      <p class="ad-gate__p">Orders, abandoned checkouts and home-demo bookings — all in one place.</p>
      <button class="ad-google" id="googleBtn" type="button">
        <span class="ad-google__g" aria-hidden="true">G</span> Sign in with Google
      </button>
      <p class="ad-signin-status" id="signinStatus"></p>
      <button class="ad-altlink" id="usePass" type="button">Use a passcode instead</button>
      <form class="ad-pass" id="gateForm" hidden>
        <input class="ad-input" id="passInput" type="password" placeholder="Passcode" autocomplete="off" />
        <button class="ad-enter" id="enterBtn" type="submit">Enter</button>
      </form>
    </div>
  </section>

  <!-- Console -->
  <div class="ad-shell" id="shell" hidden>
    <nav class="ad-nav">
      <div class="ad-nav__logo">MIR KASH</div>
      <button class="ad-nav__item on" data-view="overview">Overview</button>
      <button class="ad-nav__item" data-view="revenue">Revenue</button>
      <button class="ad-nav__item" data-view="visitors">Visitors</button>
      <button class="ad-nav__item" data-view="orders">Recent orders <span class="ad-nav__n" id="nOrders"></span></button>
      <button class="ad-nav__item" data-view="fulfilment">Fulfilment &amp; payments <span class="ad-nav__n" id="nFulfil"></span></button>
      <button class="ad-nav__item" data-view="abandoned">Abandoned checkouts <span class="ad-nav__n" id="nAband"></span></button>
      <button class="ad-nav__item" data-view="demos">Home demos <span class="ad-nav__n" id="nDemos"></span></button>
      <div class="ad-nav__foot">
        <button class="ad-nav__out" id="lockBtn" type="button">Lock dashboard</button>
      </div>
    </nav>

    <div class="ad-main">
      <section class="ad-view" data-view="overview">
        <h1 class="ad-display ad-h1">Overview</h1>
        <div class="ad-kpis" id="kpis"></div>
        <div class="ad-panel">
          <div class="ad-panel__h"><span class="ad-panel__t">Recent orders</span><button class="ad-panel__more" data-view="orders" type="button">View all →</button></div>
          <div class="ad-scroll" id="ovOrders"></div>
        </div>
      </section>
      <section class="ad-view" data-view="revenue" hidden>
        <h1 class="ad-display ad-h1">Revenue insights</h1>
        <div id="revenueBody"></div>
      </section>
      <section class="ad-view" data-view="visitors" hidden>
        <h1 class="ad-display ad-h1">Visitor funnel</h1>
        <div id="funnelBody"></div>
      </section>
      <section class="ad-view" data-view="orders" hidden>
        <h1 class="ad-display ad-h1">Recent orders</h1>
        <div class="ad-panel"><div class="ad-scroll" id="allOrders"></div></div>
      </section>
      <section class="ad-view" data-view="fulfilment" hidden>
        <h1 class="ad-display ad-h1">Fulfilment &amp; payments</h1>
        <div id="fulfilBody"></div>
      </section>
      <section class="ad-view" data-view="abandoned" hidden>
        <h1 class="ad-display ad-h1">Abandoned checkouts</h1>
        <div class="ad-panel"><div class="ad-scroll" id="allAband"></div></div>
      </section>
      <section class="ad-view" data-view="demos" hidden>
        <h1 class="ad-display ad-h1">Home-demo bookings</h1>
        <div class="ad-panel"><div class="ad-scroll" id="allDemos"></div></div>
      </section>
    </div>
  </div>

  <!-- Detail drawer — full abandoned-checkout breakdown (Shopify-style) -->
  <div class="ad-drawer" id="drawer" hidden>
    <div class="ad-drawer__scrim" id="drawerScrim"></div>
    <aside class="ad-drawer__panel" role="dialog" aria-modal="true" aria-label="Abandoned checkout detail">
      <button class="ad-drawer__close" id="drawerClose" type="button" aria-label="Close">&times;</button>
      <div id="drawerBody"></div>
    </aside>
  </div>
</main>

<script>
  import { getIdToken, signInWithGoogle, signOut } from '~/lib/firebaseClient';

  (function () {
    var LS = 'mk_admin_key';
    var ABANDONED = [];
    var DEMOS = [];
    var AUTH = null; // { kind:'key', key } | { kind:'token' } — in memory only, never persisted
    var $ = function (id) { return document.getElementById(id); };
    // Auth header for follow-up admin actions, reusing this session's credential.
    async function authHeaders() {
      if (!AUTH) return null;
      if (AUTH.kind === 'key') return { 'x-admin-key': AUTH.key };
      var t = null; try { t = await getIdToken(); } catch (e) {}
      return t ? { Authorization: 'Bearer ' + t } : null;
    }
    var inr = function (amount, cur) {
      cur = cur || 'INR';
      if (amount == null) return '—';
      var n = Math.round(Number(amount));
      try { return new Intl.NumberFormat('en-IN', { style: 'currency', currency: cur, maximumFractionDigits: 0 }).format(n); }
      catch (e) { return cur + ' ' + n; }
    };
    var when = function (iso, withTime) {
      if (!iso) return '—';
      try { return new Date(iso).toLocaleDateString('en-IN', withTime ? { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' } : { day: 'numeric', month: 'short' }); }
      catch (e) { return iso; }
    };
    var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
    var contact = function (email, phone) { return [email ? esc(email) : '', phone ? esc(phone) : ''].filter(Boolean).join(' · ') || '—'; };

    function orderPill(o) {
      if (o.cancelled) return '<span class="ad-pill ad-pill--cancel">Cancelled</span>';
      var f = String(o.fulfillment || '').toUpperCase();
      if (f.indexOf('FULFILLED') > -1 && f.indexOf('UNFULFILLED') === -1) return '<span class="ad-pill ad-pill--good">Fulfilled</span>';
      var fin = String(o.financial || '').toUpperCase();
      var paid = fin === 'PAID' ? '' : ' · ' + (fin.charAt(0) + fin.slice(1).toLowerCase());
      return '<span class="ad-pill">Ordered' + esc(paid) + '</span>';
    }
    function ordersTable(orders) {
      if (!orders.length) return '<p class="ad-note ad-pad">No orders yet.</p>';
      return '<table class="ad-table"><thead><tr><th>Customer</th><th>Order</th><th>Items</th><th>Date</th><th class="r">Total</th><th>Status</th></tr></thead><tbody>' + orders.map(function (o) {
        return '<tr><td class="nm">' + esc(o.customer || 'Guest') + (o.email ? '<div class="sub">' + esc(o.email) + '</div>' : '') + '</td><td>' + esc(o.name) + '</td><td>' + esc(o.items || '—') + '</td><td>' + when(o.createdAt) + '</td><td class="r amt">' + esc(inr(o.total && o.total.amount, o.total && o.total.currencyCode)) + '</td><td>' + orderPill(o) + '</td></tr>';
      }).join('') + '</tbody></table>';
    }
    function abandonedTable(rows) {
      if (!rows.length) return '<p class="ad-note ad-pad">No abandoned checkouts yet.</p>';
      return '<table class="ad-table ad-table--click"><thead><tr><th>Customer</th><th>Contact</th><th>Items</th><th class="r">Value</th><th>When</th><th></th></tr></thead><tbody>' + rows.map(function (r, i) {
        return '<tr data-idx="' + i + '"><td class="nm">' + esc(r.customer || 'Unknown') + '</td><td class="sub">' + contact(r.email, r.phone) + '</td><td>' + esc(r.items || '—') + '</td><td class="r amt">' + esc(inr(r.total && r.total.amount, r.total && r.total.currencyCode)) + '</td><td>' + when(r.createdAt, true) + '</td><td class="r"><span class="ad-rowview">View →</span></td></tr>';
      }).join('') + '</tbody></table>';
    }
    function demoPill(status) {
      if (status === 'completed') return '<span class="ad-pill ad-pill--done">Completed</span>';
      if (status === 'confirmed') return '<span class="ad-pill ad-pill--good">Confirmed</span>';
      return '<span class="ad-pill ad-pill--wait">Requested</span>';
    }
    function demosTable(demos) {
      if (!demos.length) return '<p class="ad-note ad-pad">No home-demo bookings yet.</p>';
      return '<table class="ad-table ad-table--click"><thead><tr><th>Customer</th><th>Status</th><th>Date &amp; slot</th><th>Bags</th><th>Contact</th><th></th></tr></thead><tbody>' + demos.map(function (d, i) {
        return '<tr data-idx="' + i + '"><td class="nm">' + esc(d.customer || 'Guest') + '</td><td>' + demoPill(d.status) + '</td><td>' + esc(d.date || '—') + (d.slot ? '<div class="sub">' + esc(d.slot) + '</div>' : '') + '</td><td>' + esc(d.bags || '—') + '</td><td class="sub">' + contact(d.email, d.phone) + '</td><td class="r"><span class="ad-rowview">View →</span></td></tr>';
      }).join('') + '</tbody></table>';
    }
    function switchView(view) {
      var items = document.querySelectorAll('.ad-nav__item');
      for (var i = 0; i < items.length; i++) items[i].classList.toggle('on', items[i].getAttribute('data-view') === view);
      var views = document.querySelectorAll('.ad-view');
      for (var j = 0; j < views.length; j++) views[j].hidden = views[j].getAttribute('data-view') !== view;
      var main = document.querySelector('.ad-main'); if (main) main.scrollTo(0, 0);
    }

    function render(data) {
      $('gate').hidden = true;
      $('shell').hidden = false;
      var orders = data.orders || [];
      var abandoned = data.abandoned || [];
      ABANDONED = abandoned;
      var demos = data.demos || [];
      DEMOS = demos;
      $('nOrders').textContent = String(orders.length);
      $('nAband').textContent = String(abandoned.length);
      $('nDemos').textContent = String(demos.length);

      var now = Date.now();
      var recent = orders.filter(function (o) { var t = new Date(o.createdAt).getTime(); return isFinite(t) && now - t <= 30 * 864e5 && !o.cancelled; });
      var revenue = recent.reduce(function (s, o) { return s + Number((o.total && o.total.amount) || 0); }, 0);
      $('kpis').innerHTML = [
        { n: inr(String(revenue)), k: 'Revenue · 30d', d: recent.length + ' orders →', v: 'revenue' },
        { n: String(orders.length), k: 'Recent orders', d: 'view all →', v: 'orders' },
        { n: String(abandoned.length), k: 'Abandoned', d: 'view all →', v: 'abandoned' },
        { n: String(demos.length), k: 'Home demos', d: 'view all →', v: 'demos' },
      ].map(function (x) { return '<button type="button" class="ad-kpi ad-kpi--click" data-view="' + x.v + '"><span class="ad-kpi__n">' + esc(x.n) + '</span><span class="ad-kpi__k">' + esc(x.k) + '</span><span class="ad-kpi__d">' + esc(x.d) + '</span></button>'; }).join('');

      $('ovOrders').innerHTML = ordersTable(orders.slice(0, 8));
      $('allOrders').innerHTML = ordersTable(orders);
      $('allAband').innerHTML = abandonedTable(abandoned);
      $('allDemos').innerHTML = demosTable(demos);
      renderRevenue(orders, abandoned);
      renderFulfilment(orders);
      renderFunnel(data.funnel, orders);

      var navs = document.querySelectorAll('[data-view]');
      for (var i = 0; i < navs.length; i++) {
        if (navs[i].classList.contains('ad-view')) continue;
        (function (el) { el.addEventListener('click', function () { switchView(el.getAttribute('data-view')); }); })(navs[i]);
      }
    }

    // ── Visitor funnel ────────────────────────────────────────────────────────
    function renderFunnel(funnel, orders) {
      var body = $('funnelBody');
      if (!body) return;
      if (!funnel) { body.innerHTML = '<div class="ad-panel"><p class="ad-note ad-pad">Visitor tracking isn’t available yet — it needs the Firestore rule for <code>analytics_daily</code>. Once that’s set, data appears here.</p></div>'; return; }
      var now = Date.now(), DAY = 864e5;
      var purchases = orders.filter(function (o) { var t = new Date(o.createdAt).getTime(); return !o.cancelled && isFinite(t) && now - t <= 30 * DAY; }).length;
      var stages = [
        { k: 'Visited the site', n: funnel.visit || 0 },
        { k: 'Viewed a product', n: funnel.product_view || 0 },
        { k: 'Added to bag', n: funnel.add_to_cart || 0 },
        { k: 'Started checkout', n: funnel.checkout_start || 0 },
        { k: 'Reached payment', n: funnel.payment_start || 0 },
        { k: 'Purchased', n: purchases },
      ];
      var top = Math.max(stages[0].n, 1);
      var totalEvents = stages.reduce(function (s, x) { return s + x.n; }, 0);
      var rows = stages.map(function (s, i) {
        var pctTop = top ? (s.n / top) * 100 : 0;
        var pctVis = top ? Math.round((s.n / top) * 100) : 0;
        var drop = '';
        if (i > 0) {
          var prev = stages[i - 1].n;
          var dv = (prev > 0) ? Math.round((1 - s.n / prev) * 100) : 0;
          drop = '<div class="ad-fdrop">↓ ' + (prev > 0 ? dv + '% drop-off' : '—') + '</div>';
        }
        return drop +
          '<div class="ad-frow"><div class="ad-frow__top"><span class="ad-frow__k">' + esc(s.k) + '</span><span class="ad-frow__n">' + s.n + ' · ' + pctVis + '%</span></div>' +
          '<div class="ad-hbar__track ad-ftrack"><span class="ad-hbar__fill" style="width:' + Math.max(pctTop, 2).toFixed(1) + '%"></span></div></div>';
      }).join('');
      var conv = top ? (purchases / top) * 100 : 0;
      var browseDrop = funnel.visit ? Math.round((1 - (funnel.product_view || 0) / funnel.visit) * 100) : 0;
      var payDrop = funnel.payment_start ? Math.round((1 - purchases / funnel.payment_start) * 100) : 0;
      body.innerHTML =
        revTiles([
          { n: String(funnel.visit || 0), k: 'Visitors · ' + funnel.days + 'd', d: 'sessions' },
          { n: String(funnel.add_to_cart || 0), k: 'Added to bag', d: '' },
          { n: String(funnel.payment_start || 0), k: 'Reached payment', d: '' },
          { n: (conv ? conv.toFixed(1) : '0') + '%', k: 'Conversion', d: 'visitor → order' },
        ]) +
        '<div class="ad-panel ad-chartcard"><div class="ad-chart-h"><span class="ad-panel__t">Where visitors go — and drop off</span><span class="ad-chart-sub">last ' + funnel.days + ' days</span></div><div class="ad-funnel">' + rows + '</div></div>' +
        (totalEvents === 0
          ? '<p class="ad-oppnote">Tracking just went live — this fills in as visitors browse the site. Check back in a day or two.</p>'
          : '<p class="ad-oppnote">' + esc(browseDrop + '% leave after landing without opening a product, and ' + payDrop + '% who reach payment don’t finish — those are the two biggest leaks to fix.') + '</p>');
    }

    // ── Fulfilment & payments ─────────────────────────────────────────────────
    function fmtDelivery(s) {
      s = String(s || '').toUpperCase();
      var map = { IN_TRANSIT: 'In transit', OUT_FOR_DELIVERY: 'Out for delivery', ATTEMPTED_DELIVERY: 'Delivery attempted', READY_FOR_PICKUP: 'Ready for pickup', PICKED_UP: 'Picked up', DELIVERED: 'Delivered', LABEL_PRINTED: 'Label printed', LABEL_PURCHASED: 'Label ready' };
      return map[s] || (s ? s.charAt(0) + s.slice(1).toLowerCase().replace(/_/g, ' ') : '');
    }
    function fmtFinancial(s) {
      s = String(s || '').toUpperCase();
      var map = { PENDING: 'Payment pending', AUTHORIZED: 'Authorised — not captured', PARTIALLY_PAID: 'Partially paid', PARTIALLY_REFUNDED: 'Partially refunded', REFUNDED: 'Refunded', VOIDED: 'Voided', PAID: 'Paid' };
      return map[s] || (s ? s.charAt(0) + s.slice(1).toLowerCase().replace(/_/g, ' ') : '—');
    }
    function opsRows(rows, kind) {
      return rows.map(function (o) {
        var tel = (o.phone || '').replace(/[^0-9]/g, '');
        var status;
        if (kind === 'payment') status = '<span class="ad-pill ad-pill--wait">' + esc(fmtFinancial(o.financial)) + '</span>';
        else if (kind === 'transit') { var eta = o.etaAt ? ' · ETA ' + when(o.etaAt) : ''; status = '<span class="ad-pill ad-pill--good">' + esc((fmtDelivery(o.deliveryStatus) || 'In transit') + eta) + '</span>'; }
        else if (kind === 'delivered') { var dt = o.deliveredAt || o.fulfilledAt; status = '<span class="ad-pill ad-pill--done">' + esc((o.deliveredAt ? 'Delivered' : 'Fulfilled') + (dt ? ' · ' + when(dt) : '')) + '</span>'; }
        else status = '<span class="ad-pill ad-pill--wait">To fulfil</span>';
        var acts = [];
        if (kind === 'payment' && tel) acts.push('<a class="ad-link" href="https://wa.me/' + tel + '" target="_blank" rel="noopener">Chase</a>');
        if (o.adminUrl) acts.push('<a class="ad-link" href="' + esc(o.adminUrl) + '" target="_blank" rel="noopener">Open →</a>');
        return '<tr><td class="nm">' + esc(o.customer || 'Guest') + (o.phone ? '<div class="sub">' + esc(o.phone) + '</div>' : '') + '</td><td>' + esc(o.name) + '</td><td>' + esc(o.items || '—') + '</td><td>' + when(o.createdAt) + '</td><td class="r amt">' + esc(inr(o.total && o.total.amount, o.total && o.total.currencyCode)) + '</td><td>' + status + '</td><td class="r">' + acts.join(' ') + '</td></tr>';
      }).join('');
    }
    function opsPanel(title, count, rowsHtml, emptyMsg) {
      return '<div class="ad-panel"><div class="ad-panel__h"><span class="ad-panel__t">' + esc(title) + '</span><span class="ad-chart-sub">' + count + (count === 1 ? ' order' : ' orders') + '</span></div>' +
        (rowsHtml
          ? '<div class="ad-scroll"><table class="ad-table"><thead><tr><th>Customer</th><th>Order</th><th>Items</th><th>Date</th><th class="r">Total</th><th>Status</th><th></th></tr></thead><tbody>' + rowsHtml + '</tbody></table></div>'
          : '<p class="ad-note ad-pad">' + esc(emptyMsg) + '</p>') + '</div>';
    }
    function renderFulfilment(orders) {
      var body = $('fulfilBody');
      if (!body) return;
      var live = orders.filter(function (o) { return !o.cancelled; });
      var transit = ['IN_TRANSIT', 'OUT_FOR_DELIVERY', 'ATTEMPTED_DELIVERY', 'READY_FOR_PICKUP'];
      var inTransit = live.filter(function (o) { return transit.indexOf(String(o.deliveryStatus || '').toUpperCase()) > -1; });
      var toFulfil = live.filter(function (o) {
        var f = String(o.fulfillment || '').toUpperCase();
        var unshipped = (f === '' || f === 'UNFULFILLED' || f === 'PARTIALLY_FULFILLED' || f === 'PENDING_FULFILLMENT' || f === 'OPEN' || f === 'IN_PROGRESS' || f === 'ON_HOLD' || f === 'SCHEDULED');
        return unshipped && inTransit.indexOf(o) === -1;
      });
      var payPending = live.filter(function (o) {
        return ['PENDING', 'AUTHORIZED', 'PARTIALLY_PAID'].indexOf(String(o.financial || '').toUpperCase()) > -1;
      });
      var doneDate = function (o) { return new Date(o.deliveredAt || o.fulfilledAt || o.createdAt).getTime(); };
      var fulfilled = live.filter(function (o) { return String(o.fulfillment || '').toUpperCase() === 'FULFILLED' || o.deliveredAt; })
        .sort(function (a, b) { return doneDate(b) - doneDate(a); });
      body.innerHTML =
        opsPanel('Orders to fulfil', toFulfil.length, opsRows(toFulfil, 'fulfil'), 'Nothing waiting to be fulfilled — you’re all caught up.') +
        opsPanel('In transit / out for delivery', inTransit.length, opsRows(inTransit, 'transit'), 'No shipments in transit. This fills in when you fulfil orders with a tracking number in Shopify.') +
        opsPanel('Fulfilled &amp; delivered', fulfilled.length, opsRows(fulfilled, 'delivered'), 'No fulfilled orders yet.') +
        opsPanel('Payments pending', payPending.length, opsRows(payPending, 'payment'), 'No pending payments — everything is paid.');
      var ids = {};
      toFulfil.concat(payPending).forEach(function (o) { ids[o.id] = 1; });
      var badge = Object.keys(ids).length;
      var nb = $('nFulfil'); if (nb) nb.textContent = badge ? String(badge) : '';
    }

    // ── Revenue insights (charts) ─────────────────────────────────────────────
    function money0(n, cur) { return inr(String(Math.round(Number(n) || 0)), cur || 'INR'); }
    function niceCeil(v) {
      if (v <= 0) return 0;
      var pow = Math.pow(10, Math.floor(Math.log(v) / Math.LN10));
      var n = v / pow;
      var nice = n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10;
      return nice * pow;
    }
    function revTiles(list) {
      return '<div class="ad-kpis ad-kpis--rev">' + list.map(function (x) {
        return '<div class="ad-kpi"><span class="ad-kpi__n">' + esc(x.n) + '</span><span class="ad-kpi__k">' + esc(x.k) + '</span>' + (x.d ? '<span class="ad-kpi__d">' + esc(x.d) + '</span>' : '') + '</div>';
      }).join('') + '</div>';
    }
    function dailyChart(days, cur) {
      var W = 720, H = 240, padL = 6, padR = 6, padT = 16, padB = 24;
      var plotW = W - padL - padR, plotH = H - padT - padB;
      var max = niceCeil(Math.max.apply(null, days.map(function (d) { return d.amount; }).concat([1])));
      var n = days.length, step = plotW / n, gap = Math.min(4, step * 0.25), bw = Math.max(step - gap, 1);
      var bars = days.map(function (d, i) {
        var h = max ? (d.amount / max) * plotH : 0;
        var x = padL + i * step, y = padT + plotH - h;
        var lbl = d.label.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' });
        return '<rect x="' + x.toFixed(1) + '" y="' + y.toFixed(1) + '" width="' + bw.toFixed(1) + '" height="' + Math.max(h, 0).toFixed(1) + '" rx="2" class="ad-bar"><title>' + esc(lbl + ' — ' + (d.amount ? money0(d.amount, cur) : 'no sales')) + '</title></rect>';
      }).join('');
      var grid = [0, 0.5, 1].map(function (f) {
        var y = padT + plotH - f * plotH;
        return '<line x1="' + padL + '" y1="' + y.toFixed(1) + '" x2="' + (W - padR) + '" y2="' + y.toFixed(1) + '" class="ad-grid"/>' +
          '<text x="' + padL + '" y="' + (y - 4).toFixed(1) + '" class="ad-glabel">' + esc(money0(max * f, cur)) + '</text>';
      }).join('');
      var xl = [0, Math.floor(n / 2), n - 1].map(function (i) {
        var x = padL + i * step + bw / 2;
        var anchor = i === 0 ? 'start' : (i === n - 1 ? 'end' : 'middle');
        return '<text x="' + x.toFixed(1) + '" y="' + (H - 7) + '" class="ad-xlabel" text-anchor="' + anchor + '">' + esc(days[i].label.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })) + '</text>';
      }).join('');
      return '<div class="ad-panel ad-chartcard"><div class="ad-chart-h"><span class="ad-panel__t">Revenue — last 30 days</span><span class="ad-chart-sub">hover a bar for the day</span></div>' +
        '<div class="ad-chartwrap"><svg viewBox="0 0 ' + W + ' ' + H + '" class="ad-svg" role="img" aria-label="Daily revenue for the last 30 days">' + grid + bars + xl + '</svg></div></div>';
    }
    function hbars(title, sub, rows) {
      if (!rows) return '';
      return '<div class="ad-panel ad-chartcard"><div class="ad-chart-h"><span class="ad-panel__t">' + esc(title) + '</span>' + (sub ? '<span class="ad-chart-sub">' + esc(sub) + '</span>' : '') + '</div><div class="ad-hbars">' + rows + '</div></div>';
    }
    function hbarRow(name, valText, pct, cls) {
      return '<div class="ad-hbar"><span class="ad-hbar__name">' + esc(name) + '</span>' +
        '<span class="ad-hbar__track"><span class="ad-hbar__fill ' + (cls || '') + '" style="width:' + Math.max(pct, 2).toFixed(1) + '%"></span></span>' +
        '<span class="ad-hbar__val">' + esc(valText) + '</span></div>';
    }
    function renderRevenue(orders, abandoned) {
      var body = $('revenueBody');
      if (!body) return;
      var now = Date.now(), DAY = 864e5;
      var cur = (orders[0] && orders[0].total && orders[0].total.currencyCode) || 'INR';
      var live = orders.filter(function (o) { return !o.cancelled; });
      var in30 = live.filter(function (o) { var t = new Date(o.createdAt).getTime(); return isFinite(t) && now - t <= 30 * DAY; });
      var rev30 = in30.reduce(function (s, o) { return s + Number((o.total && o.total.amount) || 0); }, 0);
      var aov = in30.length ? rev30 / in30.length : 0;
      var pending = live.filter(function (o) { return String(o.financial || '').toUpperCase() !== 'PAID'; }).length;
      var abVal = (abandoned || []).reduce(function (s, a) { return s + Number((a.total && a.total.amount) || 0); }, 0);

      var start = new Date(); start.setHours(0, 0, 0, 0);
      var days = [];
      for (var i = 29; i >= 0; i--) { var d = new Date(start.getTime() - i * DAY); days.push({ t: d.getTime(), label: d, amount: 0 }); }
      in30.forEach(function (o) {
        var t = new Date(o.createdAt); t.setHours(0, 0, 0, 0);
        for (var j = 0; j < days.length; j++) { if (days[j].t === t.getTime()) { days[j].amount += Number((o.total && o.total.amount) || 0); break; } }
      });

      var bagMap = {};
      live.forEach(function (o) {
        String(o.items || '').split(',').forEach(function (part) {
          var m = part.trim().match(/^(\d+)\s*[^\w\s]?\s*(.+)$/);
          if (m) { var nm = m[2].trim(); bagMap[nm] = (bagMap[nm] || 0) + parseInt(m[1], 10); }
        });
      });
      var bags = Object.keys(bagMap).map(function (k) { return { name: k, qty: bagMap[k] }; }).sort(function (a, b) { return b.qty - a.qty; }).slice(0, 6);
      var bagMax = bags.length ? bags[0].qty : 1;

      if (!live.length) { body.innerHTML = '<div class="ad-panel"><p class="ad-note ad-pad">No orders yet to chart.</p></div>'; return; }

      var oppMax = Math.max(rev30, abVal, 1);
      body.innerHTML =
        revTiles([
          { n: money0(rev30, cur), k: 'Revenue · 30 days', d: in30.length + ' orders' },
          { n: money0(aov, cur), k: 'Avg order value', d: '' },
          { n: money0(abVal, cur), k: 'Abandoned value', d: 'at risk' },
          { n: String(pending), k: 'Awaiting payment', d: 'of ' + live.length + ' orders' },
        ]) +
        dailyChart(days, cur) +
        hbars('Best-selling bags', 'by units sold (recent orders)', bags.map(function (b) { return hbarRow(b.name, b.qty + (b.qty === 1 ? ' unit' : ' units'), (b.qty / bagMax) * 100, ''); }).join('')) +
        hbars('Captured vs. left behind', 'last 30 days', hbarRow('Captured revenue', money0(rev30, cur), (rev30 / oppMax) * 100, 'ad-fill--good') + hbarRow('Abandoned carts', money0(abVal, cur), (abVal / oppMax) * 100, 'ad-fill--warn')) +
        '<p class="ad-oppnote">' + esc(money0(abVal, cur)) + ' is sitting in abandoned checkouts — reach those customers from the Abandoned tab to recover it.</p>';
    }

    // Calls the founders' data feed with the given auth header. Returns the HTTP
    // status alongside the parsed body so callers can tell "wrong credential" (401)
    // from a network failure (0), and render or message accordingly.
    function callData(headers) {
      return fetch('/api/admin/data', { headers: headers })
        .then(function (r) { return r.json().then(function (j) { return { status: r.status, data: r.ok ? j : null }; }, function () { return { status: r.status, data: null }; }); })
        .catch(function () { return { status: 0, data: null }; });
    }

    function showGate() { $('gate').hidden = false; }
    function setStatus(msg) { var s = $('signinStatus'); if (s) s.textContent = msg || ''; }

    // Security: always require an explicit sign-in on every visit. Never auto-enter
    // from a stored secret or a lingering session — the gate is the only way in, and
    // the dashboard is not rendered (and no data is fetched) until auth succeeds.
    function init() {
      try { localStorage.removeItem(LS); } catch (e) {} // purge any passcode a prior build stored
      showGate();
    }

    // ── Google sign-in (primary) ──────────────────────────────────────────────
    $('googleBtn').addEventListener('click', async function () {
      var btn = $('googleBtn'); btn.disabled = true;
      setStatus('Opening Google…');
      try {
        var user = await signInWithGoogle();
        if (!user) { setStatus('Google sign-in is unavailable — use a passcode instead.'); btn.disabled = false; return; }
        setStatus('Signing in…');
        var token = await getIdToken(true);
        var r = await callData({ Authorization: 'Bearer ' + token });
        if (r.data) { AUTH = { kind: 'token' }; render(r.data); return; }
        if (r.status === 401) { setStatus('That Google account isn’t an admin.'); await signOut().catch(function () {}); }
        else { setStatus('Could not load the dashboard — please try again.'); }
        btn.disabled = false;
      } catch (err) {
        var code = (err && err.code) || '';
        if (code === 'auth/popup-closed-by-user' || code === 'auth/cancelled-popup-request') setStatus('Sign-in cancelled.');
        else if (code === 'auth/unauthorized-domain') setStatus('This domain isn’t authorised in Firebase yet.');
        else setStatus('Sign-in failed' + (code ? ' (' + code + ')' : '') + '.');
        btn.disabled = false;
      }
    });

    // ── Passcode fallback ─────────────────────────────────────────────────────
    $('usePass').addEventListener('click', function () {
      $('gateForm').hidden = false;
      $('usePass').hidden = true;
      $('passInput').focus();
    });

    $('gateForm').addEventListener('submit', async function (e) {
      e.preventDefault();
      var key = ($('passInput').value || '').trim();
      if (!key) return;
      setStatus('Checking…');
      var btn = $('enterBtn'); btn.disabled = true;
      var r = await callData({ 'x-admin-key': key });
      if (!r.data) { setStatus('Wrong passcode — try again.'); btn.disabled = false; return; }
      AUTH = { kind: 'key', key: key }; // in memory for this session only — never persisted
      render(r.data);
    });

    $('lockBtn').addEventListener('click', async function () {
      try { localStorage.removeItem(LS); } catch (e) {}
      try { await signOut(); } catch (e) {}
      location.reload();
    });

    // ── Abandoned-checkout detail drawer ──────────────────────────────────────
    function addr(a) {
      if (!a) return '<span class="ad-dv">—</span>';
      var lines = [a.name, a.address1, a.address2, [a.city, a.province, a.zip].filter(Boolean).join(', '), a.country].filter(Boolean);
      return lines.map(function (l) { return esc(l); }).join('<br>') || '<span class="ad-dv">—</span>';
    }
    function buildDrawer(r) {
      var d = r.detail || {};
      var when2 = when(r.createdAt, true);
      var telDigits = (r.phone || '').replace(/[^0-9]/g, '');
      var lineRows = (d.lines || []).map(function (l) {
        var unit = inr(l.price && l.price.amount, l.price && l.price.currencyCode);
        var lineTot = l.price ? inr(String(Number(l.price.amount) * l.quantity), l.price.currencyCode) : '—';
        return '<tr><td class="nm">' + esc(l.title) + (l.variant ? '<div class="sub">' + esc(l.variant) + '</div>' : '') + '</td><td class="r">' + l.quantity + ' × ' + esc(unit) + '</td><td class="r amt">' + esc(lineTot) + '</td></tr>';
      }).join('');
      var money = function (label, m, strong) {
        return '<div class="ad-tot' + (strong ? ' ad-tot--strong' : '') + '"><span>' + label + '</span><span>' + esc(m ? inr(m.amount, m.currencyCode) : '—') + '</span></div>';
      };
      var actions = [];
      if (d.adminUrl) actions.push('<a class="ad-dbtn ad-dbtn--fill" href="' + esc(d.adminUrl) + '" target="_blank" rel="noopener">Open in Shopify →</a>');
      if (telDigits) actions.push('<a class="ad-dbtn" href="https://wa.me/' + telDigits + '" target="_blank" rel="noopener">WhatsApp</a>');
      if (telDigits) actions.push('<a class="ad-dbtn" href="tel:+' + telDigits + '">Call</a>');
      if (r.email) actions.push('<a class="ad-dbtn" href="mailto:' + esc(r.email) + '">Email</a>');

      return '' +
        '<div class="ad-dhead">' +
          '<span class="ad-pill ad-pill--cancel">Abandoned at payment</span>' +
          '<h2 class="ad-display ad-dtitle">' + esc(r.customer || 'Unknown customer') + '</h2>' +
          '<p class="ad-dmeta">' + esc(r.name) + ' · ' + when2 + '</p>' +
        '</div>' +
        (actions.length ? '<div class="ad-dactions">' + actions.join('') + '</div>' : '') +
        '<div class="ad-dsect"><h3 class="ad-dh3">Contact</h3>' +
          '<div class="ad-drow"><span class="ad-dk">Email</span><span class="ad-dvv">' + (r.email ? esc(r.email) : '<span class="ad-dv">—</span>') + '</span></div>' +
          '<div class="ad-drow"><span class="ad-dk">Phone</span><span class="ad-dvv">' + (r.phone ? esc(r.phone) : '<span class="ad-dv">—</span>') + '</span></div>' +
        '</div>' +
        '<div class="ad-dsect"><h3 class="ad-dh3">Shipping address</h3><p class="ad-daddr">' + addr(d.address) + '</p></div>' +
        '<div class="ad-dsect"><h3 class="ad-dh3">Items</h3>' +
          '<table class="ad-dtable"><tbody>' + (lineRows || '<tr><td class="ad-dv">No items</td></tr>') + '</tbody></table>' +
          '<div class="ad-tots">' + money('Subtotal', d.subtotal) + money('Shipping', d.shipping) + money('Total', d.total, true) + '</div>' +
        '</div>' +
        (d.tags && d.tags.length ? '<div class="ad-dsect"><h3 class="ad-dh3">Tags</h3><p class="ad-dtags">' + d.tags.map(function (t) { return '<span class="ad-tag">' + esc(t) + '</span>'; }).join('') + '</p></div>' : '');
    }
    // ── Home-demo detail + confirm/complete ───────────────────────────────────
    function fmtISO(iso) {
      if (!iso) return '';
      try { return new Date(iso + 'T00:00').toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }); }
      catch (e) { return iso; }
    }
    function fmt12(t) {
      if (!t) return '';
      var p = String(t).split(':'); var h = parseInt(p[0], 10); var m = p[1] || '00';
      if (isNaN(h)) return t;
      var ap = h >= 12 ? 'PM' : 'AM'; h = h % 12 || 12;
      return h + ':' + m + ' ' + ap;
    }
    function confirmMsg(r) {
      var name = (r.customer || 'there').split(' ')[0];
      var d = fmtISO(r.confirmedDate), t = fmt12(r.confirmedTime);
      var whenTxt = (d || r.date || '') + (t ? ' at ' + t : (r.slot ? ' (' + r.slot + ')' : ''));
      var subject = 'Your Mir Kash home demo is confirmed';
      var body = 'Hi ' + name + ',\n\nYour Mir Kash home demo is confirmed for ' + whenTxt + '.\n\n' +
        (r.address ? 'Address: ' + r.address + '\n' : '') +
        (r.bags ? "Bags we'll bring: " + r.bags + '\n' : '') +
        '\nWe look forward to meeting you. Just reply to this email or call us if anything changes.\n\nWarmly,\nMir Kash';
      var wa = 'Hi ' + name + ', your Mir Kash home demo is confirmed for ' + whenTxt + '.' +
        (r.address ? ' Address: ' + r.address + '.' : '') + ' See you then! — Mir Kash';
      return { subject: subject, body: body, wa: wa };
    }
    function buildDemoDrawer(r) {
      var status = r.status || 'requested';
      var bagsList = (r.bags || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean);
      var telDigits = (r.phone || '').replace(/[^0-9]/g, '');
      var m = confirmMsg(r);
      var notify = '';
      if (r.email) notify += '<a class="ad-dbtn ad-dbtn--fill" href="mailto:' + esc(r.email) + '?subject=' + encodeURIComponent(m.subject) + '&body=' + encodeURIComponent(m.body) + '">Email confirmation</a>';
      if (telDigits) notify += '<a class="ad-dbtn ad-dbtn--wa" href="https://wa.me/' + telDigits + '?text=' + encodeURIComponent(m.wa) + '" target="_blank" rel="noopener">WhatsApp</a>';

      var actionSect;
      if (status === 'requested') {
        actionSect =
          '<div class="ad-dsect ad-dact"><h3 class="ad-dh3">Confirm this demo</h3>' +
          '<p class="ad-reqnote">Requested: ' + esc(r.date || '—') + (r.slot ? ' · ' + esc(r.slot) : '') + '</p>' +
          '<div class="ad-form"><label class="ad-flabel">Date<input class="ad-finput" type="date" id="demoDate"></label>' +
          '<label class="ad-flabel">Time<input class="ad-finput" type="time" id="demoTime"></label></div>' +
          '<button class="ad-dbtn ad-dbtn--fill ad-dbtn--wide" id="demoConfirm" type="button">Confirm booking</button>' +
          '<p class="ad-actmsg" id="demoMsg"></p></div>';
      } else if (status === 'confirmed') {
        actionSect =
          '<div class="ad-dsect ad-dact"><h3 class="ad-dh3">Confirmed for</h3>' +
          '<p class="ad-confirmed">' + esc(fmtISO(r.confirmedDate)) + ' · ' + esc(fmt12(r.confirmedTime)) + '</p>' +
          '<p class="ad-note ad-notifynote">Send the customer their confirmation:</p>' +
          '<div class="ad-dactions">' + notify + '</div>' +
          '<button class="ad-dbtn ad-dbtn--wide" id="demoComplete" type="button">Mark demo complete</button>' +
          '<p class="ad-actmsg" id="demoMsg"></p></div>';
      } else {
        actionSect =
          '<div class="ad-dsect ad-dact"><h3 class="ad-dh3">Demo completed</h3>' +
          '<p class="ad-confirmed">' + (r.confirmedDate ? esc(fmtISO(r.confirmedDate)) + (r.confirmedTime ? ' · ' + esc(fmt12(r.confirmedTime)) : '') : 'Marked complete') + '</p>' +
          (notify ? '<div class="ad-dactions">' + notify + '</div>' : '') + '</div>';
      }

      var footer = [];
      if (r.adminUrl) footer.push('<a class="ad-dbtn" href="' + esc(r.adminUrl) + '" target="_blank" rel="noopener">Open in Shopify →</a>');
      if (telDigits) footer.push('<a class="ad-dbtn" href="tel:+' + telDigits + '">Call</a>');

      return '' +
        '<div class="ad-dhead">' + demoPill(status) +
          '<h2 class="ad-display ad-dtitle">' + esc(r.customer || 'Guest') + '</h2>' +
          '<p class="ad-dmeta">' + esc(r.name) + ' · Booked ' + when(r.createdAt) + '</p>' +
        '</div>' +
        actionSect +
        '<div class="ad-dsect"><h3 class="ad-dh3">Contact</h3>' +
          '<div class="ad-drow"><span class="ad-dk">Email</span><span class="ad-dvv">' + (r.email ? esc(r.email) : '<span class="ad-dv">—</span>') + '</span></div>' +
          '<div class="ad-drow"><span class="ad-dk">Phone</span><span class="ad-dvv">' + (r.phone ? esc(r.phone) : '<span class="ad-dv">—</span>') + '</span></div>' +
        '</div>' +
        '<div class="ad-dsect"><h3 class="ad-dh3">Requested slot</h3><p class="ad-daddr">' + esc(r.date || '—') + (r.slot ? '<br>' + esc(r.slot) : '') + '</p></div>' +
        '<div class="ad-dsect"><h3 class="ad-dh3">Bags to show</h3>' + (bagsList.length ? '<ul class="ad-baglist">' + bagsList.map(function (b) { return '<li>' + esc(b) + '</li>'; }).join('') + '</ul>' : '<p class="ad-dv">—</p>') + '</div>' +
        '<div class="ad-dsect"><h3 class="ad-dh3">Address</h3><p class="ad-daddr">' + (r.address ? esc(r.address) : '<span class="ad-dv">—</span>') + '</p></div>' +
        (footer.length ? '<div class="ad-dactions">' + footer.join('') + '</div>' : '');
    }
    function demoMsg(t) { var el = $('demoMsg'); if (el) el.textContent = t || ''; }
    async function doDemoAction(idx, payload, btn) {
      var r = DEMOS[idx]; if (!r) return;
      demoMsg('Saving…'); if (btn) btn.disabled = true;
      var headers = await authHeaders();
      if (!headers) { demoMsg('Session expired — reload and sign in again.'); if (btn) btn.disabled = false; return; }
      headers['Content-Type'] = 'application/json';
      try {
        var resp = await fetch('/api/admin/demo', { method: 'POST', headers: headers, body: JSON.stringify(Object.assign({ id: r.id }, payload)) });
        var res = await resp.json().catch(function () { return null; });
        if (!resp.ok || !res || !res.ok) { demoMsg((res && res.error) || 'Could not save — try again.'); if (btn) btn.disabled = false; return; }
        if (payload.action === 'confirm') { r.status = 'confirmed'; r.confirmedDate = res.confirmedDate; r.confirmedTime = res.confirmedTime; }
        else if (payload.action === 'complete') { r.status = 'completed'; }
        $('allDemos').innerHTML = demosTable(DEMOS);
        openDrawer('demo', idx);
      } catch (e) { demoMsg('Network error — try again.'); if (btn) btn.disabled = false; }
    }
    function wireDemoActions(idx) {
      var c = $('demoConfirm');
      if (c) c.addEventListener('click', function () {
        var date = ($('demoDate') || {}).value || '';
        var time = ($('demoTime') || {}).value || '';
        if (!date || !time) { demoMsg('Pick a date and time first.'); return; }
        doDemoAction(idx, { action: 'confirm', date: date, time: time }, c);
      });
      var k = $('demoComplete');
      if (k) k.addEventListener('click', function () { doDemoAction(idx, { action: 'complete' }, k); });
    }

    function openDrawer(kind, idx) {
      var r = (kind === 'demo' ? DEMOS : ABANDONED)[idx];
      if (!r) return;
      $('drawerBody').innerHTML = (kind === 'demo') ? buildDemoDrawer(r) : buildDrawer(r);
      $('drawerBody').scrollTop = 0;
      $('drawer').hidden = false;
      document.body.style.overflow = 'hidden';
      if (kind === 'demo') wireDemoActions(idx);
    }
    function closeDrawer() {
      $('drawer').hidden = true;
      document.body.style.overflow = '';
    }
    $('allAband').addEventListener('click', function (e) {
      var tr = e.target.closest ? e.target.closest('tr[data-idx]') : null;
      if (tr) openDrawer('abandoned', Number(tr.getAttribute('data-idx')));
    });
    $('allDemos').addEventListener('click', function (e) {
      var tr = e.target.closest ? e.target.closest('tr[data-idx]') : null;
      if (tr) openDrawer('demo', Number(tr.getAttribute('data-idx')));
    });
    $('drawerClose').addEventListener('click', closeDrawer);
    $('drawerScrim').addEventListener('click', closeDrawer);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !$('drawer').hidden) closeDrawer(); });

    init();
  })();
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap');
  :root { --cherry: #8B1A1A; --depth: #2C1A0E; }
  body { background: #fff; }
  .site-header, .brand-ticker, .page-header { display: none !important; }

  .ad {
    --serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --cream: #F6F1E9; --ink: #40382f; --mid: #6a655d; --faint: #a79f92; --rule: #e2dac9;
    --good: #2f6b3f; --warn: #a86a1e;
    font-family: 'Jost', sans-serif; color: var(--depth); background: #fbfaf7; min-height: 100vh;
  }
  .ad-display { font-family: var(--serif); font-weight: 300; letter-spacing: 0; }
  .ad-eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--cherry); font-weight: 600; margin: 0 0 14px; }
  .ad-note { color: var(--mid); font-size: 14px; }

  /* Gate */
  .ad-gate { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px; }
  .ad-gate__card { background: #fff; border: 1px solid var(--rule); border-radius: 6px; padding: clamp(36px,5vw,56px); text-align: center; max-width: 420px; width: 100%; }
  .ad-gate__h { font-size: clamp(26px,3.4vw,38px); color: var(--depth); margin: 0 0 12px; }
  .ad-gate__p { font-size: 14px; color: var(--mid); line-height: 1.6; margin: 0 auto 24px; max-width: 34ch; }
  .ad-google { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; height: 52px; background: var(--depth); color: #fff; border: none; cursor: pointer; font-family: 'Jost', sans-serif; font-size: 13px; letter-spacing: .06em; font-weight: 600; transition: background .2s; }
  .ad-google:hover { background: var(--cherry); }
  .ad-google:disabled { opacity: .6; cursor: default; }
  .ad-google__g { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: #fff; color: var(--depth); font-family: var(--serif); font-weight: 500; font-size: 15px; line-height: 1; }
  .ad-altlink { display: inline-block; margin: 18px auto 0; background: none; border: none; cursor: pointer; font-family: 'Jost', sans-serif; font-size: 11.5px; letter-spacing: .04em; color: var(--faint); text-decoration: underline; text-underline-offset: 3px; }
  .ad-altlink:hover { color: var(--mid); }
  .ad-pass { margin-top: 16px; }
  .ad-input { width: 100%; border: 1px solid var(--rule); background: #fff; padding: 14px 16px; font-family: 'Jost', sans-serif; font-size: 15px; color: var(--depth); text-align: center; letter-spacing: .04em; outline: none; margin-bottom: 12px; }
  .ad-input:focus { border-color: var(--depth); }
  .ad-enter { width: 100%; height: 50px; background: var(--depth); color: #fff; border: none; cursor: pointer; font-family: 'Jost', sans-serif; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; transition: background .2s; }
  .ad-enter:hover { background: var(--cherry); }
  .ad-enter:disabled { opacity: .6; cursor: default; }
  .ad-signin-status { font-size: 12.5px; color: var(--cherry); margin: 14px 0 0; min-height: 16px; }

  /* Shell */
  .ad-shell { display: grid; grid-template-columns: 216px 1fr; min-height: 100vh; }
  /* An explicit display: (grid/flex) beats the UA [hidden] rule, so force it: the
