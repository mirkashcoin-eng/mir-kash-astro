---
import { firebaseConfigured } from '~/lib/firebaseClient';
const ready = firebaseConfigured();
---
<header class="ad-head">
  <a href="/" class="ad-logo" aria-label="Mir Kash"><img src="/mir-kash-logo.webp" alt="Mir Kash" /></a>
  <span class="ad-head__tag">Founders' dashboard</span>
  <button class="ad-signout" id="signoutBtn" type="button" hidden>Sign out</button>
</header>

<main class="ad">
  <div class="ad__wrap">
    {!ready && <p class="ad-note">Sign-in isn’t configured yet. Please check back soon.</p>}

    <!-- Signed out -->
    <section class="ad-gate" id="gate" hidden>
      <p class="ad-eyebrow">Founders only</p>
      <h1 class="ad-display ad-gate__h">Sign in to your dashboard</h1>
      <p class="ad-gate__p">Abandoned checkouts, leads and home-demo bookings — all in one place.</p>
      <button class="g-btn" id="googleBtn" type="button">
        <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
        Continue with Google
      </button>
    </section>

    <!-- Not authorised -->
    <section class="ad-denied" id="denied" hidden>
      <p class="ad-eyebrow">Restricted</p>
      <h1 class="ad-display ad-gate__h">Not authorised</h1>
      <p class="ad-gate__p">This account isn’t on the founders' list. <span id="deniedWho"></span></p>
    </section>

    <!-- Dashboard -->
    <section id="dash" hidden>
      <p class="ad-eyebrow">Overview</p>
      <h1 class="ad-display ad-title">Dashboard</h1>
      <p class="ad-who" id="who"></p>

      <div class="ad-kpis" id="kpis"></div>

      <h2 class="ad-h2">Abandoned checkouts &amp; leads</h2>
      <div class="ad-list" id="abandoned"><p class="ad-note" id="abLoading">Loading…</p></div>

      <h2 class="ad-h2">Home-demo bookings</h2>
      <div class="ad-list" id="demos"><p class="ad-note" id="demoLoading">Loading…</p></div>
    </section>
  </div>
</main>

<script>
  import { getSessionUser, getIdToken, signInWithGoogle, signOut, getCheckoutLeads } from '~/lib/firebaseClient';

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const inr = (amount?: string | null, cur = 'INR') => {
    if (amount == null) return '—';
    const n = Math.round(Number(amount));
    try { return new Intl.NumberFormat('en-IN', { style: 'currency', currency: cur, maximumFractionDigits: 0 }).format(n); }
    catch { return cur + ' ' + n; }
  };
  const when = (iso?: string | null) => {
    if (!iso) return '—';
    try { return new Date(iso).toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }); }
    catch { return iso; }
  };
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  const contact = (email?: string | null, phone?: string | null) =>
    [email ? esc(email) : '', phone ? esc(phone) : ''].filter(Boolean).join(' · ') || '—';

  async function init() {
    const user = await getSessionUser();
    if (!user) { $('gate').hidden = false; return; }
    $('signoutBtn').hidden = false;

    let token = await getIdToken();
    let res = await fetch('/api/admin/data', { headers: { Authorization: 'Bearer ' + token } });
    if (res.status === 401) { token = await getIdToken(true); res = await fetch('/api/admin/data', { headers: { Authorization: 'Bearer ' + token } }); }

    if (res.status === 403) {
      $('denied').hidden = false;
      $('deniedWho').textContent = 'Signed in as ' + (user.email ?? '') + '.';
      return;
    }
    if (!res.ok) { $('gate').hidden = false; return; }

    $('dash').hidden = false;
    $('who').textContent = 'Signed in as ' + (user.email ?? 'your account');

    const data = await res.json();
    const demos = data.demos || [];
    const abandoned = data.abandoned || [];
    const leads = await getCheckoutLeads(100).catch(() => []);

    renderKpis(abandoned.length + leads.length, demos.length);
    renderAbandoned(abandoned, leads);
    renderDemos(demos);
  }

  function renderKpis(dropoffs: number, demoCount: number) {
    $('kpis').innerHTML = `
      <div class="ad-kpi"><span class="ad-kpi__n">${dropoffs}</span><span class="ad-kpi__k">Abandoned / leads</span></div>
      <div class="ad-kpi"><span class="ad-kpi__n">${demoCount}</span><span class="ad-kpi__k">Home-demo bookings</span></div>`;
  }

  function renderAbandoned(abandoned: any[], leads: any[]) {
    const rows = [
      ...abandoned.map((a) => ({ src: 'Checkout', createdAt: a.createdAt, customer: a.customer, email: a.email, phone: a.phone, detail: a.items || '—', value: inr(a.total?.amount, a.total?.currencyCode), url: a.recoveryUrl })),
      ...leads.map((l: any) => ({ src: 'Lead · India', createdAt: l.createdAt, customer: null, email: l.email, phone: l.phone, detail: '—', value: '—', url: null })),
    ].sort((x, y) => String(y.createdAt || '').localeCompare(String(x.createdAt || '')));

    const box = $('abandoned');
    if (!rows.length) { box.innerHTML = '<p class="ad-note">No abandoned checkouts or leads yet.</p>'; return; }
    box.innerHTML = rows.map((r) => `
      <div class="ad-card">
        <div class="ad-card__top">
          <span class="ad-badge${r.src.startsWith('Lead') ? ' ad-badge--lead' : ''}">${esc(r.src)}</span>
          <span class="ad-card__when">${when(r.createdAt)}</span>
        </div>
        <div class="ad-card__name">${esc(r.customer || 'Unknown shopper')}</div>
        <div class="ad-card__meta">${contact(r.email, r.phone)}</div>
        <div class="ad-card__row"><span class="ad-card__detail">${esc(r.detail)}</span><span class="ad-card__val">${esc(r.value)}</span></div>
        ${r.url ? `<a class="ad-card__link" href="${esc(r.url)}" target="_blank" rel="noopener">Recovery link →</a>` : ''}
      </div>`).join('');
  }

  function renderDemos(demos: any[]) {
    const box = $('demos');
    if (!demos.length) { box.innerHTML = '<p class="ad-note">No home-demo bookings yet.</p>'; return; }
    box.innerHTML = demos.map((d) => `
      <div class="ad-card">
        <div class="ad-card__top">
          <span class="ad-badge ad-badge--demo">${esc(d.date || 'Demo')}${d.slot ? ' · ' + esc(d.slot) : ''}</span>
          <span class="ad-card__when">Booked ${when(d.createdAt)}</span>
        </div>
        <div class="ad-card__name">${esc(d.customer || 'Guest')}</div>
        <div class="ad-card__meta">${contact(d.email, d.phone)}</div>
        ${d.bags ? `<div class="ad-card__row"><span class="ad-card__detail">${esc(d.bags)}</span></div>` : ''}
        ${d.address ? `<div class="ad-card__addr">${esc(d.address)}</div>` : ''}
      </div>`).join('');
  }

  $('googleBtn')?.addEventListener('click', async () => {
    try { await signInWithGoogle(); location.reload(); }
    catch (e: any) { const c = e?.code || e?.message || 'unknown'; if (c !== 'auth/popup-closed-by-user' && c !== 'auth/cancelled-popup-request') alert('Sign-in failed: ' + c); }
  });
  $('signoutBtn')?.addEventListener('click', async () => { await signOut(); location.reload(); });

  init();
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap');
  :root { --cherry: #8B1A1A; --depth: #2C1A0E; }
  body { background: #fff; }

  .ad {
    --serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --cream: #F6F1E9; --ink: #40382f; --mid: #6a655d; --faint: #a79f92; --rule: #e2dac9;
    background: #fff; color: var(--depth); font-family: 'Jost', sans-serif;
    padding: clamp(30px,4vw,56px) 22px clamp(64px,8vw,110px);
  }
  .ad__wrap { max-width: 760px; margin: 0 auto; }
  .ad-display { font-family: var(--serif); font-weight: 300; letter-spacing: 0; }
  .ad-eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--cherry); font-weight: 600; margin: 0 0 14px; }
  .ad-note { color: var(--mid); font-size: 14px; line-height: 1.7; }

  .ad-head { display: flex; align-items: center; gap: 14px; max-width: 760px; margin: 0 auto; padding: 18px 22px; border-bottom: 1px solid var(--rule); }
  .ad-logo img { height: 18px; display: block; filter: brightness(0); }
  .ad-head__tag { font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--mid); font-weight: 600; }
  .ad-signout { margin-left: auto; background: none; border: none; cursor: pointer; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: var(--cherry); }

  /* Gate / denied */
  .ad-gate, .ad-denied { text-align: center; background: var(--cream); padding: clamp(40px,6vw,72px) clamp(24px,5vw,48px); margin-top: clamp(24px,4vw,40px); }
  .ad-gate__h { font-size: clamp(28px,4vw,42px); color: var(--depth); margin: 0 0 12px; }
  .ad-gate__p { font-size: 14.5px; color: var(--mid); max-width: 42ch; margin: 0 auto 26px; line-height: 1.6; }
  .g-btn { display: inline-flex; align-items: center; gap: 11px; height: 52px; padding: 0 26px; border: 1px solid var(--depth); background: #fff; cursor: pointer; font-family: 'Jost', sans-serif; font-size: 13px; font-weight: 600; color: var(--depth); transition: background .2s, color .2s; }
  .g-btn:hover { background: var(--depth); color: #fff; }

  /* Dashboard */
  .ad-title { font-size: clamp(32px,4.4vw,50px); line-height: 1.02; color: var(--depth); margin: 0 0 8px; }
  .ad-who { font-size: 13px; color: var(--mid); margin: 0 0 30px; }
  .ad-kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 20px; }
  .ad-kpi { border: 1px solid var(--rule); padding: 20px 22px; }
  .ad-kpi__n { display: block; font-family: var(--serif); font-weight: 300; font-size: 40px; line-height: 1; color: var(--depth); }
  .ad-kpi__k { display: block; font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--mid); font-weight: 600; margin-top: 8px; }
  .ad-h2 { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--mid); margin: 40px 0 16px; font-weight: 600; }

  .ad-list { display: flex; flex-direction: column; gap: 12px; }
  .ad-card { border: 1px solid var(--rule); padding: 16px 18px; }
  .ad-card__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
  .ad-badge { font-size: 9.5px; letter-spacing: .1em; text-transform: uppercase; font-weight: 600; color: var(--depth); background: var(--cream); padding: 5px 11px; border-radius: 999px; }
  .ad-badge--lead { color: var(--cherry); }
  .ad-badge--demo { color: #2f6b3f; }
  .ad-card__when { font-size: 11px; color: var(--faint); font-variant-numeric: tabular-nums; }
  .ad-card__name { font-family: var(--serif); font-weight: 400; font-size: 20px; color: var(--depth); line-height: 1.1; }
  .ad-card__meta { font-size: 13px; color: var(--mid); margin-top: 4px; }
  .ad-card__row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-top: 10px; }
  .ad-card__detail { font-size: 13px; color: var(--ink); }
  .ad-card__val { font-family: var(--serif); font-size: 18px; color: var(--depth); flex-shrink: 0; }
  .ad-card__addr { font-size: 12.5px; color: var(--mid); margin-top: 8px; line-height: 1.5; }
  .ad-card__link { display: inline-block; margin-top: 12px; font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; color: var(--depth); border-bottom: 1px solid var(--depth); padding-bottom: 2px; text-decoration: none; }
  .ad-card__link:hover { color: var(--cherry); border-color: var(--cherry); }

  @media (max-width: 480px) { .ad-kpis { grid-template-columns: 1fr; } }
</style>
