---
import { firebaseConfigured } from '~/lib/firebaseClient';
const ready = firebaseConfigured();
---
<main class="ad">
  {!ready && <p class="ad-note ad-center">Sign-in isn’t configured yet. Please check back soon.</p>}

  <!-- Signed out -->
  <section class="ad-gate" id="gate" hidden>
    <div class="ad-gate__card">
      <p class="ad-eyebrow">Founders only</p>
      <h1 class="ad-display ad-gate__h">Sign in to your dashboard</h1>
      <p class="ad-gate__p">Orders, abandoned checkouts, leads and home-demo bookings — all in one place.</p>
      <button class="g-btn" id="googleBtn" type="button">
        <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
        Continue with Google
      </button>
    </div>
  </section>

  <!-- Message (not authorised / auth error) -->
  <section class="ad-gate" id="denied" hidden>
    <div class="ad-gate__card">
      <p class="ad-eyebrow" id="denyKicker">Restricted</p>
      <h1 class="ad-display ad-gate__h" id="denyTitle">Not authorised</h1>
      <p class="ad-gate__p" id="denyMsg"></p>
      <button class="ad-textbtn" id="denyOut" type="button">Sign out &amp; try another account</button>
    </div>
  </section>

  <!-- Console -->
  <div class="ad-shell" id="shell" hidden>
    <nav class="ad-nav">
      <div class="ad-nav__logo">MIR KASH</div>
      <button class="ad-nav__item on" data-view="overview">Overview</button>
      <button class="ad-nav__item" data-view="orders">Recent orders <span class="ad-nav__n" id="nOrders"></span></button>
      <button class="ad-nav__item" data-view="abandoned">Abandoned &amp; leads <span class="ad-nav__n" id="nAband"></span></button>
      <button class="ad-nav__item" data-view="demos">Home demos <span class="ad-nav__n" id="nDemos"></span></button>
      <div class="ad-nav__foot">
        <span id="whoMini"></span>
        <button class="ad-nav__out" id="signoutBtn" type="button">Sign out</button>
      </div>
    </nav>

    <div class="ad-main">
      <!-- Overview -->
      <section class="ad-view" data-view="overview">
        <h1 class="ad-display ad-h1">Overview</h1>
        <div class="ad-kpis" id="kpis"></div>
        <div class="ad-panel">
          <div class="ad-panel__h"><span class="ad-panel__t">Recent orders</span><button class="ad-panel__more" data-view="orders" type="button">View all →</button></div>
          <div class="ad-scroll" id="ovOrders"></div>
        </div>
      </section>

      <!-- Recent orders -->
      <section class="ad-view" data-view="orders" hidden>
        <h1 class="ad-display ad-h1">Recent orders</h1>
        <div class="ad-panel"><div class="ad-scroll" id="allOrders"></div></div>
      </section>

      <!-- Abandoned & leads -->
      <section class="ad-view" data-view="abandoned" hidden>
        <h1 class="ad-display ad-h1">Abandoned checkouts &amp; leads</h1>
        <div class="ad-panel"><div class="ad-scroll" id="allAband"></div></div>
      </section>

      <!-- Home demos -->
      <section class="ad-view" data-view="demos" hidden>
        <h1 class="ad-display ad-h1">Home-demo bookings</h1>
        <div class="ad-panel"><div class="ad-scroll" id="allDemos"></div></div>
      </section>
    </div>
  </div>
</main>

<script>
  import { getSessionUser, getIdToken, signInWithGoogle, signOut, getCheckoutLeads } from '~/lib/firebaseClient';

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const inr = (amount?: string | null, cur = 'INR') => {
    if (amount == null) return '—';
    const n = Math.round(Number(amount));
    try { return new Intl.NumberFormat('en-IN', { style: 'currency', currency: cur, maximumFractionDigits: 0 }).format(n); }
    catch { return cur + ' ' + n; }
  };
  const when = (iso?: string | null, withTime = false) => {
    if (!iso) return '—';
    try { return new Date(iso).toLocaleDateString('en-IN', withTime ? { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' } : { day: 'numeric', month: 'short' }); }
    catch { return iso; }
  };
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  const contact = (email?: string | null, phone?: string | null) => [email ? esc(email) : '', phone ? esc(phone) : ''].filter(Boolean).join(' · ') || '—';

  function orderPill(o: any) {
    if (o.cancelled) return '<span class="ad-pill ad-pill--cancel">Cancelled</span>';
    const f = String(o.fulfillment || '').toUpperCase();
    if (f.includes('FULFILLED') && !f.includes('UNFULFILLED')) return '<span class="ad-pill ad-pill--good">Fulfilled</span>';
    const fin = String(o.financial || '').toUpperCase();
    const paid = fin === 'PAID' ? '' : ' · ' + (fin.charAt(0) + fin.slice(1).toLowerCase());
    return `<span class="ad-pill">Ordered${esc(paid)}</span>`;
  }

  function ordersTable(orders: any[]) {
    if (!orders.length) return '<p class="ad-note ad-pad">No orders yet.</p>';
    return `<table class="ad-table"><thead><tr><th>Customer</th><th>Order</th><th>Items</th><th>Date</th><th class="r">Total</th><th>Status</th></tr></thead><tbody>${orders.map((o) => `
      <tr><td class="nm">${esc(o.customer || 'Guest')}${o.email ? `<div class="sub">${esc(o.email)}</div>` : ''}</td>
      <td>${esc(o.name)}</td><td>${esc(o.items || '—')}</td><td>${when(o.createdAt)}</td>
      <td class="r amt">${esc(inr(o.total?.amount, o.total?.currencyCode))}</td><td>${orderPill(o)}</td></tr>`).join('')}</tbody></table>`;
  }

  function abandonedTable(rows: any[]) {
    if (!rows.length) return '<p class="ad-note ad-pad">No abandoned checkouts or leads yet.</p>';
    return `<table class="ad-table"><thead><tr><th>Source</th><th>Customer</th><th>Contact</th><th>Items</th><th class="r">Value</th><th>When</th><th></th></tr></thead><tbody>${rows.map((r) => `
      <tr><td><span class="ad-pill${r.src.startsWith('Lead') ? ' ad-pill--lead' : ' ad-pill--warn'}">${esc(r.src)}</span></td>
      <td class="nm">${esc(r.customer || 'Unknown')}</td><td class="sub">${contact(r.email, r.phone)}</td>
      <td>${esc(r.detail)}</td><td class="r amt">${esc(r.value)}</td><td>${when(r.createdAt, true)}</td>
      <td class="r">${r.url ? `<a class="ad-link" href="${esc(r.url)}" target="_blank" rel="noopener">Recover →</a>` : ''}</td></tr>`).join('')}</tbody></table>`;
  }

  function demosTable(demos: any[]) {
    if (!demos.length) return '<p class="ad-note ad-pad">No home-demo bookings yet.</p>';
    return `<table class="ad-table"><thead><tr><th>Customer</th><th>Date &amp; slot</th><th>Bags</th><th>Contact</th><th>Address</th><th>Booked</th></tr></thead><tbody>${demos.map((d) => `
      <tr><td class="nm">${esc(d.customer || 'Guest')}</td>
      <td>${esc(d.date || '—')}${d.slot ? `<div class="sub">${esc(d.slot)}</div>` : ''}</td>
      <td>${esc(d.bags || '—')}</td><td class="sub">${contact(d.email, d.phone)}</td>
      <td class="sub">${esc(d.address || '—')}</td><td>${when(d.createdAt)}</td></tr>`).join('')}</tbody></table>`;
  }

  function switchView(view: string) {
    document.querySelectorAll('.ad-nav__item').forEach((b) => b.classList.toggle('on', (b as HTMLElement).dataset.view === view));
    document.querySelectorAll('.ad-view').forEach((s) => { (s as HTMLElement).hidden = (s as HTMLElement).dataset.view !== view; });
    (document.querySelector('.ad-main') as HTMLElement)?.scrollTo({ top: 0 });
  }

  function showMsg(kicker: string, title: string, msg: string) {
    $('gate').hidden = true;
    $('denyKicker').textContent = kicker;
    $('denyTitle').textContent = title;
    $('denyMsg').textContent = msg;
    $('denied').hidden = false;
  }

  async function init() {
    $('denied').hidden = true;
    const user = await getSessionUser();
    if (!user) { $('gate').hidden = false; return; }
    const email = user.email ?? '(no email)';

    let token = await getIdToken();
    let res = await fetch('/api/admin/data', { headers: { Authorization: 'Bearer ' + (token || '') } });
    if (res.status === 401) { token = await getIdToken(true); res = await fetch('/api/admin/data', { headers: { Authorization: 'Bearer ' + (token || '') } }); }

    if (res.status === 403) {
      showMsg('Restricted', 'Not authorised', 'You’re signed in as ' + email + ', but this exact email isn’t in the ADMIN_EMAILS allowlist. Add it in Vercel (character-for-character) and redeploy.');
      return;
    }
    if (res.status === 401) {
      showMsg('Auth error', 'Sign-in couldn’t be verified', 'Signed in as ' + email + ', but the server rejected the token (401). This is a Firebase project-id / server-env issue, not your account.');
      return;
    }
    if (!res.ok) {
      showMsg('Error', 'Couldn’t load the dashboard', 'Signed in as ' + email + ' — the data request failed (error ' + res.status + '). Please try again shortly.');
      return;
    }

    $('shell').hidden = false;
    $('whoMini').textContent = user.email ?? '';

    const data = await res.json();
    const orders = data.orders || [];
    const abandonedRaw = data.abandoned || [];
    const demos = data.demos || [];
    const leads = await getCheckoutLeads(100).catch(() => []);

    // merged abandoned + leads
    const abandoned = [
      ...abandonedRaw.map((a: any) => ({ src: 'Checkout', createdAt: a.createdAt, customer: a.customer, email: a.email, phone: a.phone, detail: a.items || '—', value: inr(a.total?.amount, a.total?.currencyCode), url: a.recoveryUrl })),
      ...leads.map((l: any) => ({ src: 'Lead · India', createdAt: l.createdAt, customer: null, email: l.email, phone: l.phone, detail: '—', value: '—', url: null })),
    ].sort((x, y) => String(y.createdAt || '').localeCompare(String(x.createdAt || '')));

    // counts
    $('nOrders').textContent = String(orders.length);
    $('nAband').textContent = String(abandoned.length);
    $('nDemos').textContent = String(demos.length);

    // KPIs (last 30 days)
    const now = Date.now();
    const in30 = (iso: string) => { const t = new Date(iso).getTime(); return isFinite(t) && now - t <= 30 * 864e5; };
    const recent = orders.filter((o: any) => in30(o.createdAt) && !o.cancelled);
    const revenue = recent.reduce((s: number, o: any) => s + Number(o.total?.amount || 0), 0);
    $('kpis').innerHTML = [
      { n: inr(String(revenue)), k: 'Revenue · 30d', d: recent.length + ' orders' },
      { n: String(orders.length), k: 'Recent orders', d: '' },
      { n: String(abandoned.length), k: 'Abandoned / leads', d: '' },
      { n: String(demos.length), k: 'Home demos', d: '' },
    ].map((x) => `<div class="ad-kpi"><span class="ad-kpi__n">${esc(x.n)}</span><span class="ad-kpi__k">${esc(x.k)}</span>${x.d ? `<span class="ad-kpi__d">${esc(x.d)}</span>` : ''}</div>`).join('');

    // tables
    $('ovOrders').innerHTML = ordersTable(orders.slice(0, 8));
    $('allOrders').innerHTML = ordersTable(orders);
    $('allAband').innerHTML = abandonedTable(abandoned);
    $('allDemos').innerHTML = demosTable(demos);

    // nav
    document.querySelectorAll('[data-view]').forEach((el) => {
      if (el.classList.contains('ad-view')) return;
      el.addEventListener('click', () => switchView((el as HTMLElement).dataset.view!));
    });
  }

  $('googleBtn')?.addEventListener('click', async () => {
    try {
      const u = await signInWithGoogle();
      if (u) { $('gate').hidden = true; await init(); }  // use the in-memory session; no reload
    } catch (e: any) {
      const c = e?.code || e?.message || 'unknown';
      if (c === 'auth/popup-closed-by-user' || c === 'auth/cancelled-popup-request') return;
      showMsg('Sign-in failed', 'Couldn’t sign in', c + (c === 'auth/unauthorized-domain' ? ' — add this domain in Firebase → Authentication → Authorized domains.' : ''));
    }
  });
  const out = async () => { await signOut(); location.reload(); };
  $('signoutBtn')?.addEventListener('click', out);
  $('denyOut')?.addEventListener('click', out);

  init();
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap');
  :root { --cherry: #8B1A1A; --depth: #2C1A0E; }
  body { background: #fff; }
  .site-header, .brand-ticker, .page-header { display: none !important; }

  .ad {
    --serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --cream: #F6F1E9; --ink: #40382f; --mid: #6a655d; --faint: #a79f92; --rule: #e2dac9;
    --good: #2f6b3f; --warn: #a86a1e;
    font-family: 'Jost', sans-serif; color: var(--depth); background: #fbfaf7; min-height: 100vh;
  }
  .ad-display { font-family: var(--serif); font-weight: 300; letter-spacing: 0; }
  .ad-eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--cherry); font-weight: 600; margin: 0 0 14px; }
  .ad-note { color: var(--mid); font-size: 14px; }
  .ad-center { text-align: center; padding: 80px 24px; }

  /* Gate */
  .ad-gate { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px; }
  .ad-gate__card { background: #fff; border: 1px solid var(--rule); border-radius: 6px; padding: clamp(36px,5vw,56px); text-align: center; max-width: 440px; }
  .ad-gate__h { font-size: clamp(26px,3.4vw,38px); color: var(--depth); margin: 0 0 12px; }
  .ad-gate__p { font-size: 14px; color: var(--mid); line-height: 1.6; margin: 0 auto 26px; max-width: 34ch; }
  .g-btn { display: inline-flex; align-items: center; gap: 11px; height: 52px; padding: 0 26px; border: 1px solid var(--depth); background: #fff; cursor: pointer; font-family: 'Jost', sans-serif; font-size: 13px; font-weight: 600; color: var(--depth); transition: background .2s, color .2s; }
  .g-btn:hover { background: var(--depth); color: #fff; }
  .ad-textbtn { background: none; border: none; cursor: pointer; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; color: var(--cherry); }

  /* Shell */
  .ad-shell { display: grid; grid-template-columns: 216px 1fr; min-height: 100vh; }
  .ad-nav { background: var(--depth); color: #fff; padding: 20px 14px; display: flex; flex-direction: column; gap: 3px; position: sticky; top: 0; height: 100vh; }
  .ad-nav__logo { font-family: var(--serif); font-size: 15px; letter-spacing: .22em; color: #fff; padding: 6px 12px 20px; }
  .ad-nav__item { display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; font-family: 'Jost', sans-serif; font-size: 12.5px; color: rgba(255,255,255,.62); background: none; border: none; cursor: pointer; padding: 11px 12px; border-radius: 4px; transition: background .15s, color .15s; }
  .ad-nav__item:hover { color: #fff; }
  .ad-nav__item.on { background: rgba(255,255,255,.1); color: #fff; }
  .ad-nav__n { margin-left: auto; font-size: 10px; color: rgba(255,255,255,.45); font-variant-numeric: tabular-nums; }
  .ad-nav__item.on .ad-nav__n { color: #e7b7ae; }
  .ad-nav__foot { margin-top: auto; padding: 12px; font-size: 10.5px; color: rgba(255,255,255,.5); display: flex; flex-direction: column; gap: 8px; word-break: break-all; }
  .ad-nav__out { align-self: flex-start; background: none; border: none; cursor: pointer; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; color: #e7b7ae; }

  .ad-main { padding: clamp(24px,3vw,40px); min-width: 0; overflow-x: hidden; }
  .ad-h1 { font-size: clamp(26px,2.8vw,38px); color: var(--depth); margin: 0 0 22px; }

  .ad-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 24px; }
  .ad-kpi { background: #fff; border: 1px solid var(--rule); border-radius: 4px; padding: 18px 20px; }
  .ad-kpi__n { display: block; font-family: var(--serif); font-weight: 300; font-size: 34px; line-height: 1; color: var(--depth); font-variant-numeric: tabular-nums; }
  .ad-kpi__k { display: block; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--mid); font-weight: 600; margin-top: 8px; }
  .ad-kpi__d { display: block; font-size: 10.5px; color: var(--faint); margin-top: 3px; }

  .ad-panel { background: #fff; border: 1px solid var(--rule); border-radius: 4px; overflow: hidden; margin-bottom: 20px; }
  .ad-panel__h { display: flex; align-items: center; justify-content: space-between; padding: 15px 18px; border-bottom: 1px solid var(--rule); }
  .ad-panel__t { font-family: var(--serif); font-weight: 400; font-size: 19px; color: var(--depth); }
  .ad-panel__more { background: none; border: none; cursor: pointer; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; font-weight: 600; color: var(--cherry); }
  .ad-scroll { overflow-x: auto; }
  .ad-pad { padding: 20px; }

  .ad-table { width: 100%; border-collapse: collapse; min-width: 620px; }
  .ad-table th { font-size: 9.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); font-weight: 600; text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--rule); white-space: nowrap; }
  .ad-table td { font-size: 13px; color: var(--ink); padding: 13px 16px; border-bottom: 1px solid #efeae1; vertical-align: middle; }
  .ad-table tr:last-child td { border-bottom: none; }
  .ad-table .nm { font-weight: 600; color: var(--depth); }
  .ad-table .sub { font-size: 11.5px; color: var(--faint); font-weight: 400; margin-top: 2px; }
  .ad-table .r { text-align: right; }
  .ad-table .amt { font-family: var(--serif); font-size: 16px; color: var(--depth); font-variant-numeric: tabular-nums; }

  .ad-pill { font-size: 9px; letter-spacing: .08em; text-transform: uppercase; font-weight: 700; padding: 4px 9px; border-radius: 999px; background: var(--cream); color: var(--mid); white-space: nowrap; }
  .ad-pill--good { color: var(--good); background: #e9f0eb; }
  .ad-pill--warn { color: var(--warn); background: #f7efe1; }
  .ad-pill--lead { color: var(--cherry); background: #f6e9e7; }
  .ad-pill--cancel { color: var(--cherry); background: #f6e9e7; }
  .ad-link { font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; font-weight: 600; color: var(--depth); text-decoration: none; border-bottom: 1px solid var(--depth); padding-bottom: 2px; white-space: nowrap; }
  .ad-link:hover { color: var(--cherry); border-color: var(--cherry); }

  @media (max-width: 820px) {
    .ad-shell { grid-template-columns: 1fr; }
    .ad-nav { position: static; height: auto; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 6px; }
    .ad-nav__logo { width: 100%; padding: 4px 8px 10px; }
    .ad-nav__item { width: auto; }
    .ad-nav__foot { margin: 0 0 0 auto; flex-direction: row; align-items: center; gap: 12px; }
    .ad-kpis { grid-template-columns: 1fr 1fr; }
  }
</style>
