      } else {
        actionSect =
          '<div class="ad-dsect ad-dact"><h3 class="ad-dh3">Demo completed</h3>' +
          '<p class="ad-confirmed">' + (r.confirmedDate ? esc(fmtISO(r.confirmedDate)) + (r.confirmedTime ? ' · ' + esc(fmt12(r.confirmedTime)) : '') : 'Marked complete') + '</p>' +
          (notify ? '<div class="ad-dactions">' + notify + '</div>' : '') + '</div>';
      }

      var footer = [];
      if (r.adminUrl) footer.push('<a class="ad-dbtn" href="' + esc(r.adminUrl) + '" target="_blank" rel="noopener">Open in Shopify →</a>');
      if (telDigits) footer.push('<a class="ad-dbtn" href="tel:+' + telDigits + '">Call</a>');

      return '' +
        '<div class="ad-dhead">' + demoPill(status) +
          '<h2 class="ad-display ad-dtitle">' + esc(r.customer || 'Guest') + '</h2>' +
          '<p class="ad-dmeta">' + esc(r.name) + ' · Booked ' + when(r.createdAt) + '</p>' +
        '</div>' +
        actionSect +
        '<div class="ad-dsect"><h3 class="ad-dh3">Contact</h3>' +
          '<div class="ad-drow"><span class="ad-dk">Email</span><span class="ad-dvv">' + (r.email ? esc(r.email) : '<span class="ad-dv">—</span>') + '</span></div>' +
          '<div class="ad-drow"><span class="ad-dk">Phone</span><span class="ad-dvv">' + (r.phone ? esc(r.phone) : '<span class="ad-dv">—</span>') + '</span></div>' +
        '</div>' +
        '<div class="ad-dsect"><h3 class="ad-dh3">Requested slot</h3><p class="ad-daddr">' + esc(r.date || '—') + (r.slot ? '<br>' + esc(r.slot) : '') + '</p></div>' +
        '<div class="ad-dsect"><h3 class="ad-dh3">Bags to show</h3>' + (bagsList.length ? '<ul class="ad-baglist">' + bagsList.map(function (b) { return '<li>' + esc(b) + '</li>'; }).join('') + '</ul>' : '<p class="ad-dv">—</p>') + '</div>' +
        '<div class="ad-dsect"><h3 class="ad-dh3">Address</h3><p class="ad-daddr">' + (r.address ? esc(r.address) : '<span class="ad-dv">—</span>') + '</p></div>' +
        (footer.length ? '<div class="ad-dactions">' + footer.join('') + '</div>' : '');
    }
    function demoMsg(t) { var el = $('demoMsg'); if (el) el.textContent = t || ''; }
    async function doDemoAction(idx, payload, btn) {
      var r = DEMOS[idx]; if (!r) return;
      demoMsg('Saving…'); if (btn) btn.disabled = true;
      var headers = await authHeaders();
      if (!headers) { demoMsg('Session expired — reload and sign in again.'); if (btn) btn.disabled = false; return; }
      headers['Content-Type'] = 'application/json';
      try {
        var resp = await fetch('/api/admin/demo', { method: 'POST', headers: headers, body: JSON.stringify(Object.assign({ id: r.id }, payload)) });
        var res = await resp.json().catch(function () { return null; });
        if (!resp.ok || !res || !res.ok) { demoMsg((res && res.error) || 'Could not save — try again.'); if (btn) btn.disabled = false; return; }
        if (payload.action === 'confirm') { r.status = 'confirmed'; r.confirmedDate = res.confirmedDate; r.confirmedTime = res.confirmedTime; }
        else if (payload.action === 'complete') { r.status = 'completed'; }
        $('allDemos').innerHTML = demosTable(DEMOS);
        openDrawer('demo', idx);
      } catch (e) { demoMsg('Network error — try again.'); if (btn) btn.disabled = false; }
    }
    function wireDemoActions(idx) {
      var c = $('demoConfirm');
      if (c) c.addEventListener('click', function () {
        var date = ($('demoDate') || {}).value || '';
        var time = ($('demoTime') || {}).value || '';
        if (!date || !time) { demoMsg('Pick a date and time first.'); return; }
        doDemoAction(idx, { action: 'confirm', date: date, time: time }, c);
      });
      var k = $('demoComplete');
      if (k) k.addEventListener('click', function () { doDemoAction(idx, { action: 'complete' }, k); });
    }

    function openDrawer(kind, idx) {
      var r = DEMOS[idx];
      if (!r) return;
      $('drawerBody').innerHTML = buildDemoDrawer(r);
      $('drawerBody').scrollTop = 0;
      $('drawer').hidden = false;
      document.body.style.overflow = 'hidden';
      wireDemoActions(idx);
    }
    function closeDrawer() {
      $('drawer').hidden = true;
      document.body.style.overflow = '';
    }
    $('allDemos').addEventListener('click', function (e) {
      var tr = e.target.closest ? e.target.closest('tr[data-idx]') : null;
      if (tr) openDrawer('demo', Number(tr.getAttribute('data-idx')));
    });
    $('drawerClose').addEventListener('click', closeDrawer);
    $('drawerScrim').addEventListener('click', closeDrawer);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !$('drawer').hidden) closeDrawer(); });

    init();
  })();
</script>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap');
  :root { --cherry: #8B1A1A; --depth: #2C1A0E; }
  body { background: #fff; }
  .site-header, .brand-ticker, .page-header { display: none !important; }

  .ad {
    --serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --cream: #F6F1E9; --ink: #40382f; --mid: #6a655d; --faint: #a79f92; --rule: #e2dac9;
    --good: #2f6b3f; --warn: #a86a1e;
    font-family: 'Jost', sans-serif; color: var(--depth); background: #fbfaf7; min-height: 100vh;
  }
  .ad-display { font-family: var(--serif); font-weight: 300; letter-spacing: 0; }
  .ad-eyebrow { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--cherry); font-weight: 600; margin: 0 0 14px; }
  .ad-note { color: var(--mid); font-size: 14px; }

  /* Gate */
  .ad-gate { display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px; }
  .ad-gate__card { background: #fff; border: 1px solid var(--rule); border-radius: 6px; padding: clamp(36px,5vw,56px); text-align: center; max-width: 420px; width: 100%; }
  .ad-gate__h { font-size: clamp(26px,3.4vw,38px); color: var(--depth); margin: 0 0 12px; }
  .ad-gate__p { font-size: 14px; color: var(--mid); line-height: 1.6; margin: 0 auto 24px; max-width: 34ch; }
  .ad-google { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: 100%; height: 52px; background: var(--depth); color: #fff; border: none; cursor: pointer; font-family: 'Jost', sans-serif; font-size: 13px; letter-spacing: .06em; font-weight: 600; transition: background .2s; }
  .ad-google:hover { background: var(--cherry); }
  .ad-google:disabled { opacity: .6; cursor: default; }
  .ad-google__g { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: #fff; color: var(--depth); font-family: var(--serif); font-weight: 500; font-size: 15px; line-height: 1; }
  .ad-altlink { display: inline-block; margin: 18px auto 0; background: none; border: none; cursor: pointer; font-family: 'Jost', sans-serif; font-size: 11.5px; letter-spacing: .04em; color: var(--faint); text-decoration: underline; text-underline-offset: 3px; }
  .ad-altlink:hover { color: var(--mid); }
  .ad-pass { margin-top: 16px; }
  .ad-input { width: 100%; border: 1px solid var(--rule); background: #fff; padding: 14px 16px; font-family: 'Jost', sans-serif; font-size: 15px; color: var(--depth); text-align: center; letter-spacing: .04em; outline: none; margin-bottom: 12px; }
  .ad-input:focus { border-color: var(--depth); }
  .ad-enter { width: 100%; height: 50px; background: var(--depth); color: #fff; border: none; cursor: pointer; font-family: 'Jost', sans-serif; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; transition: background .2s; }
  .ad-enter:hover { background: var(--cherry); }
  .ad-enter:disabled { opacity: .6; cursor: default; }
  .ad-signin-status { font-size: 12.5px; color: var(--cherry); margin: 14px 0 0; min-height: 16px; }

  /* Shell */
  .ad-shell { display: grid; grid-template-columns: 216px 1fr; min-height: 100vh; }
  /* An explicit display: (grid/flex) beats the UA [hidden] rule, so force it: the
     login card and the dashboard must truly disappear when hidden — never both shown. */
  .ad-gate[hidden], .ad-shell[hidden] { display: none !important; }
  .ad-nav { background: var(--depth); color: #fff; padding: 20px 14px; display: flex; flex-direction: column; gap: 3px; position: sticky; top: 0; height: 100vh; }
  .ad-nav__logo { padding: 6px 12px 20px; }
  /* The wordmark ships as dark artwork; invert it to read white on the dark sidebar. */
  .ad-nav__logo img { height: 18px; width: auto; display: block; filter: brightness(0) invert(1); }
  .ad-nav__item { display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; font-family: 'Jost', sans-serif; font-size: 12.5px; color: rgba(255,255,255,.62); background: none; border: none; cursor: pointer; padding: 11px 12px; border-radius: 4px; transition: background .15s, color .15s; }
  .ad-nav__item:hover { color: #fff; }
  .ad-nav__item.on { background: rgba(255,255,255,.1); color: #fff; }
  .ad-nav__n { margin-left: auto; font-size: 10px; color: rgba(255,255,255,.45); font-variant-numeric: tabular-nums; }
  /* Unread — a real notification, not a running total. */
  .ad-nav__n.is-new { background: var(--cherry); color: #fff; border-radius: 999px; min-width: 17px; padding: 1px 5px; text-align: center; font-weight: 500; }
  .ad-nav__item.on .ad-nav__n.is-new { color: #fff; }
  .ad-nav__item.on .ad-nav__n { color: #e7b7ae; }
  .ad-nav__grp { font-size: 9.5px; letter-spacing: .16em; text-transform: uppercase; color: rgba(255,255,255,.32); padding: 16px 12px 5px; }
  .ad-nav__grp:first-of-type { padding-top: 4px; }
  .ad-nav__foot { margin-top: auto; padding: 12px; }
  .ad-nav__out { background: none; border: none; cursor: pointer; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; color: #e7b7ae; }
  .ad-nav__upd { display: block; font-size: 9.5px; letter-spacing: .04em; color: rgba(255,255,255,.4); padding: 0 12px 9px; }

  .ad-main { padding: clamp(24px,3vw,40px); min-width: 0; overflow-x: hidden; }
  .ad-h1 { font-size: clamp(26px,2.8vw,38px); color: var(--depth); margin: 0 0 22px; }
  .ad-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 24px; }
  .ad-kpi { background: #fff; border: 1px solid var(--rule); border-radius: 4px; padding: 18px 20px; }
  .ad-kpi__n { display: block; font-family: var(--serif); font-weight: 300; font-size: 34px; line-height: 1; color: var(--depth); font-variant-numeric: tabular-nums; }
  .ad-kpi__k { display: block; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--mid); font-weight: 600; margin-top: 8px; }
  .ad-kpi__d { display: block; font-size: 10.5px; color: var(--faint); margin-top: 3px; }

  .ad-panel { background: #fff; border: 1px solid var(--rule); border-radius: 4px; overflow: hidden; margin-bottom: 20px; }
  .ad-panel__h { display: flex; align-items: center; justify-content: space-between; padding: 15px 18px; border-bottom: 1px solid var(--rule); }
  .ad-panel__t { font-family: var(--serif); font-weight: 400; font-size: 19px; color: var(--depth); }
  .ad-panel__more { background: none; border: none; cursor: pointer; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; font-weight: 600; color: var(--cherry); }
  .ad-scroll { overflow-x: auto; }
  .ad-pad { padding: 20px; }

  .ad-table { width: 100%; border-collapse: collapse; min-width: 620px; }
  .ad-table th { font-size: 9.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); font-weight: 600; text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--rule); white-space: nowrap; }
  .ad-table td { font-size: 13px; color: var(--ink); padding: 13px 16px; border-bottom: 1px solid #efeae1; vertical-align: middle; }
  .ad-table tr:last-child td { border-bottom: none; }
  .ad-table .nm { font-weight: 600; color: var(--depth); }
  .ad-table .sub { font-size: 11.5px; color: var(--faint); font-weight: 400; margin-top: 2px; }
  .ad-table .r { text-align: right; }
  .ad-table .amt { font-family: var(--serif); font-size: 16px; color: var(--depth); font-variant-numeric: tabular-nums; }

  .ad-pill { font-size: 9px; letter-spacing: .08em; text-transform: uppercase; font-weight: 700; padding: 4px 9px; border-radius: 999px; background: var(--cream); color: var(--mid); white-space: nowrap; }
  .ad-pill--good { color: var(--good); background: #e9f0eb; }
  .ad-pill--cancel { color: var(--cherry); background: #f6e9e7; }
  .ad-link { font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; font-weight: 600; color: var(--depth); text-decoration: none; border-bottom: 1px solid var(--depth); padding-bottom: 2px; white-space: nowrap; }
  .ad-link:hover { color: var(--cherry); border-color: var(--cherry); }

  /* Clickable rows */
  /* Daily funnel: 31 day columns + a total, so cells go tight and numbers align. */
  .ad-daily { min-width: 900px; font-variant-numeric: tabular-nums; }
  .ad-daily th, .ad-daily td { padding: 8px 6px; font-size: 12px; }
  /* Sticky first column so step names stay readable while scrolling 31 days. */
  .ad-daily__lab { text-align: left; white-space: nowrap; font-weight: 600; color: var(--depth); position: sticky; left: 0; background: #fff; padding-left: 16px !important; padding-right: 14px !important; }
  .ad-daily__z { color: #d8d0c4; }
  /* Browsing shown where the bag would be — present, but visibly not a purchase. */
  .ad-browsed { color: var(--mid); }
  .ad-dpages { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; }
  .ad-dpages li { font-size: 13px; color: var(--depth); font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, monospace); display: flex; align-items: center; gap: 8px; }
  .ad-bottoggle { display: inline-flex; align-items: center; gap: 7px; font-size: 11.5px; color: var(--mid); cursor: pointer; }
  .ad-bottoggle input { accent-color: var(--cherry); cursor: pointer; }
  .ad-daily__tot { font-weight: 600; color: var(--depth); border-left: 1px solid var(--rule); padding-right: 16px !important; }
  .ad-table--click tbody tr { cursor: pointer; transition: background .12s; }
  .ad-table--click tbody tr:hover { background: #faf7f1; }
  .ad-rowview { font-size: 10px; letter-spacing: .06em; text-transform: uppercase; font-weight: 600; color: var(--faint); white-space: nowrap; }
  .ad-table--click tbody tr:hover .ad-rowview { color: var(--cherry); }

  /* Detail drawer */
  .ad-drawer { position: fixed; inset: 0; z-index: 100; }
  .ad-drawer[hidden] { display: none; }
  .ad-drawer__scrim { position: absolute; inset: 0; background: rgba(44,26,14,.32); animation: ad-fade .18s ease; }
  .ad-drawer__panel { position: absolute; top: 0; right: 0; height: 100%; width: min(460px, 92vw); background: #fbfaf7; border-left: 1px solid var(--rule); box-shadow: -18px 0 50px rgba(44,26,14,.16); overflow-y: auto; padding: 28px 28px 40px; animation: ad-slide .22s cubic-bezier(.22,.61,.36,1); }
  @keyframes ad-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes ad-slide { from { transform: translateX(24px); opacity: .4; } to { transform: none; opacity: 1; } }
  .ad-drawer__close { position: absolute; top: 16px; right: 18px; background: none; border: none; font-size: 26px; line-height: 1; color: var(--faint); cursor: pointer; }
  .ad-drawer__close:hover { color: var(--depth); }
  .ad-dhead { margin: 4px 0 18px; }
  .ad-dtitle { font-size: 27px; color: var(--depth); margin: 10px 0 4px; }
  .ad-dmeta { font-size: 12px; color: var(--mid); }
  .ad-dactions { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
  .ad-dbtn { display: inline-flex; align-items: center; height: 34px; padding: 0 14px; border: 1px solid var(--rule); border-radius: 3px; font-size: 11px; letter-spacing: .04em; font-weight: 600; color: var(--depth); text-decoration: none; background: #fff; transition: border-color .15s, color .15s; }
  .ad-dbtn:hover { border-color: var(--depth); }
  .ad-dbtn--fill { background: var(--depth); color: #fff; border-color: var(--depth); }
  .ad-dbtn--fill:hover { background: var(--cherry); border-color: var(--cherry); }
  .ad-dsect { border-top: 1px solid var(--rule); padding: 16px 0; }
  .ad-dh3 { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--faint); font-weight: 600; margin: 0 0 10px; }
  .ad-drow { display: flex; justify-content: space-between; gap: 16px; padding: 3px 0; font-size: 13px; }
  .ad-dk { color: var(--mid); }
  .ad-dvv { color: var(--depth); text-align: right; word-break: break-word; }
  .ad-dv { color: var(--faint); }
  .ad-daddr { font-size: 13.5px; color: var(--depth); line-height: 1.65; }
  /* Acquisition facts: label above value, two per row on anything but a phone. */
  .ad-dfacts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 18px; margin: 0; }
  .ad-dfacts dt { font-size: 9.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); font-weight: 600; margin-bottom: 3px; }
  .ad-dfacts dd { font-size: 13.5px; color: var(--depth); margin: 0; word-break: break-word; }
  @media (max-width: 480px) { .ad-dfacts { grid-template-columns: 1fr; } }
  .ad-dtable { width: 100%; border-collapse: collapse; }
  .ad-dtable td { font-size: 13px; color: var(--ink); padding: 9px 0; border-bottom: 1px solid #efeae1; vertical-align: top; }
  .ad-dtable tr:last-child td { border-bottom: none; }
  .ad-dtable .nm { font-weight: 600; color: var(--depth); }
  .ad-dtable .sub { font-size: 11.5px; color: var(--faint); font-weight: 400; margin-top: 2px; }
  .ad-dtable .r { text-align: right; white-space: nowrap; }
  .ad-dtable .amt { font-family: var(--serif); font-size: 15px; color: var(--depth); }
  .ad-tots { margin-top: 12px; border-top: 1px solid var(--rule); padding-top: 12px; }
  .ad-tot { display: flex; justify-content: space-between; font-size: 13px; color: var(--mid); padding: 3px 0; }
  .ad-tot--strong { color: var(--depth); font-weight: 600; font-size: 15px; margin-top: 4px; }
  .ad-dtags { display: flex; flex-wrap: wrap; gap: 6px; }
  .ad-tag { font-size: 10px; letter-spacing: .04em; color: var(--mid); background: var(--cream); border-radius: 3px; padding: 3px 8px; }

  /* Demo status pills + confirm flow */
  .ad-pill--wait { color: var(--warn); background: #f6efe2; }
  .ad-pill--good { color: var(--good); background: #e9f0eb; }
  .ad-pill--done { color: var(--mid); background: #ece7dd; }
  .ad-dact { background: #fff; border: 1px solid var(--rule); border-radius: 5px; padding: 16px 16px 18px; margin-top: 4px; }
  .ad-reqnote { font-size: 12.5px; color: var(--mid); margin: 0 0 12px; }
  .ad-notifynote { font-size: 12.5px; color: var(--mid); margin: 0 0 10px; }
  .ad-form { display: flex; gap: 10px; margin-bottom: 12px; }
  .ad-flabel { flex: 1; display: flex; flex-direction: column; gap: 5px; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); font-weight: 600; }
  .ad-finput { border: 1px solid var(--rule); background: #fff; padding: 10px 11px; font-family: 'Jost', sans-serif; font-size: 14px; color: var(--depth); outline: none; }
  .ad-finput:focus { border-color: var(--depth); }
  .ad-dbtn--wide { width: 100%; justify-content: center; height: 42px; margin-top: 4px; }
  .ad-dbtn--wa { border-color: #cfe8d4; color: #17692e; }
  .ad-dbtn--wa:hover { border-color: #17692e; }
  .ad-confirmed { font-family: var(--serif); font-size: 21px; color: var(--depth); margin: 0 0 14px; }
  .ad-actmsg { font-size: 12px; color: var(--cherry); margin: 10px 0 0; min-height: 15px; }
  .ad-baglist { margin: 0; padding-left: 18px; }
  .ad-baglist li { font-size: 13.5px; color: var(--depth); padding: 2px 0; }

  /* Clickable KPI cards */
  .ad-kpi--click { font-family: 'Jost', sans-serif; text-align: left; cursor: pointer; width: 100%; transition: border-color .15s, box-shadow .15s, transform .1s; }
  .ad-kpi--click:hover { border-color: var(--depth); box-shadow: 0 4px 16px rgba(44,26,14,.08); }
  .ad-kpi--click:active { transform: translateY(1px); }
  .ad-kpi--click .ad-kpi__d { color: var(--cherry); }

  /* Revenue insights */
  .ad-kpis--rev { margin-bottom: 20px; }
  .ad-chartcard { padding: 18px 20px 20px; }
  .ad-chart-h { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .ad-chart-sub { font-size: 11px; color: var(--faint); }
  .ad-chartwrap { width: 100%; }
  .ad-svg { width: 100%; height: auto; display: block; overflow: visible; }
  .ad-bar { fill: var(--cherry); transition: fill .12s; }
  .ad-bar:hover { fill: var(--depth); }
  .ad-grid { stroke: #ece5d8; stroke-width: 1; }
  .ad-glabel, .ad-xlabel { fill: var(--faint); font-size: 11px; font-family: 'Jost', sans-serif; }
  .ad-hbars { display: flex; flex-direction: column; gap: 13px; }
  .ad-hbar { display: grid; grid-template-columns: minmax(90px, 150px) 1fr auto; align-items: center; gap: 14px; }
  .ad-hbar__name { font-size: 13px; color: var(--depth); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ad-hbar__track { height: 10px; background: var(--cream); border-radius: 999px; overflow: hidden; }
  .ad-hbar__fill { display: block; height: 100%; background: var(--cherry); border-radius: 999px; }
  .ad-fill--good { background: var(--good); }
  .ad-fill--warn { background: #c2872b; }
  .ad-hbar__val { font-family: var(--serif); font-size: 16px; color: var(--depth); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ad-oppnote { font-size: 12.5px; color: var(--mid); margin: -8px 0 20px; padding: 0 2px; line-height: 1.5; }

  /* People: filters, search, journey timeline */
  .ad-sub { font-size: 13px; color: var(--mid); margin: -14px 0 18px; line-height: 1.5; }
  .ad-filters { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 12px; }
  .ad-chip { display: inline-flex; align-items: center; gap: 7px; font-family: 'Jost', sans-serif; font-size: 12px; color: var(--mid); background: #fff; border: 1px solid var(--rule); border-radius: 999px; padding: 7px 13px; cursor: pointer; transition: border-color .15s, color .15s, background .15s; }
  .ad-chip:hover { border-color: var(--cherry); color: var(--cherry); }
