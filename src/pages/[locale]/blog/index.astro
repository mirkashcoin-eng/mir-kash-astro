---
import BaseLayout from '~/layouts/BaseLayout.astro';
import JournalIndex from '~/components/content/JournalIndex.astro';
import { getMarketBySlug } from '~/lib/markets';

const market = getMarketBySlug(Astro.params.locale!);
if (!market || market.isDefault) return new Response(null, { status: 404 });
---
<BaseLayout title="The Journal — Mir Kash" path="/blog" description="The Mir Kash Journal — stories on conscious craft, vegan materials, and carrying your style with a clear conscience.">
  <JournalIndex />
</BaseLayout>
