---
name: Order refund
section: Orders
subject: Your refund for order {{ name }}
---
{%- capture email_title -%}
  {%- if refund_line_items.size == item_count -%}Your order has been refunded
  {%- elsif refund_line_items.size == 0 -%}You've received a refund
  {%- else -%}Part of your order has been refunded
  {%- endif -%}
{%- endcapture -%}
{%- capture email_preheader -%}We've refunded {{ amount | money_with_currency }} to your original payment method.{%- endcapture -%}
{%- assign mk_eyebrow = 'Order ' | append: order_name -%}
<!-- body -->
<p style="%%p%%">We've refunded <strong>{{ amount | money_with_currency }}</strong> to your original payment method. Depending on your bank, it can take a few days to appear.</p>

{%- assign mk_button_url = order_status_url | default: mk_site -%}
{%- assign mk_button_label = 'View your order' -%}
{% render 'button' %}

{%- if refund_line_items.size > 0 %}
{%- assign mk_section = 'Refunded items' -%}
{% render 'section-start' %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
{%- for refund_line in refund_line_items %}
  {%- assign line = refund_line.line_item -%}
  {%- if line.product.title != blank %}{% assign mk_item_title = line.product.title %}{% else %}{% assign mk_item_title = line.title %}{% endif -%}
  {%- if line.image %}{% capture mk_item_image %}{{ line | img_url: '240x', format: 'jpg' }}{% endcapture %}{% else %}{% assign mk_item_image = '' %}{% endif -%}
  {%- capture mk_item_meta -%}
    {%- if line.variant.title != 'Default Title' and line.variant.title != blank %}{{ line.variant.title }}&nbsp;&nbsp;·&nbsp;&nbsp;{% endif -%}
    Qty {{ refund_line.quantity }}
  {%- endcapture -%}
  {%- assign mk_item_note = '' -%}
  {%- assign mk_item_price = '' -%}
  {% render 'item-row' %}
{%- endfor %}
</table>
{% render 'section-end' %}
{%- endif %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0 0;">
  <tr>
    <td class="mk-serif" style="%%grand-label%%">Refunded</td>
    <td class="mk-serif" style="%%grand-value%%">{{ amount | money_with_currency }}</td>
  </tr>
</table>
