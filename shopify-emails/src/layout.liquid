<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
<meta name="color-scheme" content="light only">
<meta name="supported-color-schemes" content="light only">
<title>{{ email_title | strip }}</title>
<!--[if mso]>
<noscript><xml><o:OfficeDocumentSettings><o:AllowPNG/><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
<style>
  td, p, a, span, li { font-family: Arial, Helvetica, sans-serif !important; }
  .mk-serif, .mk-serif * { font-family: Georgia, 'Times New Roman', serif !important; }
</style>
<![endif]-->
<!--[if !mso]><!-->
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&display=swap" rel="stylesheet">
<!--<![endif]-->
<style>
  /* Brooklyn is self-hosted on the site. Clients that block web fonts (Gmail, Outlook)
     fall back to Helvetica/Arial, which the inline sizes are tuned for. */
  @font-face { font-family: 'Brooklyn'; font-style: normal; font-weight: 400; src: url('{{ mk_site }}/fonts/brand/Brooklyn-Normal.woff2') format('woff2'); }
  @font-face { font-family: 'Brooklyn'; font-style: normal; font-weight: 600; src: url('{{ mk_site }}/fonts/brand/Brooklyn-SemiBold.woff2') format('woff2'); }
  :root { color-scheme: light only; supported-color-schemes: light only; }
  html, body { margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: #FAF7F2; }
  body { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; font-synthesis: none; }
  table, td { border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
  img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
  a { color: #8B1A1A; }
  a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; font: inherit !important; }
  u + #body a { color: inherit; text-decoration: none; font: inherit; }
  @media only screen and (max-width: 620px) {
    .mk-container { width: 100% !important; max-width: 100% !important; }
    .mk-pad { padding-left: 22px !important; padding-right: 22px !important; }
    .mk-h1 { font-size: 27px !important; line-height: 33px !important; }
    .mk-stack { display: block !important; width: 100% !important; padding-right: 0 !important; }
    .mk-btn, .mk-btn td { width: 100% !important; }
    .mk-btn a { display: block !important; text-align: center !important; }
  }
  /* Outlook.com and the Outlook apps force their own dark mode: hold the brand colours. */
  [data-ogsc] .mk-bg, [data-ogsb] .mk-bg { background-color: #FAF7F2 !important; }
  [data-ogsc] .mk-foot, [data-ogsb] .mk-foot { background-color: #8B1A1A !important; }
</style>
</head>
<body id="body" class="mk-bg" style="margin:0;padding:0;background-color:#FAF7F2;">
<div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;color:#FAF7F2;">{{ email_preheader | strip_newlines | strip }}&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;</div>
<table role="presentation" class="mk-bg" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#FAF7F2" style="background-color:#FAF7F2;">
<tr>
<td align="center" style="padding:0;">
<!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
<table role="presentation" class="mk-container" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;margin:0 auto;">

  <tr>
    <td class="mk-pad" align="center" style="padding:44px 40px 30px;">
      <a href="{{ mk_site }}" style="text-decoration:none;"><img src="{{ mk_assets }}/mir-kash-logo.png" width="190" height="22" alt="Mir Kash" style="display:block;width:190px;height:auto;border:0;color:#2C1A0E;font-family:Georgia,serif;font-size:20px;letter-spacing:0.2em;"></a>
    </td>
  </tr>
  <tr>
    <td class="mk-pad" style="padding:0 40px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" style="%%rule%%">&nbsp;</td></tr></table>
    </td>
  </tr>

  <tr>
    <td class="mk-pad" style="padding:40px 40px 0;">
      {%- if mk_eyebrow != blank %}
      <p style="%%label%%">{{ mk_eyebrow }}</p>
      {%- endif %}
      <h1 class="mk-h1 mk-serif" style="%%h1%%">{{ email_title | strip }}</h1>
    </td>
  </tr>

  <tr>
    <td class="mk-pad" style="padding:20px 40px 48px;">
%%BODY%%
    </td>
  </tr>

  <tr>
    <td class="mk-foot mk-pad" align="center" bgcolor="#8B1A1A" style="background-color:#8B1A1A;padding:44px 40px 40px;">
      <a href="{{ mk_site }}" style="text-decoration:none;"><img src="{{ mk_assets }}/mir-kash-logo-parchment.png" width="140" height="16" alt="Mir Kash" style="display:block;width:140px;height:auto;border:0;color:#FAF7F2;font-family:Georgia,serif;font-size:16px;letter-spacing:0.2em;"></a>
      <p class="mk-serif" style="%%foot-line%%">Made slowly. Worn forever. Hurts nothing.</p>
      <p style="%%foot-p%%">Questions? Write to us at <a href="mailto:{{ mk_help_email }}" style="%%foot-link%%">{{ mk_help_email }}</a>.</p>
      <p style="%%foot-p%%">
        <a href="{{ mk_site }}" style="%%foot-link%%">Shop</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="{{ mk_site }}/pages/shipping-returns" style="%%foot-link%%">Shipping &amp; returns</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="https://www.instagram.com/mirkashco/" style="%%foot-link%%">Instagram</a>
      </p>
      {%- if unsubscribe_url != blank %}
      <p style="%%foot-p%%"><a href="{{ unsubscribe_url }}" style="%%foot-link%%">Unsubscribe</a></p>
      {%- endif %}
    </td>
  </tr>

</table>
<!--[if mso]></td></tr></table><![endif]-->
</td>
</tr>
</table>
</body>
</html>
