{%- comment -%} Needs: mk_button_url, mk_button_label. Optional: mk_link_url + mk_link_label for a quiet text link beside it. {%- endcomment -%}
<table role="presentation" class="mk-btn" cellpadding="0" cellspacing="0" border="0" style="margin:28px 0 4px;">
  <tr>
    <td align="center" bgcolor="#8B1A1A" style="%%btn-cell%%">
      <!--[if mso]>
      <v:rect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ mk_button_url }}" style="height:50px;v-text-anchor:middle;width:290px;" stroke="f" fillcolor="#8B1A1A">
        <w:anchorlock/>
        <center style="color:#FAF7F2;font-family:Arial,sans-serif;font-size:13px;font-weight:bold;letter-spacing:1px;">{{ mk_button_label }}</center>
      </v:rect>
      <![endif]-->
      <!--[if !mso]><!-->
      <a href="{{ mk_button_url }}" target="_blank" style="%%btn-a%%">{{ mk_button_label }}</a>
      <!--<![endif]-->
    </td>
  </tr>
</table>
{%- if mk_link_url != blank %}
<p style="%%small%%;margin:14px 0 0;">or <a href="{{ mk_link_url }}" style="%%link%%">{{ mk_link_label }}</a></p>
{%- endif %}
{%- assign mk_link_url = '' -%}
