SHOPIFY_GLOBAL_DOMAIN=your-store.myshopify.com
SHOPIFY_GLOBAL_TOKEN=your_storefront_api_public_token
SHOPIFY_IN_DOMAIN=your-store.myshopify.com
SHOPIFY_IN_TOKEN=your_storefront_api_public_token

# ── India custom checkout (India store only) ──────────────────────────────────
# Shopify India Admin API — new Dev Dashboard app (scopes: read/write_orders + read/write_draft_orders)
# Use the store's *.myshopify.com domain here (Admin API does not use the custom domain).
# The server exchanges Client ID + Secret for a short-lived token via the client-credentials grant.
SHOPIFY_IN_ADMIN_DOMAIN=your-india-store.myshopify.com
SHOPIFY_IN_ADMIN_CLIENT_ID=your_app_client_id
SHOPIFY_IN_ADMIN_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cashfree Payment Gateway (server-side only)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox          # sandbox | production

# Cashfree client SDK mode (public/client-safe)
PUBLIC_CASHFREE_MODE=sandbox  # sandbox | production

# Live public origin for Cashfree return_url / notify_url (never localhost).
# Set the same value in the Vercel project env. For local tunnel testing use the ngrok/cloudflared URL.
PUBLIC_APP_ORIGIN=https://www.your-domain.com

# Firebase — customer accounts (Google sign-in) + Firestore (saved address + leads)
# Client-safe web config (from Firebase console → Project settings → Web app):
PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
# Firebase setup: Auth → enable Google provider + add your domain to Authorized domains;
# create a Firestore database; set rules:
#   match /profiles/{uid}   { allow read, write: if request.auth != null && request.auth.uid == uid; }
#   match /checkout_leads/{d} { allow create: if true; allow read: if false; }
# The visitor funnel (analytics_daily) and Leads (leads) collections are accessed ONLY
# via the Admin SDK below, so their rules can stay default-deny — no public rule needed.

# Admin SDK service account (JSON from Firebase → Project settings → Service accounts →
# Generate new private key). Powers the /admin visitor funnel + Leads (reads/writes
# Firestore server-side, bypassing rules, so personal lead data is never public).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
# Sends order-confirmed / shipped / cart-reminder (src/lib/whatsapp.ts + the cron).
WHATSAPP_TOKEN=EAAG...your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=1285100258018493
# Webhook verify token — any random string; must equal what you type in Meta's
# "Configure Webhooks" → Verify token field. Only needed if you configure the webhook.
WHATSAPP_VERIFY_TOKEN=pick-any-random-string

# ── Founders' dashboard (/admin) ──────────────────────────────────────────────
# Comma-separated Google emails allowed into /admin (order/abandonment insights).
# Fail-closed: if unset, the dashboard denies everyone.
ADMIN_EMAILS=founder@example.com,cofounder@example.com
# Or skip Google entirely: a shared passcode to enter /admin (server-verified).
ADMIN_PASSCODE=choose-a-long-secret-passcode

# ── WhatsApp (Meta Cloud API) — order updates + cart recovery ─────────────────
# Send templated order-confirmed/shipped + abandoned-cart messages to opted-in
# customers, via a cron (src/pages/api/cron/whatsapp.ts). Templates must be
# pre-approved in WhatsApp Manager: order_confirmed, order_shipped, cart_reminder.
WHATSAPP_TOKEN=meta-permanent-system-user-token   # secret — never commit
WHATSAPP_PHONE_NUMBER_ID=1285100258018493
WHATSAPP_WABA_ID=1608333530921964                 # optional (reference)
# Protects the cron endpoints; Vercel cron sends it as the Authorization bearer.
CRON_SECRET=choose-a-long-secret
